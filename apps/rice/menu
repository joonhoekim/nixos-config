#!/bin/sh -e
# 라이싱 축 전부를 DMS 런처 플러그인에 한 모양으로 준다: 축 = { id, label, icon, keywords[], current, values[], actions[] }.
# 목록·현재값은 계산하지 않고 각 스위처에 묻는다. 플러그인은 스토어가 아니라 이 파일을 직접 부른다(rebuild 없이 고치려고).
# 전체 그림: docs/rice-tools.md

here="$(dirname "$0")"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

# 니리에서 목록에 떴다가 누르면 실패하는 것보다 아예 안 보이는 게 낫다.
has_hypr() {
	[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1
}

# 스위처 출력은 그대로 흘린다 — 플러그인이 실패 토스트에 마지막 줄을 쓴다.
if [ $# -gt 0 ]; then
	axis="$1"
	value="${2:-}"

	case "$axis" in
	profile) exec "$here/switch" "$value" ;;
	term) exec "$here/term" "$value" ;;
	layout) exec "$here/layout" "$value" ;;
	shader)
		has_hypr || {
			printf '하이프랜드 세션이 아니다 — 화면 셰이더는 여기서만 걸린다.\n' >&2
			exit 1
		}
		# 고르기·겹치기·값 맞추기는 스튜디오 몫이고 여기는 탈출구(off·--next)와 여는 것뿐이다.
		case "$value" in
		studio) exec "$here/studio" ;;
		esac
		exec "$here/crt" "$value"
		;;
	wall)
		case "$value" in
		random) exec "$here/wall" ;;
		pick) exec "$here/wall" --pick ;;
		yazi) exec "$here/wall" --yazi ;;
		*)
			printf '월페이퍼 동작이 아니다: %s\n' "$value" >&2
			exit 1
			;;
		esac
		;;
	*)
		printf '그런 축은 없다: %s\n' "$axis" >&2
		exit 1
		;;
	esac
fi

axis() { # axis <id> <label> <icon> <current> <actions-json> <keywords-json>   < 값목록
	jq -Rn \
		--arg id "$1" --arg label "$2" --arg icon "$3" --arg cur "$4" \
		--argjson actions "${5:-[]}" --argjson keywords "${6:-[]}" \
		'{ id: $id, label: $label, icon: $icon, keywords: $keywords, current: $cur,
		   values: [inputs], actions: $actions }'
}

# 시드 전 머신에선 --list 가 죽는다. 축 하나 때문에 창이 안 뜨지 않게 조용히 뺀다.
try_axis() { # try_axis <id> <label> <icon> <스위처> <actions-json> <keywords-json>
	sw="$here/$4"
	[ -x "$sw" ] || return 0
	list="$("$sw" --list 2>/dev/null)" || return 0
	[ -n "$list" ] || return 0
	cur="$("$sw" --current 2>/dev/null || echo '')"
	printf '%s\n' "$list" | axis "$1" "$2" "$3" "$cur" "$5" "$6"
}

# off 와 --next 를 스튜디오로 안 옮긴 건 탈출구라서다 — 셰이더가 화면을 망치면 스튜디오 창도 같은 유리 뒤에 있다.
shader_axis() {
	[ -x "$here/crt" ] || return 0
	cur="$("$here/crt" --current 2>/dev/null || echo '')"
	printf '' | axis shader "화면 셰이더" blur_on "$cur" '[
		{ "value": "studio", "label": "스튜디오 열기…", "detach": true,
		  "keywords": ["studio", "rice studio", "open"],
		  "comment": "고르기 · 겹치기 · 값 맞추기 (apps/rice/studio)" },
		{ "value": "--next", "label": "다음 것", "keywords": ["next", "cycle"],
		  "comment": "목록을 한 바퀴 (Mod+Shift+C 와 같다)" },
		{ "value": "off", "label": "off", "keywords": ["off", "disable"],
		  "comment": "탈출구 — 화면이 이상해졌을 때" }
	]' '["shader", "crt", "screen", "effect"]'
}

# keywords: 라벨이 한글이라 영어로 치면 안 겹친다. 런처는 이름·부제가 0점일 때 keywords 를 본다(DMS Scorer.js).
{
	try_axis profile "프로필" palette switch '[]' '["profile", "theme", "look", "palette"]'

	has_hypr && shader_axis

	# 니리에는 배치 파일이 걸릴 자리가 없어 하이프랜드에서만 둔다.
	has_hypr && try_axis layout "배치" view_quilt layout '[]' '["layout", "tiling", "arrange"]'

	try_axis term "터미널" terminal term '[]' '["term", "terminal", "ghostty"]'

	# 월페이퍼는 후보가 수백 장이고 고르는 UI(fuzzel/yazi)가 있어 값 없이 동작만 둔다.
	if [ -d "${RICE_WALLPAPERS:-$HOME/Pictures/Wallpapers}" ]; then
		printf '' | axis wall "월페이퍼" wallpaper "" '[
			{ "value": "random", "label": "무작위", "keywords": ["random", "shuffle"],
			  "comment": "전체에서 하나 (apps/rice/wall)" },
			{ "value": "pick",   "label": "고르기…", "keywords": ["pick", "choose", "fuzzel"],
			  "comment": "fuzzel 로 경로 목록에서" },
			{ "value": "yazi",   "label": "미리보기로 고르기…", "keywords": ["yazi", "preview"],
			  "comment": "yazi 로 그림을 보면서" }
		]' '["wall", "wallpaper", "background"]'
	fi
} | jq -s '{ axes: . }'
