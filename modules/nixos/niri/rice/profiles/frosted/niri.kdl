// frosted — 넓은 갭, 큰 곡률, 깊은 그림자. 창 사이로 배경이 보이는 룩.
//
// 블러는 DMS 쪽(dms.json 의 blurEnabled)이다. 여기는 블러가 보일 여백을 만든다 — 갭이 좁으면 티가 안 난다.

layout {
    gaps 14

    // 곡률이 큰 창에서 얇은 보더는 계단처럼 보여서 활성 창에만 그려지는 링만 남긴다.
    border {
        off
    }

    focus-ring {
        width 2
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=6
        color "#00000080"
    }
}

overview {
    zoom 0.5
    backdrop-color "#0b0b0f"
}

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}
