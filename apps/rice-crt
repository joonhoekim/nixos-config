#!/bin/sh -e
#
# Switch the Hyprland output shader, live.
#
#   apps/rice-crt              현재 것과 목록만 출력
#   apps/rice-crt crt          전환
#   apps/rice-crt --next       목록 순서대로 다음 것 (Mod+Shift+C 와 같은 순환)
#   apps/rice-crt --reload     지금 걸린 것을 파일에서 다시 읽는다 (값 튜닝용)
#   apps/rice-crt off          셰이더 없는 상태로 (탈출구)
#
# 룩 하나 = ~/.config/hypr/shaders/<name>.frag 파일 하나. decoration:screen_shader
# 에 절대 경로를 넣으면 렌더링이 끝난 화면 한 장에 그 프래그먼트 셰이더가 한 번 더
# 걸린다 — 벽지도 바도 창도 커서도 같은 유리 뒤로 들어간다. 니리에 없는 훅이고,
# 하이프랜드 세션이 이 레포에 있는 이유다(../modules/nixos/hyprland).
#
# ── 왜 hyprctl keyword 가 아니라 eval 인가 ────────────────────────────────
# 이 레포의 하이프랜드는 hyprland.conf 가 아니라 hyprland.lua 로 설정한다. 0.56 의
# lua 파서에서 `hyprctl keyword` 는 통째로 거절당한다:
#
#   keyword can't work with non-legacy parsers. Use eval.
#
# 그래서 밖에서 설정을 건드리는 길은 `hyprctl eval` 로 lua 를 한 줄 밀어 넣는 것
# 하나뿐이다. hyprland.lua 의 Mod+Shift+C 도 결국 같은 hl.config 를 부른다.
#
# ── 고른 이름을 파일에 안 적어 두는 이유 ──────────────────────────────────
# 다른 스위처들은 ~/.config/rice/<축> 에 현재 이름을 적어 두지만(rice-lib.sh 의
# rice_current_file) 여기는 안 적고 컴포지터에게 묻는다. 이 축에는 스위처가 둘이기
# 때문이다 — 이 스크립트와 Mod+Shift+C. 파일에 적어 두면 키로 바꿨을 때 파일이
# 낡고, 낡은 파일을 보고 "다음 것"을 고르면 엉뚱한 데로 뛴다. 걸려 있는 셰이더는
# 컴포지터가 이미 알고 있으니 그쪽이 유일한 진실이다. hyprland.lua 의 키바인드도
# 같은 이유로 카운터를 안 들고 hl.get_config 를 본다.
#
# ── 데미지 트래킹 ─────────────────────────────────────────────────────────
# `time` 유니폼을 읽는 셰이더는 매 프레임 그림이 달라질 수 있어서 하이프랜드의
# 데미지 트래킹과 같이 못 산다 — 그냥 걸면 하이프랜드가 경고 오버레이를 띄우고
# time 을 0 으로 고정한다. 그래서 파일이 time 을 쓰는지 보고 debug:damage_tracking
# 을 같이 움직인다. 끄면 화면은 아무것도 안 바뀌어도 매 프레임 통째로 다시 그려져서
# 배터리가 눈에 띄게 준다. 셰이더를 새로 넣어도 이 판단은 자동이다.

# 목록·순환·거절은 apps/rice-switch, apps/rice-term 과 같은 모양이어야 해서
# rice-lib.sh 에 있다. rice_current 는 아래에서 갈아치운다(머리말 참고).
. "$(dirname "$0")/rice-lib.sh"

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
shaders="$cfg/hypr/shaders"

rice_kind="화면 셰이더"

# 니리 세션이나 맥에서 부르면 hyprctl 이 없거나, 있어도 붙을 인스턴스가 없다.
# 그냥 두면 eval 이 조용히 실패하고 "바꿨는데 아무 일도 안 일어났다"가 된다.
if ! command -v hyprctl >/dev/null 2>&1 || [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  printf "${RED}하이프랜드 세션이 아니다 — 화면 셰이더는 여기서만 걸린다.${NC}\n"
  printf "${DIM}터미널 창 하나에만 거는 브라운관은 양쪽에서 된다: apps/rice-term crt${NC}\n"
  exit 1
fi

if [ ! -d "$shaders" ]; then
  printf "${RED}%s 가 없다. 한 번 rebuild 하면 시드된다 (apps/build-switch).${NC}\n" "$shaders"
  exit 1
fi

# off 를 앞에 둔다. 목록 순서가 곧 --next 의 순서이고, 로그인 직후가 off 이므로
# 거기서 시작해 점점 세게 가는 편이 손에 붙는다.
rice_list() {
  printf 'off\n'
  for f in "$shaders"/*.frag; do
    [ -f "$f" ] || continue
    f="${f##*/}"
    printf '%s\n' "${f%.frag}"
  done | sort
}

# 값이 두 가지 모양으로 나온다: 한 번도 안 건드린 세션은 `[[EMPTY]]`(set: false),
# 껐다 켠 뒤로는 빈 문자열(set: true). 둘 다 off 다.
rice_current() {
  cur="$(hyprctl getoption decoration:screen_shader 2>/dev/null |
    sed -n 's/^str:[[:space:]]*//p' | sed 's/[[:space:]]*$//')"
  case "$cur" in
  "" | "[[EMPTY]]") printf 'off\n' ;;
  *)
    cur="${cur##*/}"
    printf '%s\n' "${cur%.frag}"
    ;;
  esac
}

# --reload 는 rice_dispatch 에 안 넘긴다. "무엇으로 바꿀지"가 아니라 "지금 것을
# 다시 읽어라"여서 이름을 고르는 그 함수의 문법에 안 맞는다. 하이프랜드는 셰이더를
# 걸 때마다 파일을 새로 읽으므로, 값을 고치고 이걸 한 번 돌리면 그대로 반영된다.
case "${1:-}" in
--reload | -r)
  name="$(rice_current)"
  [ "$name" = "off" ] &&
    printf "${DIM}지금은 off 다 — 고친 값을 보려면 셰이더를 먼저 걸 것 (apps/rice-crt --next).${NC}\n"
  ;;
*)
  rice_dispatch "$@"
  name="$RICE_NAME"
  ;;
esac

if [ "$name" = "off" ]; then
  src=""
  damage=2 # 하이프랜드 기본값(full)
else
  src="$shaders/$name.frag"
  [ -f "$src" ] || rice_reject "$name"
  if grep -Eq '^[[:space:]]*uniform[[:space:]]+float[[:space:]]+time[[:space:]]*;' "$src"; then
    damage=0
  else
    damage=2
  fi
fi

# 컴파일 실패는 여기서 못 잡는다. 하이프랜드는 셰이더를 걸어 두고 *다음 프레임에*
# 컴파일하며, 실패해도 hyprctl 은 ok 를 돌려주고 로그에도 안 남는다(0.56.1 에서
# 실측). 그래서 검증기가 PATH 에 있을 때만 미리 한 번 돌린다 — 이 레포는 그걸 깔지
# 않으므로 평소에는 이 블록이 통째로 비켜 간다. rice-term 이 ghostty 셰이더에 대해
# 같은 처지인 것과 같다(거기도 잡을 방법이 없어서 탈출구를 안내한다).
if [ -n "$src" ] && command -v glslangValidator >/dev/null 2>&1; then
  if ! out="$(glslangValidator -S frag "$src" 2>&1)"; then
    printf "${RED}%s 가 컴파일되지 않는다. 안 건다.${NC}\n" "$name"
    printf '%s\n' "$out" | sed 's/^/  /'
    exit 1
  fi
fi

# 순서가 중요하다: 먼저 떼고 → 트래킹을 맞추고 → 다시 건다. 뒤집히면 time 을 쓰는
# 셰이더가 트래킹이 켜진 채로 올라오는 순간이 생기고, 하이프랜드는 그걸 경고
# 오버레이 + time 고정으로 갚는다. hyprland.lua 의 키바인드도 같은 순서다.
set_shader() { # set_shader <절대 경로 또는 빈 문자열>
  hyprctl eval "hl.config({ decoration = { screen_shader = \"$1\" } })" >/dev/null
}

set_shader ""
hyprctl eval "hl.config({ debug = { damage_tracking = $damage } })" >/dev/null
set_shader "$src"

printf "  hyprland   %s\n" "screen_shader ← ${src:-(없음)}"
if [ "$damage" -eq 0 ]; then
  printf "${GREEN}화면 셰이더: %s${NC} ${YELLOW}(데미지 트래킹 끔 — 매 프레임 전체 재생성)${NC}\n" "$name"
else
  printf "${GREEN}화면 셰이더: %s${NC}\n" "$name"
fi

# 셰이더가 깨지면 화면이 새까매지거나 알아볼 수 없게 된다. 그 상태에서도 이 줄은
# 다른 tty 나 눈 감고 친 명령으로 돌릴 수 있다.
[ "$name" = "off" ] || printf "${DIM}화면이 이상해지면: apps/rice-crt off${NC}\n"
