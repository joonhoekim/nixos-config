#!/bin/sh -e
#
# Push the repo's ricing files back over the live ones in ~/.config.
#
# apps/rice/save 의 반대 방향. 손 안 댄 라이브는 리빌드의 rice_sync 가 따라가므로, 이건 사람이
# 레포 쪽을 고를 때 쓴다. 대상은 rice-save 와 같은 집합이어야 왕복이 맞는다.
# 쓰는 법·대상 표·덮기 전 백업: docs/rice-scripts.md

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

# 기준선은 갱신만 한다 — 덮고 안 옮기면 다음 rice-save 가 이 파일을 "라이브가 바뀐 것"으로 본다.
. "$(dirname "$0")/baseline.sh"

# rice-save 와 같은 이유로 $0 이 아니라 작업 디렉터리에서 찾는다($0 은 스토어 안일 수 있다).
repo="${RICE_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
rice="$repo/modules/nixos/niri/rice"
gt="$repo/modules/shared/ghostty"
hy="$repo/modules/nixos/hyprland/rice"
dm="$repo/modules/nixos/dms"
dr="$repo/modules/darwin/rice"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

if [ -z "$repo" ] || [ ! -d "$repo/modules/nixos/niri" ]; then
  printf "${RED}Run this from inside the nixos-config checkout, or set RICE_REPO.${NC}\n"
  exit 1
fi

linux_only="niri profiles hypr studio dms fuzzel gtk"
mac_only="wezterm rift-grid linearmouse helpers"
all="$linux_only ghostty $mac_only"
# uname 으로 가른다 — `command -v niri` 면 니리를 아직 안 깐 리눅스에서 조용히 절반만 복원하고,
# 안 가르면 원본이 레포에 늘 있어 맥에 니리 설정을 심는다.
if [ "$(uname)" = "Darwin" ]; then
  usable="ghostty $mac_only"
else
  usable="$linux_only ghostty"
fi

want=""
given=0
check_only=0
assume_yes=0
while [ $# -gt 0 ]; do
  case "$1" in
  --check) check_only=1 ;;
  --yes | -y) assume_yes=1 ;;
  -*)
    printf "${RED}알 수 없는 옵션: %s${NC}\n" "$1"
    exit 1
    ;;
  *)
    case " $all " in
    *" $1 "*) ;;
    *)
      printf "${RED}알 수 없는 대상: %s${NC}\n" "$1"
      printf "  %s\n" "$all"
      exit 1
      ;;
    esac
    given=$((given + 1))
    # 이 플랫폼 것이 아니면 거절하지 않고 건너뛴다 — 두 플랫폼에서 같은 명령을 돌린다.
    case " $usable " in
    *" $1 "*) want="$want $1" ;;
    *) printf "${YELLOW}건너뜀${NC}       %s (%s 에는 대상이 없다)\n" "$1" "$(uname)" ;;
    esac
    ;;
  esac
  shift
done

if [ "$given" -eq 0 ]; then
  want="$usable"
elif [ -z "$want" ]; then
  printf "${GREEN}고른 대상이 이 플랫폼에 없다. 할 일이 없다.${NC}\n"
  exit 0
fi

backup="$cfg/rice/backups/$(date -u +%Y%m%d-%H%M%SZ)"

# 같은 목록을 report 와 write 두 모드로 돈다 — 목록을 두 벌 적으면 어긋난다.
mode="report"
changed=0

# 비교 전에 rice-fuzzel 이 붙인 include 줄과 그 주석을 뗀다 — 레포 파일에는 없어서 안 떼면
# fuzzel.ini 가 영원히 "다름"이다. rice-save 의 거르기와 같아야 한다.
fuzzel_live() {
  sed -e '/^include=.*dank-rice\.ini$/d' -e '/^# apps\/rice-fuzzel /d' | sed '/./,$!d'
}

item() { # item <레포 원본> <라이브 대상> [비교 전에 라이브를 거를 함수]
  src="$1"
  dst="$2"
  filter="${3:-}"
  rel="${dst#"$HOME"/}"

  if [ ! -e "$src" ]; then
    [ "$mode" = report ] && printf "  ${YELLOW}레포에 없음${NC}  %s\n" "${src#"$repo"/}"
    return 0
  fi

  # 거르는 건 비교뿐이다. 쓸 때는 레포 파일을 그대로 얹고, 떼인 줄은 스위처가 다시 붙인다.
  cmp_dst="$dst"
  if [ -n "$filter" ] && [ -f "$dst" ]; then
    cmp_dst="$(mktemp)"
    "$filter" <"$dst" >"$cmp_dst"
  fi
  if diff -rq "$src" "$cmp_dst" >/dev/null 2>&1; then
    [ "$cmp_dst" = "$dst" ] || rm -f "$cmp_dst"
    [ "$mode" = report ] && printf "  ${DIM}같음${NC}         ~/%s\n" "$rel"
    return 0
  fi
  [ "$cmp_dst" = "$dst" ] || rm -f "$cmp_dst"

  changed=$((changed + 1))
  if [ "$mode" = report ]; then
    if [ -e "$dst" ]; then
      printf "  ${YELLOW}덮어씀${NC}       ~/%s\n" "$rel"
    else
      printf "  ${GREEN}새로 씀${NC}      ~/%s\n" "$rel"
    fi
    return 0
  fi

  # 새로 쓰는 것은 백업할 게 없고, 되돌릴 때도 지우면 그만이라 롤백이 신경 쓰지 않는다.
  if [ -e "$dst" ]; then
    mkdir -p "$backup/$(dirname "$rel")"
    cp -R "$dst" "$backup/$rel"
  fi
  mkdir -p "$(dirname "$dst")"
  # 지우고 새로 만들어야 레포에서 사라진 조각이 안 남는다. rm 이 앞에 있어서 `cp -R` 이
  # GNU 의 `-T` 와 같은 결과다(BSD 에는 그 플래그가 없다).
  rm -rf "$dst"
  cp -R "$src" "$dst"
  chmod -R u+w "$dst"
  # 밀어넣은 지점이 새 기준선이다. 거르개가 있는 파일은 스위처가 붙일 파생 줄이 비교에서
  # 걸러지므로 레포 내용을 담아도 된다(baseline.sh 의 거르개 문단).
  rice_baseline_record "$dst" "$src"
  printf "  ${GREEN}복원${NC}         ~/%s\n" "$rel"
}

plan() {
  case " $want " in *" niri "*)
    item "$rice/config.kdl" "$cfg/niri/config.kdl"
    item "$rice/animations.kdl" "$cfg/niri/animations.kdl"
    ;;
  esac
  case " $want " in *" profiles "*)
    item "$rice/profiles" "$cfg/rice/profiles"
    ;;
  esac
  case " $want " in *" hypr "*)
    # 쓰는 것만으로는 화면에 안 나타난다 — 아래 파생물 단계가 hyprctl reload 와 rice-crt --reload 를 맡는다.
    item "$hy/hyprland.lua" "$cfg/hypr/hyprland.lua"
    item "$hy/layouts" "$cfg/hypr/layouts"
    item "$hy/shaders" "$cfg/hypr/shaders"
    # 이름 붙인 체인도 같은 처지다. rm+cp 라서 rice-crt --save 로 만들고 아직
    # rice-save 로 안 되받은 체인은 여기서 지워진다 — 백업에는 남는다.
    item "$hy/chains" "$cfg/hypr/chains"
    ;;
  esac
  case " $want " in *" studio "*)
    # 파생물 단계가 없다 — 스튜디오는 창을 띄울 때 QML 을 읽는다(apps/rice/studio).
    item "$hy/studio" "$cfg/rice-studio"
    ;;
  esac
  case " $want " in *" dms "*)
    # 이름을 박지 않는 이유는 apps/rice/save 의 같은 자리에 있다.
    for p in "$dm"/plugins/*/; do
      [ -d "$p" ] || continue
      n="$(basename "$p")"
      item "$dm/plugins/$n" "$cfg/DankMaterialShell/plugins/$n"
    done
    ;;
  esac
  case " $want " in *" ghostty "*)
    item "$gt/config" "$cfg/ghostty/config"
    item "$gt/rices" "$cfg/ghostty/rices"
    item "$gt/shaders" "$cfg/ghostty/shaders"
    ;;
  esac
  case " $want " in *" fuzzel "*)
    item "$rice/fuzzel.ini" "$cfg/fuzzel/fuzzel.ini" fuzzel_live
    ;;
  esac
  case " $want " in *" gtk "*)
    item "$rice/gtk-settings.ini" "$cfg/gtk-3.0/settings.ini"
    item "$rice/gtk-settings.ini" "$cfg/gtk-4.0/settings.ini"
    ;;
  esac

  # ── macOS ───────────────────────────────────────────────────────────────
  # rift-grid/config.toml 을 덮으면 테두리 색도 레포의 것이 된다. 벽지 색으로 되돌리려면
  # `apps/rice/colors --reload`.
  case " $want " in *" wezterm "*)
    item "$dr/wezterm" "$cfg/wezterm"
    ;;
  esac

  case " $want " in *" rift-grid "*)
    item "$dr/rift-grid/config.toml" "$cfg/rift-grid/config.toml"
    ;;
  esac

  case " $want " in *" linearmouse "*)
    item "$dr/linearmouse/linearmouse.json" "$cfg/linearmouse/linearmouse.json"
    ;;
  esac

  case " $want " in *" helpers "*)
    item "$dr/bin" "$cfg/rice/bin"
    ;;
  esac
}

printf "${YELLOW}레포 → 라이브${NC} ${DIM}(%s)${NC}\n" "${want# }"
plan

if [ "$changed" -eq 0 ]; then
  printf "${GREEN}라이브가 레포와 같다. 덮을 것이 없다.${NC}\n"
  exit 0
fi
if [ "$check_only" -eq 1 ]; then
  printf "${GREEN}검사만 했다 — %d 개가 다르고, 아무것도 안 썼다.${NC}\n" "$changed"
  exit 0
fi

if [ "$assume_yes" -eq 0 ]; then
  printf "${YELLOW}%d 개를 덮는다. 지금 것은 ~/%s 로 옮겨 둔다. 계속할까? [y/N] ${NC}" \
    "$changed" "${backup#"$HOME"/}"
  # 파이프 뒤에서 돌 때는 stdin 이 없다. -e 가 걸려 있으므로 read 의 실패를 여기서
  # 삼키고, 답이 없으면 아래 case 가 거절로 처리한다.
  read -r ans </dev/tty 2>/dev/null || ans=""
  case "$ans" in
  [yY]*) ;;
  *)
    printf "그만둔다.\n"
    exit 1
    ;;
  esac
fi

mode="write"
changed=0
plan

# niri 는 로드할 때만 불평해서 깨진 설정이 다음 로그인에야 드러난다. 레포 파일은 그 자리에서
# 검증할 수 없으므로(`include "dms/layout.kdl"` 은 optional 이 아니고 라이브에만 있다) 먼저
# 복원하고, 실패하면 백업에서 되돌린다.
if command -v niri >/dev/null 2>&1 && [ -f "$cfg/niri/config.kdl" ]; then
  if ! out="$(niri validate --config "$cfg/niri/config.kdl" 2>&1)"; then
    printf "${RED}복원한 니리 설정이 유효하지 않다. 백업에서 되돌린다.${NC}\n"
    printf '%s\n' "$out" | sed 's/^/  /'
    [ -d "$backup" ] && cp -R "$backup/." "$HOME/"
    printf "${YELLOW}되돌렸다. 새로 만들어진 파일은 남아 있을 수 있다 — ~/%s 와 비교할 것.${NC}\n" \
      "${backup#"$HOME"/}"
    exit 1
  fi
fi

printf "${DIM}백업: ~/%s${NC}\n" "${backup#"$HOME"/}"

# ── 파생물 다시 만들기 ────────────────────────────────────────────────────
# 화면이 읽는 것은 스위처의 파생물(rices/ → rice.conf, profiles/ → profile.kdl·settings.json)이라
# 다시 만들지 않으면 복원해도 안 바뀐다. 스위처가 실패해도 복원은 끝났으니 할 일만 알린다.
here="$(dirname "$0")"

# 걸린 셰이더는 이미 컴파일돼 있어 다시 걸어야 바뀐다. 하이프랜드 세션이 아니면 rice-crt 가
# 거절하므로(빨간 줄은 겁만 준다) 부르지 않는다.
case " $want " in *" hypr "*)
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    # item() 의 rm+cp 가 감시하던 아이노드를 없애 컴포지터가 옛 설정으로 계속 돈다 —
    # "복원 완료" 를 보고도 새 키맵이 안 걸려 있다. 그래서 명시적으로 다시 읽힌다.
    hyprctl reload >/dev/null 2>&1 || printf "${YELLOW}hyprctl reload 실패 — 손으로: hyprctl reload${NC}\n"
    "$here/crt" --reload || printf "${YELLOW}rice-crt 실패 — 손으로: apps/rice/crt --reload${NC}\n"
  else
    printf "${DIM}하이프랜드 세션이 아니다 — 셰이더는 다음 로그인부터.${NC}\n"
  fi
  ;;
esac

# rm+cp 가 감시를 끊을 수 있고, plugin.json 은 dms restart 라야 읽힌다(../../modules/nixos/dms
# 머리말). reload 를 걸어 보고 실패하면 할 일을 알린다.
case " $want " in *" dms "*)
  if command -v dms >/dev/null 2>&1; then
    # 매니페스트의 id 는 폴더 이름과 다르다(TouchControls -> touchControls).
    # reload 가 받는 것은 id 쪽이라 plugin.json 에서 읽는다.
    reload_failed=0
    for p in "$dm"/plugins/*/; do
      [ -f "$p/plugin.json" ] || continue
      id="$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$p/plugin.json" | head -1)"
      [ -n "$id" ] || continue
      dms ipc call plugins reload "$id" >/dev/null 2>&1 || reload_failed=1
    done
    if [ "$reload_failed" -eq 0 ]; then
      printf "${DIM}DMS 플러그인 다시 읽혔다. plugin.json 을 바꿨다면: dms restart${NC}\n"
    else
      printf "${YELLOW}플러그인 reload 실패 — 손으로: dms restart${NC}\n"
    fi
  else
    printf "${DIM}dms 가 없다 — 플러그인은 셸이 다음에 뜰 때 읽힌다.${NC}\n"
  fi
  ;;
esac

case " $want " in *" ghostty "*)
  term="$(cat "$cfg/rice/term" 2>/dev/null || true)"
  if [ -n "$term" ]; then
    "$here/term" "$term" || printf "${YELLOW}rice-term 실패 — 손으로: apps/rice/term %s${NC}\n" "$term"
  else
    printf "${DIM}켜 둔 터미널 룩을 모른다 — apps/rice/term 으로 하나 고를 것.${NC}\n"
  fi
  ;;
esac

# fuzzel 도 여기 걸린다 — 레포 fuzzel.ini 에는 include 줄이 없고, rice-switch 가 부르는
# rice-fuzzel 이 그 줄과 색 파일을 다시 만든다.
case " $want " in *" profiles "* | *" fuzzel "*)
  # macOS 는 여기 못 온다 — 위에서 두 대상이 want 에서 빠진다.
  prof="$(cat "$cfg/rice/current" 2>/dev/null || true)"
  if [ -n "$prof" ]; then
    "$here/switch" "$prof" || printf "${YELLOW}rice-switch 실패 — 손으로: apps/rice/switch %s${NC}\n" "$prof"
  else
    printf "${DIM}켜 둔 프로필을 모른다 — apps/rice/switch 로 하나 고를 것.${NC}\n"
  fi
  ;;
esac

# rm+cp 가 hot_reload 감시를 끊으므로 명시적으로 reload 한다. rift-grid 는 한 줄만 틀려도 파일
# 전체를 거부하고 조용히 옛 설정으로 돈다 — 그 이유가 찍히는 유일한 자리라 출력을 삼키지 않는다.
case " $want " in *" rift-grid "*)
  if command -v rift-grid-cli >/dev/null 2>&1; then
    if rift-grid-cli execute config reload; then
      printf "${DIM}rift-grid 설정 다시 읽혔다.${NC}\n"
    else
      printf "${RED}rift-grid 가 복원된 설정을 거부했다 — 위 이유를 볼 것. 옛 설정으로 돌고 있다.${NC}\n"
      printf "${DIM}백업: ~/%s${NC}\n" "${backup#"$HOME"/}"
    fi
  else
    # rift-grid 를 아직 안 깐 Mac. 파일은 이미 제자리이므로 실패로 다루지 않는다.
    printf "${DIM}rift-grid-cli 가 없다 — 설정은 심었고, 다음 실행부터 걸린다.${NC}\n"
  fi
  ;;
esac

# rm+cp 가 감시를 끊으므로 다시 띄운다. 그 전에 JSON 을 검사한다 — 파싱 에러가 나면 LinearMouse 는
# 설정이 없는 것처럼 군다.
case " $want " in *" linearmouse "*)
  if ! python3 -m json.tool "$cfg/linearmouse/linearmouse.json" >/dev/null 2>&1; then
    printf "${RED}복원한 linearmouse.json 이 유효한 JSON 이 아니다. LinearMouse 는 이걸 무시한다.${NC}\n"
    printf "${DIM}백업: ~/%s${NC}\n" "${backup#"$HOME"/}"
  elif launchctl kickstart -k "gui/$(id -u)/org.nixos.linearmouse" >/dev/null 2>&1; then
    printf "${DIM}LinearMouse 다시 읽혔다.${NC}\n"
  else
    # LinearMouse 를 아직 안 깐 Mac(또는 build-switch 전). 파일은 제자리다.
    printf "${DIM}LinearMouse 에이전트가 없다 — 설정은 심었고, 앱을 깔면 걸린다.${NC}\n"
  fi
  ;;
esac

# wezterm 은 디렉터리를 통째로 감시해 rm+cp 뒤에도 알아서 다시 읽는다(modules/darwin/rice/wezterm/wezterm.lua).
# helpers 는 키마다 새로 실행되는 스크립트라 할 일이 없다.

printf "${GREEN}복원 완료.${NC}\n"
