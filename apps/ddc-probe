#!/bin/sh -e
#
# 모니터가 DDC/CI 로 **실제로 무엇을 받아들이는지** 눈으로 확인한다.
#
#   apps/ddc-probe                 감지된 디스플레이 목록
#   apps/ddc-probe 1               1 번 디스플레이를 시각 테스트 (기본 항목)
#   apps/ddc-probe 1 --dump        1 번의 VCP 값을 전부 덤프
#   apps/ddc-probe 1 --caps        1 번이 지원한다고 *주장하는* 기능 목록
#   apps/ddc-probe 1 --feature 0A  임의의 VCP 코드 하나를 직접 시험
#
# ── 왜 "되읽기"로는 부족한가 ──────────────────────────────────────────────
# 이 도구가 있는 이유가 여기 있다. `ddcutil setvcp 10 60` 뒤에 `getvcp 10` 이
# 60 을 돌려주면 밝기 조절이 되는 것처럼 보인다. 아니다. 그건 모니터가 값을
# **기억한다**는 뜻일 뿐이고, 그 값대로 실제로 움직였는지는 전혀 다른 얘기다.
#
# evo-t1 에 물린 HCS 40LGD5K 에서 정확히 그 착각을 했다. 되읽기가 멀쩡해서
# "된다"고 적었는데 화면은 안 변했고, 반대로 화면이 안 변하니 "이 펌웨어가
# 0x10 을 백라이트에 안 이어 뒀다"고 단정했는데 그것도 틀렸다. 진짜 원인은
# 모니터 OSD 의 HDR 이 Auto 였던 것이다 — 그 모드에서는 패널이 수동 밝기를
# 무시한다. DDC 는 처음부터 끝까지 정상이었고, OS 쪽은 HDR 을 켠 적이 없어서
# (하이프랜드는 colorManagementPreset srgb) 어느 방향으로도 안 보였다.
#
# 그러니 이 도구가 답하는 질문은 "모니터가 값을 받았는가"가 아니라 "화면이
# 움직였는가" 하나다. 판정은 사람 눈이 한다. 값을 걸어 둔 채 물어보고, 답을
# 듣고 나서 되돌린다 — 천천히 비교할 시간을 주려는 것이다.
#
# 눈으로 봐도 안 변하면, 다음은 이 레포가 아니라 **모니터 OSD** 다. HDR·DCR·
# 다이내믹 명암·에코 중 하나가 켜져 있으면 수동 밝기가 잠긴다.
#
# ── 모니터는 태연히 거짓말을 한다 ─────────────────────────────────────────
# 위와 별개로, 같은 패널에서 확인한 것들이다. capabilities 문자열도 응답값도
# 그 자체로는 근거가 못 된다:
#
#   0x60  DisplayPort 로 연결돼 있는데 "S-Video-1" 이라고 답한다.
#   0x13  capabilities 에 없는데 답은 한다. 그것도 같은 응답 안에서 현재값이
#         최대값보다 크고, 쓰기는 DDCRC_VERIFY 로 거절한다.
#
# ── 무슨 일이 있어도 되돌린다 ─────────────────────────────────────────────
# 밝기 0 을 걸어 놓고 죽으면 깜깜한 화면이 남는다. 그래서 원래 값을 먼저 읽어
# 두고 trap 으로 EXIT·INT·TERM 을 전부 잡는다. Ctrl+C 로 빠져나와도 복구된다.
#
# ── 권한 ──────────────────────────────────────────────────────────────────
# /dev/i2c-* 는 root:i2c 0660 이지만 hardware.i2c 의 udev 규칙이 uaccess 태그를
# 붙이므로, 좌석에 로그인한 사용자에게는 ACL 로 열려 있다(getfacl 로 확인 가능).
# 그래서 보통은 sudo 가 필요 없다. 안 되는 환경(원격 SSH 등)에서는 DDC_SUDO=1.

DDCUTIL="${DDCUTIL:-ddcutil}"
GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

command -v "$DDCUTIL" >/dev/null 2>&1 || {
	printf "${RED}ddcutil 이 없다.${NC} modules/nixos/packages.nix 에 들어 있어야 한다.\n"
	printf "임시로는: ${DIM}nix shell nixpkgs#ddcutil --command apps/ddc-probe %s${NC}\n" "$*"
	exit 1
}

# uaccess ACL 이 있으면 맨몸으로 되고, 없으면 sudo 로 넘어간다. 판정을 --probe
# 같은 실제 통신으로 하지 않는 것은 그것만으로도 몇 초가 걸리기 때문이다.
ddc() {
	if [ "${DDC_SUDO:-0}" = "1" ]; then
		sudo "$DDCUTIL" "$@"
	else
		"$DDCUTIL" "$@"
	fi
}

# ── 디스플레이 목록 ───────────────────────────────────────────────────────
# `detect --brief` 는 디스플레이당 한 덩어리를 내놓는다. 번호·I2C 버스·모델만
# 뽑아 한 줄로 접는다. 커넥터 이름(card1-DP-1)까지 같이 보여야 "지금 보고 있는
# 그 모니터"를 고를 수 있다.
list_displays() {
	# 라벨은 ddcutil 판마다 조금씩 다르다 — DRM connector 는 예전에
	# DRM_connector 였다. 그래서 `.` 로 둘 다 받고, 값은 항상 마지막 필드로
	# 집는다(모델 문자열에는 공백이 없다).
	ddc detect --brief 2>/dev/null | awk '
		/^Display /       { n = $2 }
		/I2C bus:/        { split($NF, a, "-"); bus = a[2] }
		/DRM.connector:/  { conn = $NF }
		/Monitor:/        { mon = $NF }
		/^$/              { if (n) printf "%s\t%s\t%s\t%s\n", n, bus, conn, mon; n = "" }
		END               { if (n) printf "%s\t%s\t%s\t%s\n", n, bus, conn, mon }
	'
}

show_displays() {
	_found="$(list_displays)"
	if [ -z "$_found" ]; then
		printf "  ${RED}없다.${NC} ${DIM}DDC/CI 를 지원하지 않거나, 모니터 OSD 에서 꺼져 있거나,\n"
		printf "  /dev/i2c-* 에 접근할 수 없는 경우다 (DDC_SUDO=1 로 다시 해 볼 것).${NC}\n"
		return 0
	fi
	printf '%s\n' "$_found" | while IFS="$(printf '\t')" read -r n bus conn mon; do
		printf "  ${GREEN}%s${NC}  bus ${YELLOW}i2c-%-3s${NC} %-14s %s\n" "$n" "$bus" "$conn" "$mon"
	done
}

bus_for() { # bus_for <display-number>
	list_displays | awk -F"$(printf '\t')" -v want="$1" '$1 == want { print $2; found = 1 } END { exit !found }'
}

# ── 한 기능을 걸어 보고 눈으로 판정한다 ───────────────────────────────────
# 순서가 중요하다: 현재값 읽기 → 시험값 쓰기 → **걸어 둔 채로** 질문 → 복구.
# 물어본 뒤에 복구하는 것이 핵심이다. 먼저 되돌려 놓고 "아까 변했나요" 를 물으면
# 기억에 의존하게 되고, 미묘한 변화일수록 답이 흔들린다.
#
# ── setvcp 에 --noverify 를 붙이는 이유 ───────────────────────────────────
# ddcutil 은 기본적으로 쓰고 나서 곧바로 되읽어 확인하고, 다르면 DDCRC_VERIFY 로
# 실패한다. 그 확인이 값은 멀쩡히 들어간 채로 실패하는 것을 40LGD5K 에서 봤다 —
# 빠르게 연속으로 쓸 때 0x12 에서 한 번, 그리고 0x13 처럼 애초에 지원하지 않는
# 코드에서는 항상. 그 상태로 두면 "쓰기 실패" 라고 보고하면서 화면은 실제로
# 바뀌어 있는, 정반대로 틀린 결과가 나온다.
#
# (HDR 을 끄고 나서는 0x10 도 0x12 도 검증을 통과한다. 그러니 이건 이 패널의
# 항구적 성질이라기보다 신뢰할 수 없는 신호다 — 어느 쪽이든 여기서 판정 근거로
# 삼지 않는다는 결론은 같다.)
#
# 그래서 확인은 끄고, 판정은 눈에 맡긴다. 그리고 쓰기가 오류를 내더라도 복구는
# **반드시** 한다. 오류가 "안 들어갔다"는 뜻이 아니기 때문이다 — 한 번 이걸
# 건너뛰었다가 명암이 25 에 걸린 채로 남았다.
RESULTS=""
probe_feature() { # probe_feature <bus> <code> <이름> <시험값>
	_bus="$1"; _code="$2"; _label="$3"; _test="$4"

	_cur="$(ddc getvcp "$_code" --bus "$_bus" 2>/dev/null |
		sed -n 's/.*current value = *\([0-9]*\).*/\1/p')"
	if [ -z "$_cur" ]; then
		printf "  ${DIM}0x%s (%s): 연속값으로 안 읽힌다 — 건너뛴다${NC}\n" "$_code" "$_label"
		RESULTS="${RESULTS}0x${_code}\t${_label}\t읽기실패\n"
		return 0
	fi

	printf "\n  0x%s (%s): 현재 %s ${YELLOW}-> %s${NC} 로 바꾼다\n" "$_code" "$_label" "$_cur" "$_test"
	RESTORE_BUS="$_bus"; RESTORE_CODE="$_code"; RESTORE_VAL="$_cur"
	_note=""
	if ! ddc setvcp "$_code" "$_test" --bus "$_bus" --noverify >/dev/null 2>&1; then
		_note=" ${DIM}(쓰기가 오류를 냈다)${NC}"
		printf "  ${YELLOW}쓰기가 오류를 반환했다 — 그래도 들어갔을 수 있으니 화면을 본다.${NC}\n"
	fi

	printf "  ${GREEN}화면을 보세요.${NC} 지금 눈에 띄게 변했습니까? [y/N] "
	# 파이프로 물려 있어도 사람에게 묻고 싶으니 /dev/tty 를 먼저 본다. 제어
	# 터미널이 없는 자리(CI·훅·에이전트)에서는 그것을 열 수 없으므로 stdin 으로
	# 물러선다. 둘 다 안 되면 빈 답, 즉 "안 변했다" 로 친다 — 어느 쪽이든 아래
	# 복구는 그대로 돈다.
	#
	# `[ -r /dev/tty ]` 로는 안 된다. 장치 노드는 늘 거기 있고 권한도 열려
	# 있어서 검사는 통과하는데, 제어 터미널이 없으면 open 이 ENXIO 로 실패한다.
	# 그래서 권한이 아니라 **실제로 열어 본다**.
	#
	# 그 열어 보기는 반드시 서브셸 안에서 한다. `: </dev/tty` 로 쓰면 `:` 이
	# 특수 내장 명령이라, POSIX 상 리다이렉션 실패가 비대화형 셸을 그 자리에서
	# 끝내 버린다 — if 의 조건이라 잡힐 것 같지만 안 잡힌다. 서브셸이면 죽는 것이
	# 서브셸이고, 부모는 0 아닌 종료 상태만 받는다.
	if (: </dev/tty) 2>/dev/null; then
		read -r ans </dev/tty || ans=""
	else
		read -r ans || ans=""
	fi

	ddc setvcp "$_code" "$_cur" --bus "$_bus" --noverify >/dev/null 2>&1 || true
	RESTORE_CODE=""
	printf "  ${DIM}%s 로 복구${NC}\n" "$_cur"

	case "$ans" in
	y | Y | yes)
		RESULTS="${RESULTS}0x${_code}\t${_label}\t${GREEN}실제로 먹는다${NC}${_note}\n" ;;
	*)
		RESULTS="${RESULTS}0x${_code}\t${_label}\t${RED}값만 받고 무시${NC}${_note}\n" ;;
	esac
}

# 결과표. `[ ... ] && printf` 로 쓰면 마지막 줄에서 테스트가 거짓일 때 루프의
# 종료 상태가 0 이 아니게 되고, `set -e` 가 그 자리에서 스크립트를 끝낸다 —
# 뒤에 붙은 안내문이 통째로 사라진다. if 로 쓰면 그 함정이 없다.
show_results() {
	printf '%b' "$RESULTS" | while IFS="$(printf '\t')" read -r c l r; do
		if [ -n "$c" ]; then printf "  %-6s %-16s %b\n" "$c" "$l" "$r"; fi
	done
}

# 질문 도중에 죽어도 걸어 둔 값을 되돌린다. 되돌릴 게 없으면 아무 일도 안 한다.
RESTORE_CODE=""
cleanup() {
	[ -n "$RESTORE_CODE" ] || return 0
	printf "\n${YELLOW}>>> 중단됨. 0x%s 를 %s 로 되돌린다.${NC}\n" "$RESTORE_CODE" "$RESTORE_VAL"
	ddc setvcp "$RESTORE_CODE" "$RESTORE_VAL" --bus "$RESTORE_BUS" --noverify >/dev/null 2>&1 || true
	RESTORE_CODE=""
}
trap cleanup EXIT INT TERM

# ── 인자 ──────────────────────────────────────────────────────────────────
NUM="${1:-}"
if [ -z "$NUM" ]; then
	printf "감지된 DDC 디스플레이:\n"
	show_displays
	printf "\n${DIM}시각 테스트: apps/ddc-probe <번호>${NC}\n"
	exit 0
fi

BUS="$(bus_for "$NUM")" || {
	printf "${RED}그런 번호의 디스플레이가 없다: %s${NC}\n" "$NUM"
	show_displays
	exit 1
}
shift

case "${1:-}" in
--dump)
	ddc getvcp ALL --bus "$BUS"
	exit 0
	;;
--caps)
	# "주장하는" 이라고 쓴 이유는 머리말에 있다. 여기 없는 코드가 답하기도 하고,
	# 여기 있는 코드가 화면에 반영되지 않기도 한다.
	ddc capabilities --bus "$BUS"
	exit 0
	;;
--feature)
	[ -n "${2:-}" ] || { printf "${RED}--feature 뒤에 VCP 코드가 필요하다 (예: 0A)${NC}\n"; exit 1; }
	probe_feature "$BUS" "$2" "직접 지정" "${3:-10}"
	printf "\n"
	show_results
	exit 0
	;;
"") ;;
*)
	printf "${RED}알 수 없는 옵션: %s${NC}\n" "$1"
	exit 1
	;;
esac

# ── 기본 테스트 ───────────────────────────────────────────────────────────
# 명암을 먼저 한다. 이것이 대조군이다 — 명암이 변하면 이 모니터가 DDC 쓰기를
# 화면에 반영하기는 한다는 뜻이므로, 뒤이어 밝기가 안 변할 때 "DDC 가 안 통한다"
# 와 "0x10 만 배선이 안 돼 있다" 를 가를 수 있다. 순서를 바꾸면 그 구분이 사라진다.
#
# 밝기는 두 번 본다. 15 에서 미묘했을 뿐인지, 0 에서도 꿈쩍 안 하는지는 다른
# 결론으로 이어진다.
printf "\n디스플레이 %s (i2c-%s) 를 시험한다.\n" "$NUM" "$BUS"
printf "${DIM}각 단계는 값을 걸어 둔 채 묻는다. 천천히 보고 답하면 된다.${NC}\n"

probe_feature "$BUS" 12 "명암(대조군)" 10
probe_feature "$BUS" 10 "밝기" 15
probe_feature "$BUS" 10 "밝기(0까지)" 0

printf "\n=== 결과 ===\n"
show_results

printf "\n${DIM}명암은 먹는데 밝기만 안 먹는다면, 다음에 볼 곳은 이 컴퓨터가 아니라
**모니터 OSD** 다. HDR·DCR·다이내믹 명암·에코 중 하나가 켜져 있으면 패널이 수동
밝기를 무시한다 — 40LGD5K 에서 HDR 이 Auto 였던 것이 정확히 그 경우였고, DDC 는
그동안 내내 정상이었다. 펌웨어를 의심하는 건 그 다음이다.${NC}\n"
