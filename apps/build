#!/bin/sh -e
#
# Build this machine's configuration WITHOUT activating it — a safe way to
# verify the flake evaluates and builds before `build-switch`.
#   macOS  -> darwinConfigurations.<arch>.system
#   NixOS  -> nixosConfigurations.<hostname>.config.system.build.toplevel
# Override the NixOS host with --host NAME.

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

host=""; passthru=""
while [ $# -gt 0 ]; do
  case "$1" in
    --host=*) host="${1#*=}"; shift ;;
    --host)   host="$2"; shift 2 ;;
    *)        passthru="$passthru $1"; shift ;;
  esac
done

export NIXPKGS_ALLOW_UNFREE=1

if [ "$(uname)" = "Darwin" ]; then
  arch="$(uname -m)"; [ "$arch" = "arm64" ] && arch="aarch64"
  attr=".#darwinConfigurations.${arch}-darwin.system"
else
  attr=".#nixosConfigurations.${host:-$(hostname)}.config.system.build.toplevel"
fi

printf "${YELLOW}Building %s...${NC}\n" "$attr"
nix --extra-experimental-features 'nix-command flakes' build "$attr" $passthru
unlink ./result 2>/dev/null || true
printf "${GREEN}Build OK (nothing activated).${NC}\n"
