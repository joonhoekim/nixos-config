;; Caps Lock 레이어 — Windows·macOS 공용. 정본은 modules/nixos/keyboard.nix 와 pointer/pointerd.py 다.
;; 배치·검증·설치: ./README.md, 수치와 OS 차이의 근거: docs/kanata.md

;; 오른쪽 Alt 는 잡지 않는다 — 한/영은 Windows 한국어 자판 배열이 E038 을 VK_HANGUL 로 번역한다.
;; 잡으면 `ralt kana` 는 왼쪽 Alt 가 나가고, 통과시키면 llhook.rs 가 "Clearing kanata states: RAlt" 를
;; 매번 찍는다(docs/kanata.md). macOS 의 오른쪽 ⌥ 는 평범한 ⌥ 다.
(defcfg
  process-unmapped-keys (all-except ralt)
)

(defsrc)

;; (movemouse-* 간격ms 거리). Windows 는 상대 이동이라 포인터 가속을 타서 저속이 수치보다 더 깎인다.
;; Windows 휠 120 = 한 칸(WHEEL_DELTA). macOS 는 거리를 줄 수로 쓴다(120 이면 120줄) — 근거: docs/kanata.md
(platform (win winiov2 wintercept)
  (defalias
    ms↑ (movemouse-up 10 7)
    ms← (movemouse-left 10 7)
    ms↓ (movemouse-down 10 7)
    ms→ (movemouse-right 10 7)
    wh↑ (mwheel-up 67 120)
    wh↓ (mwheel-down 67 120)
    wh← (mwheel-left 67 120)
    wh→ (mwheel-right 67 120)
    bol home
    eol end
    find C-f
    ;; base 레이어에서 이름만 같이 쓰려고 둔다.
    rmet rmet
    ;; F열은 키보드 펌웨어가 Fn 을 처리하므로 손대지 않는다.
    f1 f1  f2 f2  f3 f3  f4 f4  f5 f5  f6 f6
    f7 f7  f8 f8  f9 f9  f10 f10  f11 f11  f12 f12
  )
)

(platform (macos)
  (defalias
    ms↑ (movemouse-up 10 15)
    ms← (movemouse-left 10 15)
    ms↓ (movemouse-down 10 15)
    ms→ (movemouse-right 10 15)
    wh↑ (mwheel-up 67 3)
    wh↓ (mwheel-down 67 3)
    wh← (mwheel-left 67 3)
    wh→ (mwheel-right 67 3)
    bol M-left
    eol M-right
    find M-f
    ;; 한/영. 수식 없이 F18 하나만 나가야 단축키(AppleSymbolicHotKeys 61)가 걸린다.
    rmet f18

    ;; Karabiner 가상 키보드는 Apple 키보드가 아니라 Media Keys 변환을 못 받는다 — 없으면 F열이 늘 F1–F12.
    ;; 배치는 M4 MacBook Pro(Mac16,8) 키캡, F6(방해 금지)은 HID usage 가 없다. "표준 기능 키로 사용" 설정은 무시된다.
    f1 brdn  f2 brup  f3 mctl  f4 sls  f5 dtn  f6 f6
    f7 prev  f8 pp  f9 next  f10 mute  f11 vold  f12 volu
  )
)

(defalias
  ;; 배율은 이동마다 다시 계산되어(src/kanata/mod.rs handle_move_mouse) 움직이는 도중에도 걸린다.
  ;; 기본 레이어에 거는 건 Shift 를 Caps 보다 먼저 눌러도 저속이 걸려야 해서다.
  sl (multi lsft (movemouse-speed 14))
  sr (multi rsft (movemouse-speed 14))

  ;; Shift 가 눌려 있으면 가로 스크롤(Shift 도 앱에 전달된다).
  wq (fork @wh↑ @wh← (lsft rsft))
  we (fork @wh↓ @wh→ (lsft rsft))

  ;; 다른 키가 눌리는 순간 홀드로 확정돼 Caps+i 를 빨리 굴려도 i 가 안 샌다. 200ms 넘겨 혼자 떼면 아무 일도
  ;; 없다(keyd 의 overload 는 이때도 Caps Lock 을 토글한다).
  caps (tap-hold-press 200 200 caps (layer-while-held nav))

  ;; fn 도 그대로 전달해서 fn+←(Home) 같은 macOS fn 조합과 🌐 단축키가 남는다. Windows 에는 fn 이 안 온다.
  fn (multi fn (layer-while-held fkeys))
)

(deflayermap (base)
  caps @caps
  lsft @sl
  rsft @sr
  rmet @rmet
  fn @fn
  f1 @f1  f2 @f2  f3 @f3  f4 @f4  f5 @f5  f6 @f6
  f7 @f7  f8 @f8  f9 @f9  f10 @f10  f11 @f11  f12 @f12
)

(deflayermap (fkeys)
  f1 f1  f2 f2  f3 f3  f4 f4  f5 f5  f6 f6
  f7 f7  f8 f8  f9 f9  f10 f10  f11 f11  f12 f12
)

;; 매핑하지 않은 키는 투명이라 Caps 를 누른 채로도 제 글자가 나온다.
(deflayermap (nav)
  ;; Shift 가 붙어도 그대로 통과해서 선택 확장이 된다.
  i up
  j left
  k down
  l rght
  u @bol
  o @eol
  h pgup
  n pgdn
  p bspc
  m del
  y ins
  / @find

  w @ms↑
  a @ms←
  s @ms↓
  d @ms→
  q @wq
  e @we

  ;; 누르는 동안만 눌린다 — f 를 잡은 채 wasd 로 드래그.
  f mlft
  8 mlft
  r mrgt
  0 mrgt
  9 mmid
)
