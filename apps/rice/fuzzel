#!/bin/sh -e
# DMS 팔레트(~/.cache/DankMaterialShell/dms-colors.json)로 fuzzel 색을 dank-rice.ini 에 쓴다. --wait 는 갱신을 기다린다.
# DMS 의 matugen 템플릿 목록은 Common/Theme.qml 에 하드코딩돼 fuzzel 을 끼울 수 없어서 직접 쓴다.
# 전체 그림: docs/rice-tools.md

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; DIM='\033[2m'; NC='\033[0m'

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/DankMaterialShell"
palette="$cache/dms-colors.json"
ini="$cfg/fuzzel/fuzzel.ini"
gen="$cfg/fuzzel/dank-rice.ini"

# 창이 차지할 화면 높이의 비율. fuzzel 에는 % 단위가 없어서 줄 수로 환산해야 한다.
ratio="${RICE_FUZZEL_RATIO:-0.8}"

# matugen 이 비동기라 바로 읽으면 이전 팔레트가 나온다. 최대 8초 기다리고 안 바뀌면 지금 값으로 간다.
if [ "${1:-}" = "--wait" ]; then
  [ -f "$palette" ] && before="$(stat -c %Y "$palette" 2>/dev/null || echo 0)" || before=0
  i=0
  while [ "$i" -lt 16 ]; do
    now="$(stat -c %Y "$palette" 2>/dev/null || echo 0)"
    [ "$now" -gt "$before" ] && break
    sleep 0.5
    i=$((i + 1))
  done
fi

# include 는 절대 경로만 받고(그래서 시드에 못 넣는다) 기본 섹션 전용이라 맨 위에 넣는다.
# 파일 끝에 붙이면 "[colors].include: not a valid option" 으로 죽어 폴백 런처가 안 뜬다.
if [ -f "$ini" ] && ! grep -q "^include=$gen\$" "$ini"; then
  tmp="$(mktemp)"
  printf '# apps/rice/fuzzel 이 붙임. 기본 섹션이어야 해서 맨 위다.\ninclude=%s\n\n' "$gen" > "$tmp"
  cat "$ini" >> "$tmp"
  mv "$tmp" "$ini"
  printf "${DIM}  include 줄을 fuzzel.ini 맨 위에 추가했다${NC}\n"
fi

if [ ! -f "$palette" ]; then
  printf "${YELLOW}팔레트가 아직 없다(%s). dank-rice.ini 의 폴백 값을 그대로 쓴다.${NC}\n" "$palette"
  exit 0
fi

profile="$(cat "$cfg/rice/current" 2>/dev/null || echo "")"
pfile="$cfg/rice/profiles/$profile/dms.json"

opacity=1
radius=12
if [ -f "$pfile" ]; then
  opacity="$(jq -r '.settings.popupTransparency // 1' "$pfile")"
  radius="$(jq -r '.settings.cornerRadius // 12' "$pfile")"
fi

# 0.85 -> "d9". fuzzel 색은 # 없는 RRGGBBAA 라 알파를 직접 붙여야 한다.
alpha="$(awk -v o="$opacity" 'BEGIN { printf "%02x", int(o * 255 + 0.5) }')"

# fuzzel 은 높이 대신 lines 만 받아 역산한다: 높이 = 보더*2 + 세로여백*2 + 프롬프트줄 + 안쪽여백 + 줄수*줄높이.
# 논리 픽셀끼리라 스케일은 안 곱한다. 섹션까지 보는 건 `width` 가 [main] 에선 문자 수,
# [border] 에선 픽셀이라서다 — 이름만 보면 45 를 보더 두께로 쓴다.
read_ini() { # read_ini <section> <key> <default>
  awk -v sec="$1" -v key="$2" -v def="$3" '
    /^[[:space:]]*\[/ { cur = $0; gsub(/[][[:space:]]/, "", cur); next }
    {
      line = $0
      sub(/[#;].*/, "", line)
      if (match(line, "^[[:space:]]*" key "[[:space:]]*=")) {
        v = line
        sub("^[[:space:]]*" key "[[:space:]]*=[[:space:]]*", "", v)
        gsub(/[[:space:]]/, "", v)
        if (cur == sec && v ~ /^[0-9]+$/) found = v
      }
    }
    END { print (found != "" ? found : def) }
  ' "$ini" 2>/dev/null
}

screen_h="$(niri msg --json focused-output 2>/dev/null | jq -r '.logical.height // empty')"
lines=""
if [ -n "$screen_h" ]; then
  border="$(read_ini border width 2)"
  vpad="$(read_ini main vertical-pad 18)"
  ipad="$(read_ini main inner-pad 10)"
  lh="$(read_ini main line-height 24)"
  lines="$(awk -v h="$screen_h" -v r="$ratio" -v b="$border" -v v="$vpad" -v i="$ipad" -v l="$lh" \
    'BEGIN { n = int((h * r - 2*b - 2*v - l - i) / l); print (n < 3 ? 3 : n) }')"
fi

mode="$(dms ipc call theme getMode 2>/dev/null | tr -d '"' | tr -d '[:space:]')"
case "$mode" in light) mode=light ;; *) mode=dark ;; esac

# selection=primary_container, 강조=primary: M3 가 대비를 보장하는 짝이라 어떤 벽지에서도 읽힌다.
mkdir -p "$(dirname "$gen")"
jq -r --arg a "$alpha" --arg r "$radius" --arg m "$mode" --arg n "$lines" '
  .colors[$m] as $c
  | def hex(k): ($c[k] | ltrimstr("#"));
    "# 자동 생성 — apps/rice/fuzzel. 직접 고치지 말 것(다음 프로필 전환에 덮어쓴다).",
    "# 형태는 fuzzel.ini 에서, 화면에 맞춰 계산되는 값과 색만 여기서.",
    "",
    (if $n == "" then empty else "[main]", "lines=\($n)", "" end),
    "[border]",
    "radius=\($r)",
    "",
    "[colors]",
    "background=\(hex("surface_container"))\($a)",
    "text=\(hex("on_surface"))ff",
    "message=\(hex("on_surface_variant"))ff",
    "prompt=\(hex("primary"))ff",
    "placeholder=\(hex("outline"))ff",
    "input=\(hex("on_surface"))ff",
    "match=\(hex("primary"))ff",
    "selection=\(hex("primary_container"))ff",
    "selection-text=\(hex("on_primary_container"))ff",
    "selection-match=\(hex("primary"))ff",
    "counter=\(hex("outline"))ff",
    "border=\(hex("primary"))ff"
' "$palette" > "$gen"

printf "${GREEN}fuzzel${NC}     dank-rice.ini (%s, alpha %s, radius %s, lines %s)\n" "$mode" "$alpha" "$radius" "${lines:-그대로}"
