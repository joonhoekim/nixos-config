# 시드일 뿐이다. 고치는 자리는 ~/.config/ghostty/config, 레포로 되받기는 apps/rice/save.

# DMS/matugen 이 쓰는 팔레트. 없는 테마를 가리키면 config 가 통째로 무효라 레포가 폴백을 시드한다.
theme = dankcolors

# p10k 의 파워라인 글리프가 프롬프트 한 폰트에서 나오도록 Nerd Font.
font-family = JetBrainsMono Nerd Font

# 한글 폴백(여러 번 적으면 위에서부터 폴백 순서). 없으면 OS 가 아무 폰트나 집는다 — macOS 는 PCMyungjo.
# D2Coding 은 한글 폭이 라틴의 정확히 2 배라 열이 안 밀린다. 확인: `ghostty +show-face --string=한글`
font-family = D2CodingLigature Nerd Font

font-size = 22

window-padding-x = 20
window-padding-y = 20

background-opacity = 0.94

# apps/rice/term 이 ./rices/<name>.conf 를 복사하는 자리. `?` 는 없어도 넘어가고, 경로는 이 파일 기준이다.
# ghostty 는 config-file 을 담은 파일보다 나중에 읽으므로 위치와 무관하게 조각이 본체를 이긴다.
config-file = ?rice.conf
