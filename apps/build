#!/bin/sh -e
# Build this machine's configuration WITHOUT activating it (target: build-lib.sh, --host NAME).

. "$(dirname "$0")/build-lib.sh"

if [ "$(uname)" = "Darwin" ]; then
  attr=".#darwinConfigurations.${target}.system"
else
  attr=".#nixosConfigurations.${target}.config.system.build.toplevel"
fi

printf "${YELLOW}Building %s...${NC}\n" "$attr"
nix --extra-experimental-features 'nix-command flakes' build "$attr" $passthru
unlink ./result 2>/dev/null || true
printf "${GREEN}Build OK (nothing activated).${NC}\n"
