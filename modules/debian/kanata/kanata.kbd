;; Caps Lock 레이어 — Debian(태블릿 tb323fu, subline) 판. 레이어 본체는
;; modules/shared/kanata/nav.kbd 이고 여기는 이 기기에만 해당하는 것만 둔다.
;;
;;   오른쪽 Alt 한/영 — kanata 가 아니라 subline 의 xkb 옵션이 한다 (아래 defcfg)
;;
;; 시험 실행 (Ctrl+C 로 끝):
;;   kanata --cfg modules/debian/kanata/kanata.kbd
;;
;; 비상 탈출: 왼쪽 Ctrl + Space + Esc 를 함께 누르면 kanata 가 종료된다
;; (kanata 내장, 설정과 무관).

;; 오른쪽 Alt 는 RAlt 그대로 내보낸다. subline 의 keyboard.xkb_options 기본값
;; `korean:ralt_hangul` 이 그것을 Hangul 키심으로 바꾸고, subline 내장 한글이 그
;; 키심을 본다(subline crates/compositor/src/osk.rs). keyd 판처럼 KEY_HANGEUL(122)
;; 을 내보내면 안 된다: `us` 배열에는 <HNGL> 에 키심이 없어서(Hangul 은
;; /usr/share/X11/xkb/symbols/kr 에만 있다) 한/영이 조용히 아무 일도 안 한다.
(defcfg
  process-unmapped-keys yes

  ;; 자동 감지는 키 1–115 중 하나라도 있으면 키보드로 잡는다
  ;; (kanata src/oskbd/linux.rs has_keyboard_keys). 이 태블릿에서는 볼륨 키
  ;; (114/115)를 가진 아래 셋이 걸린다. 잡히면 EVIOCGRAB 이 장치째 가져가는데
  ;; kanata 는 키 이벤트만 다시 내보내므로, 이어폰 잭의 SW_HEADPHONE_INSERT 같은
  ;; 스위치 이벤트가 다른 소비자에게 조용히 사라진다. 전원 키는 키 116 뿐이라
  ;; 지금은 안 걸리지만 같은 이유로 막아 둔다. 이름은 /proc/bus/input/devices 의
  ;; N: 값.
  linux-dev-names-exclude (
    "pmic_pwrkey"
    "pmic_resin"
    "gpio-keys"
    "LENOVO-TB323FU Headset Jack"
  )
)

(deflayermap (base)
  caps @caps
  lsft @sl
  rsft @sr
)

;; 경로는 이 파일 기준. 없는 파일은 kanata 가 조용히 건너뛰지만, 그러면 defsrc 와
;; @caps 가 없어서 설정 오류로 뜨지 않는다.
(include ../../shared/kanata/nav.kbd)
