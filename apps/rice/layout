#!/bin/sh -e
# 하이프랜드 배치를 리로드 없이 갈아끼운다. 배치 하나 = ~/.config/hypr/layouts/<이름>.lua (값 + 그 레이아웃 전용 키).
# general.layout 만 바꾸면 레이아웃마다 다른 디스패처 키가 `Unknown layoutmsg` 로 조용히 죽어서 파일로 묶는다.
# 전체 그림(eval 세 단계, `@` 손잡이 규약, 로컬만 고침): docs/rice-tools.md

here="$(dirname "$0")"
. "$here/lib.sh"

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
layouts="${RICE_LAYOUTS:-$cfg/hypr/layouts}"

# 레포 경로. 스튜디오 안에서 불리므로 cwd 를 못 믿는다 — apps/rice/knobs 와 같다.
repo="${RICE_REPO:-$(git -C "$here" rev-parse --show-toplevel 2>/dev/null || echo "$HOME/nixos-config")}"
repo_layouts="$repo/modules/nixos/hyprland/rice/layouts"

rice_kind="배치"
rice_current_file="$cfg/rice/layout"
rice_list() {
	for f in "$layouts"/*.lua; do
		[ -f "$f" ] || continue
		f="${f##*/}"
		printf '%s\n' "${f%.lua}"
	done | sort
}

# 파일이 없으면 scrolling(hyprland.lua 「배치」절과 같은 기본값). lib.sh 의 "(unknown)" 은 여기선 틀린 답이다.
rice_current() {
	if [ -f "$rice_current_file" ]; then
		cat "$rice_current_file"
	else
		printf 'scrolling\n'
	fi
}

# 거는 것만 하이프랜드에서 된다. 읽기·값 고치기·다음 로그인용 선택은 세션 없이도 된다.
session=1
if ! command -v hyprctl >/dev/null 2>&1 || [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	session=0
fi

if [ ! -d "$layouts" ]; then
	printf "${RED}%s 가 없다. 한 번 rebuild 하면 시드된다 (apps/build-switch).${NC}\n" "$layouts" >&2
	exit 1
fi

file_of() { printf '%s/%s.lua\n' "$layouts" "$1"; }
repo_of() { printf '%s/%s.lua\n' "$repo_layouts" "$1"; }

need_name() { # need_name <이름> — 목록에 없으면 거절
	[ -f "$(file_of "$1")" ] || rice_reject "$1"
}

# ── 머리말 ────────────────────────────────────────────────────────────────
# 첫 주석 덩어리: 첫 줄 ` — ` 앞이 제목, 그 뒤부터 빈 주석 줄 전까지가 설명(스튜디오 목록에 뜬다).
head_of() { # head_of <파일> → "제목\t설명"
	awk '
		NR == 1 && /^--/ {
			t = $0; sub(/^--[[:space:]]?/, "", t)
			if (i = index(t, " — ")) { title = substr(t, 1, i - 1); doc = substr(t, i + length(" — ")) }
			else title = t
			next
		}
		/^--[[:space:]]*$/ { exit }
		/^--/ { l = $0; sub(/^--[[:space:]]?/, "", l); doc = (doc == "" ? l : doc " " l); next }
		{ exit }
		END { printf "%s\t%s\n", title, doc }
	' "$1"
}

# ── 손잡이 파서 ───────────────────────────────────────────────────────────
# `키 = 값, -- @…` 줄을 TSV 로. `all` 이면 표시 없는 값도 뽑는다(레포 사본에서 되돌릴 값).
#   구역 \t 이름 \t 값(불리언은 1/0) \t 최소 \t 최대 \t 눈금 \t 설명 \t 타입 \t 원문
parse() { # parse <파일> [all]
	[ -f "$1" ] || return 0
	awk -v all="${2:-}" '
		/^[[:space:]]*--[[:space:]]*──/ {
			g = $0
			sub(/^[[:space:]]*--[[:space:]]*──[[:space:]]*/, "", g)
			sub(/[[:space:]]*─.*$/, "", g)
			group = g; doc = ""; next
		}
		/^[[:space:]]*--/ {
			l = $0
			sub(/^[[:space:]]*--[[:space:]]?/, "", l)
			doc = (doc == "" ? l : doc " " l)
			next
		}
		{
			if (match($0, /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*(-?[0-9]+(\.[0-9]+)?|true|false)[[:space:]]*,?/)) {
				head = substr($0, RSTART, RLENGTH)
				tail = substr($0, RSTART + RLENGTH)
				name = head; sub(/^[[:space:]]*/, "", name); sub(/[[:space:]]*=.*$/, "", name)
				raw = head; sub(/^[^=]*=[[:space:]]*/, "", raw); sub(/[[:space:]]*,?$/, "", raw)

				ann = ""; rest = ""
				if (match(tail, /--[[:space:]]*@[^[:space:]]+/)) {
					ann = substr(tail, RSTART, RLENGTH)
					rest = substr(tail, RSTART + RLENGTH)
					sub(/^--[[:space:]]*@/, "", ann)
					gsub(/^[[:space:]]+|[[:space:]]+$/, "", rest)
					if (rest != "") doc = (doc == "" ? rest : doc " " rest)
				}

				if (ann != "" || all != "") {
					if (raw == "true" || raw == "false") {
						type = "bool"; val = (raw == "true" ? 1 : 0)
						mn = 0; mx = 1; step = 1
					} else {
						type = (raw ~ /\./ ? "float" : "int"); val = raw
						n = split(ann, ps, ":")
						step = (n > 1 ? ps[2] : "")
						split(ps[1], mm, /\.\./)
						mn = mm[1]; mx = mm[2]
						# 정수인데 눈금이 없으면 1. 범위의 1/100 은 0/1/2 같은 열거값에서 뜻이 없다.
						if (step == "" && type == "int") step = 1
					}
					printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
						group, name, val, mn, mx, step, doc, type, raw
				}
			}
			doc = ""
		}
	' "$1"
}

# 손잡이 JSON. 레포 값이 있으면 같이 넣고 dirty 를 매긴다 — Knobs 와 같은 기준이다.
knobs_json() { # knobs_json <이름>
	name="$1"
	reposnap="$(mktemp)"
	parse "$(repo_of "$name")" all | jq -Rs '
		[ split("\n")[] | select(length > 0) | split("\t") | { key: .[1], value: .[2] } ] | from_entries
	' >"$reposnap"

	parse "$(file_of "$name")" | jq -Rs --arg name "$name" --arg file "$(file_of "$name")" \
		--slurpfile repo "$reposnap" '
		[ split("\n")[] | select(length > 0) | split("\t")
		  | { group: .[0], name: .[1],
		      value: (.[2] | tonumber),
		      min:   (.[3] | tonumber),
		      max:   (.[4] | tonumber),
		      step:  (if .[5] == "" then (((.[4] | tonumber) - (.[3] | tonumber)) / 100 * 10000 | round) / 10000
		              else (.[5] | tonumber) end),
		      doc:   .[6],
		      type:  .[7],
		      repo:  ($repo[0][.[1]] // null | if . == null then null else tonumber end) } ]
		| map(. + { dirty: (.repo != null and (.repo - .value | fabs) > 1e-9) })
		| { target: $name, file: $file,
		    groups: (reduce .[] as $k ([];
		               if (length > 0 and (.[-1].label == $k.group))
		               then .[0:-1] + [ .[-1] + { knobs: (.[-1].knobs + [$k]) } ]
		               else . + [ { label: $k.group, knobs: [$k] } ] end)) }'
	rm -f "$reposnap"
}

# ── 거는 것 ───────────────────────────────────────────────────────────────
# 옛 파일을 bind 가 받아 적기만 하게 돌려 걸었던 키를 모아 unbind 하고, 새 파일은 "풀고 거는" bind 로 돌린다.
# 하이프랜드는 한 키에 걸린 바인드를 전부 실행해서 그냥 걸면 두 번 뛴다. 그래서 배치 파일은 몇 번 돌려도 같아야 한다.
# `hyprctl reload` 는 화면 셰이더까지 지워서 안 쓴다. 옛=새(--reload)면 자기 키를 풀고 다시 건다.
switch_lua() { # switch_lua <옛 파일> <새 파일>
	cat <<LUA
local B, C = hl.bind, hl.config
local old = {}
hl.bind = function(k) old[#old + 1] = k end
hl.config = function() end
pcall(dofile, '$1')
hl.bind, hl.config = B, C
for _, k in ipairs(old) do hl.unbind(k) end
hl.bind = function(k, ...) hl.unbind(k); return B(k, ...) end
local ok, err = pcall(dofile, '$2')
hl.bind = B
if not ok then error(err, 0) end
LUA
}

apply() { # apply <이름>
	name="$1"
	new="$(file_of "$name")"
	old="$(file_of "$(rice_current)")"

	if [ "$session" = 1 ]; then
		# 문법만 먼저(하이프랜드의 lua 로). 돌리다 깨지면 옛 키는 풀리고 새 키는 반만 걸린 채 남는다.
		if ! out="$(hyprctl eval "assert(loadfile('$new'))" 2>&1)"; then
			printf "${RED}%s 가 lua 로 안 읽힌다:${NC}\n  %s\n" "$new" "$out" >&2
			exit 1
		fi
	fi

	mkdir -p "$(dirname "$rice_current_file")"
	printf '%s\n' "$name" >"$rice_current_file"

	if [ "$session" = 0 ]; then
		printf "${GREEN}배치: %s${NC} ${DIM}(하이프랜드 세션이 아니다 — 다음 로그인부터)${NC}\n" "$name"
		return 0
	fi

	if ! out="$(hyprctl eval "$(switch_lua "$old" "$new")" 2>&1)"; then
		printf "${RED}배치를 못 걸었다: %s${NC}\n  %s\n" "$name" "$out" >&2
		exit 1
	fi
	printf "${GREEN}배치: %s${NC}\n" "$name"
}

# ── 값 쓰기 ───────────────────────────────────────────────────────────────
# 파일의 그 줄만 고치고 뒤의 쉼표·범위 주석은 둔다. 같은 키가 두 테이블에 있으면 첫 것만 고쳐진다.
# raw 면 글자 그대로 쓴다 — 레포의 0.10 을 0.1 로 바꾸면 값은 같은데 diff 만 남는다.
write_values() { # write_values <파일> [raw]   < "<키>\t<값>"
	live="$1"; raw="${2:-}"
	tmp="$(mktemp)"
	cp "$live" "$tmp"
	while IFS='	' read -r k v; do
		[ -n "$k" ] || continue
		awk -v k="$k" -v v="$v" -v raw="$raw" '
			BEGIN { done = 0 }
			!done && $0 ~ ("^[[:space:]]*" k "[[:space:]]*=[[:space:]]*(-?[0-9]+(\\.[0-9]+)?|true|false)([[:space:]]*,|[[:space:]]|$)") {
				pre = $0; sub(/=.*$/, "", pre); sub(/[[:space:]]*$/, "", pre)
				cur = $0; sub(/^[^=]*=[[:space:]]*/, "", cur)
				rest = cur
				match(cur, /^(-?[0-9]+(\.[0-9]+)?|true|false)/)
				lit = substr(cur, 1, RLENGTH)
				rest = substr(cur, RLENGTH + 1)

				if (raw != "")
					s = v
				else if (lit == "true" || lit == "false")
					s = (v + 0 ? "true" : "false")
				else if (lit ~ /\./) {
					s = sprintf("%.4f", v + 0)
					sub(/0+$/, "", s)
					if (s ~ /\.$/) s = s "0"
				} else
					s = sprintf("%d", v + 0)

				# 값이 이미 그것이면 줄을 그대로 둔다 — 헛 diff 를 안 남긴다.
				if (s == lit) { print; done = 1; next }
				print pre " = " s rest
				done = 1; next
			}
			{ print }
		' "$tmp" >"$tmp.new" && mv "$tmp.new" "$tmp"
	done
	cp "$tmp" "$live"
	rm -f "$tmp"
}

# 고친 배치가 지금 걸린 것이면 다시 돌린다. 아니면 다음에 고를 때 읽힌다.
reapply_if_current() { # reapply_if_current <이름>
	[ "$session" = 1 ] || return 0
	[ "$1" = "$(rice_current)" ] || return 0
	f="$(file_of "$1")"
	if ! out="$(hyprctl eval "$(switch_lua "$f" "$f")" 2>&1)"; then
		printf "${RED}%s 를 다시 못 돌렸다:${NC}\n  %s\n" "$f" "$out" >&2
		exit 1
	fi
}

# ── 명령 ──────────────────────────────────────────────────────────────────
case "${1:-}" in
--reload)
	cur="$(rice_current)"
	need_name "$cur"
	apply "$cur"
	exit 0
	;;

--file)
	name="${2:-$(rice_current)}"
	file_of "$name"
	exit 0
	;;

--json)
	cur="$(rice_current)"
	list="$(rice_list | while read -r n; do
		f="$(file_of "$n")"
		printf '%s\t%s\t%s\n' "$n" "$(head_of "$f")" "$([ -f "$(repo_of "$n")" ] && echo 1 || echo 0)"
	done)"
	knobs="$(mktemp)"
	if [ -f "$(file_of "$cur")" ]; then
		knobs_json "$cur" >"$knobs"
	else
		printf '{"groups":[]}\n' >"$knobs"
	fi
	jq -n --arg cur "$cur" --arg list "$list" --arg file "$(file_of "$cur")" \
		--argjson session "$session" --slurpfile k "$knobs" '
		{ current: $cur,
		  file: $file,
		  session: ($session == 1),
		  values: ( $list | split("\n") | map(select(length > 0) | split("\t")
		      | { name: .[0], title: .[1], doc: .[2], inRepo: (.[3] == "1"), current: (.[0] == $cur) } ) ),
		  groups: $k[0].groups }'
	rm -f "$knobs"
	exit 0
	;;

get)
	name="${2:-$(rice_current)}"
	need_name "$name"
	knobs_json "$name"
	exit 0
	;;

set)
	name="${2:?배치 이름이 필요하다}"
	key="${3:?값 이름이 필요하다}"
	val="${4:?값이 필요하다}"
	need_name "$name"
	row="$(parse "$(file_of "$name")" | awk -F'\t' -v k="$key" '$2 == k { print; exit }')"
	[ -n "$row" ] || { printf '%s 에 그런 손잡이는 없다: %s\n' "$name" "$key" >&2; exit 1; }
	# 범위를 벗어나면 자른다. 슬라이더는 넘길 일이 없지만 손으로 부를 때는 있다.
	val="$(printf '%s\n' "$row" | awk -F'\t' -v v="$val" '{
		x = v + 0; if (x < $4 + 0) x = $4 + 0; if (x > $5 + 0) x = $5 + 0; print x }')"
	printf '%s\t%s\n' "$key" "$val" | write_values "$(file_of "$name")"
	reapply_if_current "$name"
	exit 0
	;;

reset)
	name="${2:?배치 이름이 필요하다}"
	key="${3:-}"
	need_name "$name"
	pairs="$(parse "$(repo_of "$name")" all |
		awk -F'\t' -v k="$key" '(k == "" || $2 == k) { printf "%s\t%s\n", $2, $9 }')"
	[ -n "$pairs" ] || { printf '레포에서 되돌릴 값을 못 찾았다: %s\n' "$name" >&2; exit 1; }
	printf '%s\n' "$pairs" | write_values "$(file_of "$name")" raw
	reapply_if_current "$name"
	exit 0
	;;
esac

rice_dispatch "$@"
need_name "$RICE_NAME"
apply "$RICE_NAME"
