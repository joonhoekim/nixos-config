#!/bin/sh -e
#
# Snapshot the live niri / Hyprland / DankMaterialShell config back into the repo.
#
# These files are NOT managed by Nix (see modules/nixos/niri/default.nix): they
# are ordinary writable files so that niri can hot-reload on save and the DMS
# settings GUI can write its own state. This script is the other half of that
# arrangement — the repo copy is a backup and a seed for the next machine, and
# it only gets updated when you say so.
#
# Flow:  edit in ~/.config -> live-test -> apps/rice-save -> git diff -> commit
#
#   --check          validate + report what differs, write nothing (dry run)
#   --dms <profile>  DMS 설정 GUI 로 만진 룩을 그 프로필로 먼저 회수한다.
#                    나머지 축은 파일을 고치고 저장하면 그만이지만 DMS 만
#                    방향이 반대라(rice-switch 가 밀어 넣기만 한다) 이게 없으면
#                    프로필 JSON 을 손으로 고쳐야 한다. 자세한 건 아래 그 블록.
#   --force          --dms 를 켜 둔 프로필이 아닌 곳에 쓰도록 허용

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; NC='\033[0m'

# Find the repo from the *working directory*, not from $0: under
# `nix run .#rice-save` this script executes from a read-only store copy of the
# flake, so $0 points at /nix/store and writing there would fail. RICE_REPO
# overrides for the odd case of running from outside the checkout.
repo="${RICE_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
rice="$repo/modules/nixos/niri/rice"
# 터미널 라이싱은 두 플랫폼이 공유하므로 니리 밑이 아니라 shared 에 있다.
gt="$repo/modules/shared/ghostty"
# 하이프랜드 세션은 자기 모듈 밑에 자기 라이싱을 들고 있다.
hy="$repo/modules/nixos/hyprland/rice"
# DMS 플러그인은 두 세션이 같이 쓰므로 어느 컴포지터 밑도 아니다.
dm="$repo/modules/nixos/dms"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

if [ -z "$repo" ] || [ ! -d "$repo/modules/nixos/niri" ]; then
  printf "${RED}Run this from inside the nixos-config checkout, or set RICE_REPO.${NC}\n"
  exit 1
fi

check_only=0
dms_profile=""
dms_force=0
while [ $# -gt 0 ]; do
  case "$1" in
  --check) check_only=1 ;;
  --force) dms_force=1 ;;
  --dms)
    shift
    dms_profile="${1:-}"
    if [ -z "$dms_profile" ]; then
      printf "${RED}--dms 는 프로필 이름이 필요하다 (예: --dms amoled).${NC}\n"
      exit 1
    fi
    ;;
  *)
    printf "${RED}알 수 없는 옵션: %s${NC}\n" "$1"
    exit 1
    ;;
  esac
  shift
done

# niri only complains at load time, so a config that never gets reloaded can sit
# broken for days. Refuse to snapshot one — the repo copy is what a fresh
# machine boots into, and there is no hot-reload to save you there.
#
# Run it from the live config's own directory: `include` paths are relative to
# the config file, and dms/*.kdl only exists next to the live copy.
#
# niri 가 없는 머신(macOS)에서는 건너뛴다. 터미널 라이싱은 두 플랫폼이 같은
# 파일을 쓰므로 이 스크립트도 양쪽에서 돌아야 하고, 그쪽에는 검증할 대상 자체가
# 없다 — 아래 copy 들이 "skip (absent)" 로 알아서 비켜 간다.
if command -v niri >/dev/null 2>&1 && [ -f "$cfg/niri/config.kdl" ]; then
  printf "${YELLOW}Validating %s/niri/config.kdl...${NC}\n" "$cfg"
  if ! niri validate --config "$cfg/niri/config.kdl"; then
    printf "${RED}Live niri config is invalid — not snapshotting.${NC}\n"
    exit 1
  fi
fi

copy() { # copy <live> <repo-relative destination>
  src="$1"; dst="$2"
  if [ ! -e "$src" ]; then
    printf "${YELLOW}skip (absent): %s${NC}\n" "$src"
    return 0
  fi
  if [ "$check_only" -eq 1 ]; then
    diff -rq "$dst" "$src" >/dev/null 2>&1 \
      && printf "  unchanged  %s\n" "${dst#"$repo"/}" \
      || printf "  ${YELLOW}differs${NC}    %s\n" "${dst#"$repo"/}"
    return 0
  fi
  mkdir -p "$(dirname "$dst")"
  # -T so a directory source replaces the destination rather than nesting
  # inside it, and rm first so deleted themes don't linger in the repo.
  rm -rf "$dst"
  cp -rT "$src" "$dst"
  chmod -R u+w "$dst"
  printf "  saved      %s\n" "${dst#"$repo"/}"
}

# ── DMS: 라이브 → 프로필 (--dms) ──────────────────────────────────────────
# 다른 축은 전부 "$HOME 에서 고치고 여기서 되받는다" 인데 DMS 만 방향이 반대였다.
# rice-switch 는 프로필 → settings.json 으로 밀어 넣기만 하고 되받는 길이 없어서,
# 설정 GUI 로 찾아낸 값을 프로필에 넣으려면 JSON 을 손으로 고쳐야 했다.
#
# settings.json 을 통째로 뜨지 않는 이유는 아래 제외 목록과 같다 — 키가 500 개가
# 넘고 대부분이 룩과 무관한 머신 상태다. 그래서 *이미 프로필에 있는 키만* 라이브
# 값으로 새로 고친다. 키 집합이 안 변하므로 "프로필들이 같은 키 집합을 다룬다"는
# rice/profiles/README.md 의 규칙이 저절로 지켜지고, diff 에는 만진 값만 뜬다.
#
# 쓰는 곳은 레포가 아니라 라이브 프로필이다. rice-switch 가 읽는 게 그쪽이라
# 레포에만 넣으면 다음 전환이 방금 회수한 값을 도로 덮는다. 레포로는 아래
# `copy "$cfg/rice/profiles"` 가 평소대로 실어 나른다.
if [ -n "$dms_profile" ]; then
  prof="$cfg/rice/profiles/$dms_profile/dms.json"
  settings="$cfg/DankMaterialShell/settings.json"
  current="$(cat "$cfg/rice/current" 2>/dev/null || true)"

  if ! command -v jq >/dev/null 2>&1; then
    printf "${RED}--dms 는 jq 가 필요하다.${NC}\n"
    exit 1
  fi
  for f in "$prof" "$settings"; do
    [ -f "$f" ] && continue
    printf "${RED}없는 파일: %s${NC}\n" "$f"
    exit 1
  done

  # 켜 둔 프로필이 아닌 곳에 회수하면 화면에 떠 있지도 않은 룩이 그 프로필에
  # 박힌다. 되돌릴 방법이 diff 뿐이라 기본은 거절이다.
  if [ "$current" != "$dms_profile" ] && [ "$dms_force" -eq 0 ]; then
    printf "${RED}지금 켜 둔 프로필은 %s 인데 %s 로 회수하려 한다.${NC}\n" \
      "${current:-(unknown)}" "$dms_profile"
    printf "  화면에 없는 룩이 박힌다. 먼저 전환하거나(apps/rice-switch %s), 정말이면 --force.\n" \
      "$dms_profile"
    exit 1
  fi

  # 프로필에는 있는데 라이브에 없는 키. 오타이거나 DMS 가 이름을 바꾼 것이라
  # 영영 갱신되지 않는다 — 조용히 두면 프로필이 서서히 죽는다.
  jq -r --slurpfile live "$settings" '
    [ ((.settings // {}) | keys_unsorted[]) as $k
      | select(($live[0] | has($k)) | not) | $k ]
    + [ ((.bar // {}) | keys_unsorted[]) as $k
      | select((((($live[0].barConfigs // [])[0]) // {}) | has($k)) | not) | $k ]
    | .[]
  ' "$prof" | while read -r k; do
    printf "  ${YELLOW}stale${NC}      %s (라이브 settings.json 에 없는 키)\n" "$k"
  done

  tmpj="$(mktemp)"
  jq --slurpfile live "$settings" '
    # 이미 있는 키만 라이브 값으로 갈아끼운다. `//` 폴백이 아니라 has() 로 가르는
    # 이유는 false 다 — jq 에서 `false // x` 는 x 라, blurEnabled 처럼 꺼 둔 키가
    # 전부 옛 값으로 되돌아간다.
    def refresh($src): with_entries(
      . as $e | if ($src | has($e.key)) then .value = $src[$e.key] else . end
    );
    # bar 는 barConfigs 의 첫 항목에서 읽는다. rice-switch 가 모든 항목에 같은 것을
    # 밀어 넣으므로 어느 것을 봐도 같다.
    .settings |= refresh($live[0])
    | if has("bar") then .bar |= refresh((($live[0].barConfigs // [])[0]) // {}) else . end
  ' "$prof" >"$tmpj"

  if [ "$check_only" -eq 1 ]; then
    diff -q "$prof" "$tmpj" >/dev/null 2>&1 \
      && printf "  unchanged  %s\n" "profiles/$dms_profile/dms.json (라이브 대비)" \
      || printf "  ${YELLOW}differs${NC}    %s\n" "profiles/$dms_profile/dms.json (라이브 대비)"
    rm -f "$tmpj"
  else
    # 원자적 교체. rice-switch 가 settings.json 에 하는 것과 같은 이유다.
    mv "$tmpj" "$prof"
    printf "  pulled     %s\n" "~/.config/rice/profiles/$dms_profile/dms.json"
  fi
fi

copy "$cfg/niri/config.kdl"                   "$rice/config.kdl"
copy "$cfg/niri/animations.kdl"               "$rice/animations.kdl"
copy "$cfg/rice/profiles"                     "$rice/profiles"

# 하이프랜드. 니리와 같은 이유로 Nix 가 관리하지 않는다
# (modules/nixos/hyprland/default.nix 의 seed). hyprland.lua 는 저장하면 컴포지터가
# 바로 다시 읽고, shaders/ 는 apps/rice-crt 로 값을 고쳐 가며 맞추는 자리라 둘 다
# 라이브 쪽이 원본이다. 이 두 줄이 없던 동안 레포와 라이브가 조용히 갈라졌다.
#
# ~/.config/hypr/dms 는 뺐다. DMS 가 settings.json 에서 매번 새로 만들어 내는
# 파생물이라 저장해 봐야 다음 DMS 실행이 덮는 diff 소음만 남는다 — 아래에서
# ~/.config/niri/dms/*.kdl 를 뺀 것과 같은 이유다.
copy "$cfg/hypr/hyprland.lua"                 "$hy/hyprland.lua"
copy "$cfg/hypr/shaders"                      "$hy/shaders"

# DMS 런처 플러그인. 시드된 뒤로는 $HOME 쪽이 원본이라는 규칙이 여기도 그대로다 —
# QML 을 고치면 DMS 가 폴더를 감시하다 바로 다시 읽으므로, 고치는 자리가 곧 여기다.
# plugin_settings.json 은 안 가져온다: DMS 가 켜고 끈 상태를 쓰는 파일이라
# 레포에는 "riceSwitcher 를 켠다"는 시드 한 줄만 있으면 된다.
copy "$cfg/DankMaterialShell/plugins/RiceSwitcher" "$dm/plugins/RiceSwitcher"

copy "$cfg/ghostty/config"                    "$gt/config"
copy "$cfg/ghostty/rices"                     "$gt/rices"
copy "$cfg/ghostty/shaders"                   "$gt/shaders"
# fuzzel.ini 는 걸러서 옮긴다. 맨 위의 include 줄은 rice-fuzzel 이 이 머신의 절대
# 경로로 붙인 것이라 레포에 들어가면 안 되고(fuzzel 의 include 는 절대 경로만
# 받는다), 그 너머의 dank-rice.ini 는 파생물이라 아예 저장하지 않는다.
#
# 줄을 설명하는 주석까지 같이 지운다. 문구가 두 가지인데(니리 모듈이 시드하며 붙인
# 것과 rice-fuzzel 이 붙인 것) 둘 다 `# apps/rice-fuzzel` 로 시작한다.
#
# 거르는 자리가 여기인 것이 중요하다. 예전에는 복사한 *뒤에* 레포 파일을 sed -i 로
# 손봤는데, 그러면 --check 가 걸러지기 전의 라이브 파일을 레포와 비교해서 언제나
# "differs" 라고 답했다 — 실제로 저장하면 아무것도 안 바뀌는데도. 걸러진 것을
# 비교해야 --check 가 진실을 말한다. sed -i 를 안 쓰는 김에 macOS 의 BSD sed 문제도
# 같이 없어진다(그쪽은 -i 에 인자를 요구한다).
if [ -f "$cfg/fuzzel/fuzzel.ini" ]; then
  fz="$(mktemp)"
  sed -e '/^include=.*dank-rice\.ini$/d' \
      -e '/^# apps\/rice-fuzzel /d' "$cfg/fuzzel/fuzzel.ini" |
    sed '/./,$!d' >"$fz" # 삭제로 파일 앞에 남은 빈 줄 정리
  copy "$fz" "$rice/fuzzel.ini"
  rm -f "$fz"
else
  copy "$cfg/fuzzel/fuzzel.ini" "$rice/fuzzel.ini" # skip (absent) 를 위해
fi

# GTK. 이건 GNOME 용이 아니라 **니리 용**이다: 니리 세션에는 XSettings 를 방송하는
# 데몬이 없어서 GTK 앱이 이 파일을 직접 읽는다. GNOME 쪽 경로는 따로 있다
# (../modules/nixos/home-manager.nix 의 dconf 블록). 그래서 GNOME 을 걷어내도
# 이 파일은 남고, 오히려 유일한 경로가 된다.
#
# 되받을 값이 실제로 생기는 건 DMS 가 여기 쓰기 때문이다 — SettingsData.qml 의
# updateGtkIconTheme 이 gtk-icon-theme-name 을 sed 로 써 넣는다.
#
# 레포에는 파일이 하나뿐이라(gtk-settings.ini 를 두 디렉터리에 같이 시드한다)
# gtk-3.0 을 정본으로 삼는다. DMS 는 양쪽에 같은 값을 쓰지만, 어긋나면 알려 준다.
copy "$cfg/gtk-3.0/settings.ini"              "$rice/gtk-settings.ini"

if [ -f "$cfg/gtk-3.0/settings.ini" ] && [ -f "$cfg/gtk-4.0/settings.ini" ] &&
  ! diff -q "$cfg/gtk-3.0/settings.ini" "$cfg/gtk-4.0/settings.ini" >/dev/null 2>&1; then
  printf "  ${YELLOW}주의${NC}       gtk-3.0 과 gtk-4.0 의 settings.ini 가 다르다 — 레포에는 3.0 쪽만 들어간다\n"
fi

# 시드 파일의 머리말은 왜 home-manager 의 `gtk` 모듈이 아닌지를 설명하는, 실제로
# 한 번 데인 기록이다(galaxy-chromebook-1). 그런데 DMS 는 settings.ini 가 없으면
# 새로 만들어 내므로(SettingsData.qml:1605) 그 경우 라이브 파일에는 머리말이 없고,
# 위 copy 가 레포에서 그것을 지워 버린다. 덮기 전에 잡을 방법은 없으니 지워졌다는
# 것만 알린다 — git diff 에서 되살리면 된다.
if [ "$check_only" -eq 0 ] && [ -f "$rice/gtk-settings.ini" ] &&
  ! grep -q '^# ~/.config/gtk-3.0/settings.ini' "$rice/gtk-settings.ini"; then
  printf "  ${YELLOW}주의${NC}       gtk-settings.ini 의 머리말이 사라졌다 (DMS 가 파일을 새로 만든 듯) — git diff 에서 되살릴 것\n"
fi

# ~/.config/niri/profile.kdl 과 ~/.config/rice/current 는 일부러 뺐다. 둘 다
# rice-switch 가 프로필에서 만들어 낸 파생물이라, 저장하면 "지금 켜 둔 프로필"이
# 레포에 섞여 들어와 diff 가 지저분해진다. 프로필 내용을 고쳤다면 profiles/ 쪽을
# 고치고 rice-switch 를 다시 돌리는 게 맞다.
#
# ~/.config/ghostty/rice.conf 와 ~/.config/rice/term 도 같은 이유로 뺐다 —
# rice-term 이 rices/ 에서 복사해 낸 것이다. 터미널 룩을 고쳤다면 rices/ 쪽을
# 고치자. 위에서 그 디렉터리는 저장한다.
#
# DankMaterialShell/settings.json 전체도 뺐다. 키가 500 개 넘는 GUI 상태 덩어리라
# 저장할 때마다 룩과 무관한 키가 diff 에 섞이는데, 정작 룩은 profiles/*/dms.json 이
# 이미 갖고 있다. 새 머신은 DMS 가 쓴 기본값 위에 rice-switch 를 한 번 돌리면 된다.
# 거기서 되받고 싶은 건 그 프로필이 다루는 키들뿐이고, 그건 위의 --dms 가 한다.
# themes/ 도 같은 이유로 뺐다 — 레지스트리 테마는 파일로 복원해도 적용되지 않는다
# (rice/profiles/README.md 참고).

# ~/.config/niri/dms/*.kdl is regenerated by DMS from settings.json on every
# start, so it is derived state, not config — snapshotting it would only create
# diff noise that the next DMS launch overwrites anyway.

if [ "$check_only" -eq 1 ]; then
  printf "${GREEN}Check complete (nothing written).${NC}\n"
else
  printf "${GREEN}Snapshot complete. Review with: git -C %s diff${NC}\n" "$repo"
fi
