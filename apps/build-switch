#!/bin/sh -e
#
# Build and activate this machine's configuration.
#   macOS  -> darwin-rebuild switch --flake .#<hostname 또는 arch>, 이어서
#             apps/rift-grid --auto (창 관리자. nix 밖에서 빌드·서명한다)
#   NixOS  -> nixos-rebuild  switch --flake .#<hostname>
# 타겟은 build-lib.sh 가 고르고, 없는 이름이면 거기서 목록과 함께 멈춘다.
# --host NAME 으로 덮어쓴다 — 첫 switch 전(hostname 이 아직 'nixos')에 필요하다.
#
# Don't run the whole thing under sudo: it builds as your user and only the
# activation step escalates. Extra flags pass through, e.g. `-- --show-trace`.

# --host 파싱, NIXPKGS_ALLOW_UNFREE, $arch. build 와 같은 프롤로그다.
. "$(dirname "$0")/build-lib.sh"

if [ "$(uname)" = "Darwin" ]; then
  printf "${YELLOW}Building darwinConfigurations.%s...${NC}\n" "$target"
  nix --extra-experimental-features 'nix-command flakes' build ".#darwinConfigurations.${target}.system" $passthru
  printf "${YELLOW}Activating (sudo)...${NC}\n"
  # sudo required for activation — see nix-darwin#1457
  sudo ./result/sw/bin/darwin-rebuild switch --flake ".#${target}" $passthru
  unlink ./result 2>/dev/null || true
  # 창 관리자 rift-grid 는 nix 가 아니라 여기서 빌드·서명해 깐다(apps/rift-grid
  # 머리말). 소스가 그대로면 바로 끝난다. 실패해도 시스템 전환은 이미 끝났으니
  # 경고만 하고 넘어간다.
  "$(dirname "$0")/rift-grid" --auto \
    || printf "${YELLOW}rift-grid 를 깔지 못했다.${NC} nix run .#rift-grid 로 다시.\n"
else
  printf "${YELLOW}Building nixosConfigurations.%s...${NC}\n" "$target"
  # Forward the agent socket so root can fetch any private flake inputs.
  sudo SSH_AUTH_SOCK="$SSH_AUTH_SOCK" nixos-rebuild switch --flake ".#${target}" $passthru
fi

printf "${GREEN}Switch to new generation complete!${NC}\n"
