#!/bin/sh -e
#
# Snapshot the live ricing config back into the repo. The live files are the source
# of truth (not Nix-managed, see modules/nixos/niri/default.nix).
# 전체 그림(흐름·옵션·안 받는 것): docs/rice-scripts.md
#
# 라이브가 기준선(baseline.sh)과 같으면 레포가 앞선 것이라 되받지 않는다 — 안 그러면 레포에만
# 더한 변경(다른 머신의 커밋, 손으로 쓴 주석)이 되받기 한 번에 지워진다.

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

# $0 이 스토어 안이어도 형제 파일이 같이 들어 있어 이 경로가 맞는다.
. "$(dirname "$0")/baseline.sh"

# Find the repo from the working directory, not $0: under `nix run .#rice-save`
# $0 is a read-only store copy. RICE_REPO overrides.
repo="${RICE_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
rice="$repo/modules/nixos/niri/rice"
gt="$repo/modules/shared/ghostty"
hy="$repo/modules/nixos/hyprland/rice"
dm="$repo/modules/nixos/dms"
# 없는 플랫폼의 파일은 copy 가 "skip (absent)" 로 비켜 간다 — 양쪽에서 같은 명령으로 돈다.
dr="$repo/modules/darwin/rice"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

if [ -z "$repo" ] || [ ! -d "$repo/modules/nixos/niri" ]; then
  printf "${RED}Run this from inside the nixos-config checkout, or set RICE_REPO.${NC}\n"
  exit 1
fi

check_only=0
dms_profile=""
dms_force=0
while [ $# -gt 0 ]; do
  case "$1" in
  --check) check_only=1 ;;
  --force) dms_force=1 ;;
  --dms)
    shift
    dms_profile="${1:-}"
    if [ -z "$dms_profile" ]; then
      printf "${RED}--dms 는 프로필 이름이 필요하다 (예: --dms amoled).${NC}\n"
      exit 1
    fi
    ;;
  *)
    printf "${RED}알 수 없는 옵션: %s${NC}\n" "$1"
    exit 1
    ;;
  esac
  shift
done

# niri only complains at load time, and a fresh machine boots into the repo copy
# with no hot-reload to save it — refuse to snapshot a broken live config. Validate
# the live copy: `include` paths are relative and dms/*.kdl only exists next to it.
if command -v niri >/dev/null 2>&1 && [ -f "$cfg/niri/config.kdl" ]; then
  printf "${YELLOW}Validating %s/niri/config.kdl...${NC}\n" "$cfg"
  if ! niri validate --config "$cfg/niri/config.kdl"; then
    printf "${RED}Live niri config is invalid — not snapshotting.${NC}\n"
    exit 1
  fi
fi

# copy <live> <repo-relative destination> [기준선 키]
# 키는 기본이 <live> 다. 걸러 낸 임시 파일을 넘길 때만 진짜 라이브 경로를 준다(baseline.sh 의 거르개 문단).
copy() {
  src="$1"; dst="$2"; key="${3:-$1}"
  rel="${dst#"$repo"/}"

  if [ ! -e "$src" ]; then
    printf "${YELLOW}skip (absent): %s${NC}\n" "$src"
    return 0
  fi

  # 라이브가 기준선과 같으면 아무도 안 고친 것이다. 레포와 달라도 앞선 쪽은 레포라,
  # 되받으면 그 변경이 지워진다.
  if rice_baseline_has "$key" && rice_baseline_same "$key" "$src"; then
    if diff -rq "$dst" "$src" >/dev/null 2>&1; then
      printf "  unchanged  %s\n" "$rel"
    else
      printf "  ${YELLOW}레포가 앞섬${NC} %s ${DIM}(라이브는 손 안 댔다 — apps/rice/restore)${NC}\n" "$rel"
    fi
    return 0
  fi

  if [ "$check_only" -eq 1 ]; then
    diff -rq "$dst" "$src" >/dev/null 2>&1 \
      && printf "  unchanged  %s\n" "$rel" \
      || printf "  ${YELLOW}differs${NC}    %s\n" "$rel"
    return 0
  fi

  # 기준선이 없으면 위 보호 없이 되받으므로 알린다. 리빌드의 rice_sync 가 기준선을 먼저 잡아
  # 드물다(modules/shared/rice-seed-helpers.nix).
  rice_baseline_has "$key" \
    || printf "  ${DIM}기준선 없음${NC} %s\n" "$rel"

  mkdir -p "$(dirname "$dst")"
  # -T so a directory source replaces the destination rather than nesting
  # inside it, and rm first so deleted themes don't linger in the repo.
  rm -rf "$dst"
  cp -rT "$src" "$dst"
  chmod -R u+w "$dst"
  # 되받은 지점이 곧 새 기준선이다.
  rice_baseline_record "$key" "$src"
  printf "  saved      %s\n" "$rel"
}

# ── DMS: 라이브 → 프로필 (--dms) ──────────────────────────────────────────
# 프로필에 이미 있는 키만 라이브 값으로 고친다 — settings.json 은 500 키가 넘는 머신 상태다.
# 쓰는 곳은 라이브 프로필이다. rice-switch 가 그쪽을 읽어서 레포에만 넣으면 다음 전환이
# 도로 덮는다. 레포로는 아래 `copy "$cfg/rice/profiles"` 가 나른다.
if [ -n "$dms_profile" ]; then
  prof="$cfg/rice/profiles/$dms_profile/dms.json"
  settings="$cfg/DankMaterialShell/settings.json"
  current="$(cat "$cfg/rice/current" 2>/dev/null || true)"

  if ! command -v jq >/dev/null 2>&1; then
    printf "${RED}--dms 는 jq 가 필요하다.${NC}\n"
    exit 1
  fi
  for f in "$prof" "$settings"; do
    [ -f "$f" ] && continue
    printf "${RED}없는 파일: %s${NC}\n" "$f"
    exit 1
  done

  # 켜 둔 프로필이 아닌 곳에 회수하면 화면에 떠 있지도 않은 룩이 그 프로필에
  # 박힌다. 되돌릴 방법이 diff 뿐이라 기본은 거절이다.
  if [ "$current" != "$dms_profile" ] && [ "$dms_force" -eq 0 ]; then
    printf "${RED}지금 켜 둔 프로필은 %s 인데 %s 로 회수하려 한다.${NC}\n" \
      "${current:-(unknown)}" "$dms_profile"
    printf "  화면에 없는 룩이 박힌다. 먼저 전환하거나(apps/rice/switch %s), 정말이면 --force.\n" \
      "$dms_profile"
    exit 1
  fi

  # 프로필에는 있는데 라이브에 없는 키. 오타이거나 DMS 가 이름을 바꾼 것이라
  # 영영 갱신되지 않는다 — 조용히 두면 프로필이 서서히 죽는다.
  jq -r --slurpfile live "$settings" '
    [ ((.settings // {}) | keys_unsorted[]) as $k
      | select(($live[0] | has($k)) | not) | $k ]
    + [ ((.bar // {}) | keys_unsorted[]) as $k
      | select((((($live[0].barConfigs // [])[0]) // {}) | has($k)) | not) | $k ]
    | .[]
  ' "$prof" | while read -r k; do
    printf "  ${YELLOW}stale${NC}      %s (라이브 settings.json 에 없는 키)\n" "$k"
  done

  tmpj="$(mktemp)"
  jq --slurpfile live "$settings" '
    # 있는 키만 갈아끼운다. `//` 가 아니라 has() 인 이유는 false 다 — `false // x` 는 x 라
    # blurEnabled 처럼 꺼 둔 키가 옛 값으로 돌아간다.
    def refresh($src): with_entries(
      . as $e | if ($src | has($e.key)) then .value = $src[$e.key] else . end
    );
    # bar 는 barConfigs 의 첫 항목에서 읽는다 — rice-switch 가 모든 항목에 같은 것을 넣는다.
    .settings |= refresh($live[0])
    | if has("bar") then .bar |= refresh((($live[0].barConfigs // [])[0]) // {}) else . end
  ' "$prof" >"$tmpj"

  if [ "$check_only" -eq 1 ]; then
    diff -q "$prof" "$tmpj" >/dev/null 2>&1 \
      && printf "  unchanged  %s\n" "profiles/$dms_profile/dms.json (라이브 대비)" \
      || printf "  ${YELLOW}differs${NC}    %s\n" "profiles/$dms_profile/dms.json (라이브 대비)"
    rm -f "$tmpj"
  else
    # 원자적 교체. rice-switch 가 settings.json 에 하는 것과 같은 이유다.
    mv "$tmpj" "$prof"
    printf "  pulled     %s\n" "~/.config/rice/profiles/$dms_profile/dms.json"
  fi
fi

copy "$cfg/niri/config.kdl"                   "$rice/config.kdl"
copy "$cfg/niri/animations.kdl"               "$rice/animations.kdl"
copy "$cfg/rice/profiles"                     "$rice/profiles"

# 하이프랜드 쪽도 라이브가 원본이다(modules/nixos/hyprland/default.nix 의 seed).
# ~/.config/hypr/dms 는 DMS 가 settings.json 에서 매번 다시 만드는 파생물이라 안 받는다.
copy "$cfg/hypr/hyprland.lua"                 "$hy/hyprland.lua"
copy "$cfg/hypr/shaders"                      "$hy/shaders"
# ~/.config/rice/layout(지금 고른 이름)은 머신 상태라 안 받는다 — 레포의 기본은 늘 scrolling 이다.
copy "$cfg/hypr/layouts"                      "$hy/layouts"

# apps/rice/crt --save 가 쓰는 자리다. 이 줄이 없으면 저장한 체인이 그 머신에만 남는다.
copy "$cfg/hypr/chains"                       "$hy/chains"

copy "$cfg/rice-studio"                       "$hy/studio"

# 레포에 있는 플러그인 폴더만 훑는다. 이름을 박으면 새 플러그인의 QML 이 조용히 안 돌아오고,
# 라이브를 훑으면 DMS 에서 깐 남의 플러그인이 딸려 온다.
for p in "$dm"/plugins/*/; do
  [ -d "$p" ] || continue
  n="$(basename "$p")"
  copy "$cfg/DankMaterialShell/plugins/$n" "$dm/plugins/$n"
done

copy "$cfg/ghostty/config"                    "$gt/config"
copy "$cfg/ghostty/rices"                     "$gt/rices"
copy "$cfg/ghostty/shaders"                   "$gt/shaders"

# ── macOS 라이싱 ──────────────────────────────────────────────────────────
# rice_sync 는 손댄 설정을 안 따라가므로(그쪽은 rice-restore 몫) $HOME 에서 다듬은 것을 되받는 길은 여기뿐이다.
copy "$cfg/wezterm"                           "$dr/wezterm"
# rift-grid 의 키맵. 라이브가 원본이라 커밋 전에 이걸 안 돌리면 손본 바인딩이 레포에 안 들어간다.
# 테두리 색 두 줄도 이 파일에 있어서(apps/rice/colors 가 다시 쓴다) 그때 벽지 색이 새 기계의 첫 색이 된다.
copy "$cfg/rift-grid/config.toml"             "$dr/rift-grid/config.toml"
copy "$cfg/linearmouse/linearmouse.json"      "$dr/linearmouse/linearmouse.json"
# rift-grid 키바인딩이 부르는 헬퍼(monocle.sh 등).
copy "$cfg/rice/bin"                          "$dr/bin"
# fuzzel.ini 는 걸러서 옮긴다. include 줄은 rice-fuzzel 이 붙인 이 머신의 절대 경로이고(fuzzel 은
# 절대 경로만 받는다) 그 줄의 주석도 같이 지운다. 복사 뒤에 sed -i 로 고치면 --check 가 걸러지기
# 전 것을 비교해 늘 "differs" 라 답하고, BSD sed 의 -i 문제도 생긴다.
if [ -f "$cfg/fuzzel/fuzzel.ini" ]; then
  fz="$(mktemp)"
  sed -e '/^include=.*dank-rice\.ini$/d' \
      -e '/^# apps\/rice-fuzzel /d' "$cfg/fuzzel/fuzzel.ini" |
    sed '/./,$!d' >"$fz" # 삭제로 파일 앞에 남은 빈 줄 정리
  # $fz 는 매번 새 임시 파일이라 기준선 열쇠로는 진짜 라이브 경로를 준다.
  copy "$fz" "$rice/fuzzel.ini" "$cfg/fuzzel/fuzzel.ini"
  rm -f "$fz"
else
  copy "$cfg/fuzzel/fuzzel.ini" "$rice/fuzzel.ini" # skip (absent) 를 위해
fi

# GTK 는 니리 용이다 — 니리 세션에는 XSettings 데몬이 없어 GTK 앱이 이 파일을 직접 읽고,
# DMS 가 여기 쓴다(SettingsData.qml 의 updateGtkIconTheme). 레포에는 파일이 하나라 gtk-3.0 이 정본이다.
copy "$cfg/gtk-3.0/settings.ini"              "$rice/gtk-settings.ini"

if [ -f "$cfg/gtk-3.0/settings.ini" ] && [ -f "$cfg/gtk-4.0/settings.ini" ] &&
  ! diff -q "$cfg/gtk-3.0/settings.ini" "$cfg/gtk-4.0/settings.ini" >/dev/null 2>&1; then
  printf "  ${YELLOW}주의${NC}       gtk-3.0 과 gtk-4.0 의 settings.ini 가 다르다 — 레포에는 3.0 쪽만 들어간다\n"
fi

# DMS 는 settings.ini 가 없으면 새로 만들어서(SettingsData.qml:1605) 시드 머리말이 빠진 파일이
# 위 copy 로 레포를 덮을 수 있다. 덮기 전에 못 잡으니 알리기만 한다 — git diff 에서 되살린다.
if [ "$check_only" -eq 0 ] && [ -f "$rice/gtk-settings.ini" ] &&
  ! grep -q '^# ~/.config/gtk-3.0/settings.ini' "$rice/gtk-settings.ini"; then
  printf "  ${YELLOW}주의${NC}       gtk-settings.ini 의 머리말이 사라졌다 (DMS 가 파일을 새로 만든 듯) — git diff 에서 되살릴 것\n"
fi

# 안 받는 것: rice-switch·rice-term 이 만드는 파생물(niri/profile.kdl, rice/current, ghostty/rice.conf,
# rice/term), DankMaterialShell/settings.json 전체와 themes/. 이유: docs/rice-scripts.md
# ~/.config/niri/dms/*.kdl is regenerated by DMS on every start — derived state, not config.

if [ "$check_only" -eq 1 ]; then
  printf "${GREEN}Check complete (nothing written).${NC}\n"
else
  printf "${GREEN}Snapshot complete. Review with: git -C %s diff${NC}\n" "$repo"
fi
