		"클릭해야 포커스가 간다 — follow_mouse = 0."
	wfocus "$W_LOGS"
	beat 8
	wfocus "$W_EDITOR"
	beat 8
	wfocus "$W_LOGS"
	beat 6

	say "Super + =" "로그 컬럼을 넓힌다" \
