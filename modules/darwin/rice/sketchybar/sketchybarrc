#!/bin/sh
#
# sketchybar 설정. 이 파일은 "설정"이 아니라 sketchybar 가 실행하는 셸 스크립트다
# — 그래서 실행 비트가 필요하고, 문법 에러가 나면 바가 통째로 안 뜬다.
#
# ── 이 파일은 시드다 ──────────────────────────────────────────────────────
# 레포(modules/darwin/rice/sketchybar)에서 ~/.config/sketchybar 로 *없을 때만*
# 복사된다. 여기 있는 건 출발점이고, 첫 복사 뒤부터는 홈 쪽이 원본이다. 바는
# 값을 하나씩 밀어 보면서 만드는 물건이라 리빌드를 끼우고 싶지 않았다.
# 고친 뒤 반영은 `sketchybar --reload`.
#
# ── 색 ────────────────────────────────────────────────────────────────────
# ./colors.sh 가 pywal 팔레트를 읽어 온다. 여기서 색 리터럴을 쓰지 않는 이유가
# 그것이다 — 벽지를 바꾸면(apps/rice-colors) 바가 따라와야 한다.
#
# ── rift 연동 ─────────────────────────────────────────────────────────────
# 워크스페이스 표시는 rift 가 보내는 이벤트로 갱신된다. 이벤트 이름은
# modules/darwin/config/rift.toml 의 run_on_start 에 있는 --trigger 이름과
# 글자 그대로 같아야 한다. 둘을 묶어 주는 장치는 없다 — 표시가 안 바뀌면 거기서
# 이름이 어긋난 것이다.

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# shellcheck source=colors.sh
. "$CONFIG_DIR/colors.sh"

# ── 바 ────────────────────────────────────────────────────────────────────
# height 는 modules/darwin/config/rift.toml 의 gaps.outer.top 과 짝이다. 여기를
# 바꾸면 거기도 바꿔야 한다 — 안 그러면 창이 바 밑으로 들어가거나 위에 빈 띠가
# 남는다.
sketchybar --bar \
  height=32 \
  position=top \
  sticky=on \
  padding_left=8 \
  padding_right=8 \
  color="$BAR_COLOR" \
  border_width=0 \
  border_color="$BAR_BORDER" \
  shadow=off \
  topmost=off

# ── 아이템 공통 기본값 ────────────────────────────────────────────────────
sketchybar --default \
  updates=when_shown \
  icon.font="$FONT_ICON:Bold:14.0" \
  icon.color="$ICON_COLOR" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.font="$FONT_TEXT:Medium:13.0" \
  label.color="$LABEL_COLOR" \
  label.padding_left=0 \
  label.padding_right=8 \
  background.color="$ITEM_BG" \
  background.corner_radius=6 \
  background.height=24 \
  background.drawing=off

# ── rift 워크스페이스 ─────────────────────────────────────────────────────
sketchybar --add event rift_workspace_changed \
           --add event rift_windows_changed

# rift-cli 를 절대 경로로 부르는 이유: sketchybar 의 LaunchAgent PATH 는
# nix-darwin 이 만들어 준 것(services.sketchybar 의 package + extraPackages +
# environment.systemPath)이고 거기에 /opt/homebrew/bin 은 없다. rift 는 brew
# formula 라 그 아래 있다(modules/darwin/brews.nix).
RIFT_CLI="/opt/homebrew/bin/rift-cli"

# 칸 아홉 개. 여기서는 모양만 만들고, 어느 칸을 켤지는 아래 rift_spaces 아이템이
# 정한다 — 칸마다 script 를 달면 이벤트 한 번에 rift 를 아홉 번 조회하게 된다.
#
# 이름은 rift.toml 의 workspace_names 와 같다("1".."9"). 표시와 이벤트는 이름으로
# 오가지만 rift-cli 는 0-based 인덱스만 받아서, 클릭할 때만 1을 뺀다.
#
# drawing=off 로 시작한다. 첫 조회 전까지 아홉 칸이 통째로 떠 있다가 대부분
# 사라지는 깜빡임을 피한다.
for space in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "space.$space" left \
             --set "space.$space" \
                   label="$space" \
                   label.padding_left=8 \
                   icon.drawing=off \
                   drawing=off \
                   background.drawing=on \
                   background.color="$TRANSPARENT" \
                   label.color="$LABEL_COLOR" \
                   click_script="$RIFT_CLI execute workspace switch $((space - 1)) >/dev/null 2>&1"
done

# 안 보이는 아이템 하나가 위 아홉 칸을 전부 칠한다. 이벤트를 받는 것도, rift 에
# 물어보는 것도 여기 한 곳뿐이다. 자세한 건 plugins/rift_spaces.sh 머리말.
sketchybar --add item rift_spaces left \
           --set rift_spaces drawing=off \
                 script="$PLUGIN_DIR/rift_spaces.sh" \
           --subscribe rift_spaces rift_workspace_changed rift_windows_changed

sketchybar --add item space_sep left \
           --set space_sep icon="│" \
                 icon.color="$DIM_COLOR" \
                 label.drawing=off \
                 icon.padding_left=6 \
                 icon.padding_right=6

# ── 포커스된 앱 ───────────────────────────────────────────────────────────
sketchybar --add item front_app left \
           --set front_app \
                 icon.color="$ACCENT" \
                 label.color="$ACCENT_ALT" \
                 label.font="$FONT_TEXT:Bold:13.0" \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# ── 오른쪽 ────────────────────────────────────────────────────────────────
# 입력 소스(EN/한). sketchybar 에는 입력기 전환 이벤트가 없어서 짧게 폴링한다 —
# `defaults read` 한 번이라 비용은 무시할 만하다. 자세한 건 플러그인 머리말.
sketchybar --add item input_source right \
           --set input_source \
                 update_freq=2 \
                 background.drawing=on \
                 script="$PLUGIN_DIR/input_source.sh"

sketchybar --add item clock right \
           --set clock \
                 icon="󰃰" \
                 update_freq=15 \
                 background.drawing=on \
                 script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
           --set battery \
                 update_freq=60 \
                 background.drawing=on \
                 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

sketchybar --add item cpu right \
           --set cpu \
                 icon="󰘚" \
                 update_freq=10 \
                 background.drawing=on \
                 script="$PLUGIN_DIR/cpu.sh"

# ── 마무리 ────────────────────────────────────────────────────────────────
sketchybar --update

# 첫 그리기. rift 의 구독은 전환이 일어날 때만 이벤트를 보내므로, 여기서 한 번
# 직접 쏴 줘야 지금 상태가 반영된다. 값을 실어 보내지 않는 것에 주의 —
# rift_spaces 는 이벤트를 신호로만 쓰고 상태는 rift 에 직접 물어본다.
sketchybar --trigger rift_workspace_changed
