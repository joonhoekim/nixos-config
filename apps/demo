	act "hl.dsp.window.fullscreen({ mode = \"maximized\", action = \"toggle\" })"
	beat 14
	act "hl.dsp.window.fullscreen({ mode = \"maximized\", action = \"toggle\" })"
	beat 8

	# follow 하지 않는 이유는 rift-grid 쪽과 같다.
