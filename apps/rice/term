#!/bin/sh -e
# Switch the ghostty look, live.
# 룩 = rices/<name>.conf 를 rice.conf 로 복사. config 끝의 `config-file = ?rice.conf` 가 본체보다 나중에 읽혀 조각이 이긴다.
# 프로필(rice-switch)과는 다른 축이라 셰이더만 정한다. 전체 그림: docs/rice-tools.md

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

. "$(dirname "$0")/lib.sh"

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
gt="$cfg/ghostty"
rices="$gt/rices"
live="$gt/rice.conf"

rice_kind="룩"
rice_current_file="$cfg/rice/term"
# find -printf 은 GNU 확장이라 macOS 의 BSD find 에는 없어서 글롭으로 푼다.
rice_list() {
  for f in "$rices"/*.conf; do
    [ -f "$f" ] || continue
    f="${f##*/}"
    printf '%s\n' "${f%.conf}"
  done | sort
}

if [ ! -d "$rices" ]; then
  printf "${RED}%s 가 없다. 한 번 rebuild 하면 시드된다 (apps/build-switch).${NC}\n" "$rices"
  exit 1
fi

# 시드는 파일이 없을 때만 돌아서 기존 머신엔 이 배선이 없다. 없으면 아래가 전부 성공하고 화면만 안 바뀐다.
rice_ensure_line "$gt/config" "config-file = ?rice.conf" \
  "# apps/rice/term 이 갈아끼우는 룩 조각. 없어도 되도록 ? 를 붙인다."

rice_dispatch "$@"
name="$RICE_NAME"

src="$rices/$name.conf"
[ -f "$src" ] || rice_reject "$name"

# ghostty 는 없는 셰이더 경로를 조용히 버리고 +validate-config 도 통과시킨다(실측).
# 경로는 조각 기준 상대라 $gt 에서 푼다.
missing="$(sed -n 's/^[[:space:]]*custom-shader[[:space:]]*=[[:space:]]*\(..*[^[:space:]]\)[[:space:]]*$/\1/p' "$src" |
  while IFS= read -r p; do
    # 패턴 앞 여는 괄호가 필요하다: macOS /bin/sh(bash 3.2)는 $( ) 안 case 의 닫는 괄호를 치환의 끝으로
    # 착각해 자른다(syntax error near unexpected token newline).
    case "$p" in (/*) full="$p" ;; (*) full="$gt/$p" ;; esac
    [ -f "$full" ] || printf ' %s' "$p"
  done)"
if [ -n "$missing" ]; then
  printf "${RED}%s 가 없는 셰이더를 가리킨다:${NC}%s\n" "$name" "$missing"
  exit 1
fi

# 조각이 깨지면 ghostty 는 그 줄만 버려 반쯤 적용된 룩이 남는다. 되돌릴 자리를 잡아 둔다.
prev="$(mktemp)"
trap 'rm -f "$prev"' EXIT
had_live=0
[ -f "$live" ] && cp "$live" "$prev" && had_live=1
cp "$src" "$live"

# macOS 의 ghostty CLI 는 앱 번들 안에 있어 PATH 에 없다. 못 찾으면 command not found 가
# 검증 실패로 둔갑해 멀쩡한 조각을 되돌린다.
if command -v ghostty >/dev/null 2>&1; then
  ghostty_bin=ghostty
elif [ -x /Applications/Ghostty.app/Contents/MacOS/ghostty ]; then
  ghostty_bin=/Applications/Ghostty.app/Contents/MacOS/ghostty
else
  ghostty_bin=""
fi

if [ -z "$ghostty_bin" ]; then
  printf "${YELLOW}ghostty 를 못 찾아 검증은 건너뛴다.${NC}\n"
elif ! out="$("$ghostty_bin" +validate-config 2>&1)"; then
  printf "${RED}%s 를 넣으니 설정이 유효하지 않다. 되돌린다.${NC}\n" "$name"
  printf '%s\n' "$out" | sed 's/^/  /'
  [ "$had_live" -eq 1 ] && cp "$prev" "$live" || rm -f "$live"
  exit 1
fi

mkdir -p "$(dirname "$rice_current_file")"
printf '%s\n' "$name" > "$rice_current_file"
printf "  ghostty    %s\n" "rice.conf ← rices/$name.conf"

# custom-shader 는 reload-config(D-Bus)로 열린 창에 바로 걸린다. ghostty 가 안 떠 있으면 실패하는데 정상이다.
# macOS 에는 세션 버스가 없고 +action 에 리로드도 없어서 단축키로 안내한다.
if ! command -v gdbus >/dev/null 2>&1; then
  printf "${GREEN}터미널 룩 전환: %s${NC} ${DIM}(리로드 단축키를 누르면 반영된다)${NC}\n" "$name"
elif gdbus call --session --dest com.mitchellh.ghostty \
       --object-path /com/mitchellh/ghostty \
       --method org.gtk.Actions.Activate reload-config '[]' '{}' >/dev/null 2>&1; then
  printf "${GREEN}터미널 룩 전환: %s${NC}\n" "$name"
else
  printf "${GREEN}터미널 룩 전환: %s${NC} ${DIM}(열려 있는 ghostty 없음 — 다음 실행부터)${NC}\n" "$name"
fi

# macOS: background-opacity 는 리로드로 안 바뀌고 ghostty 를 다시 띄워야 한다(ghostty 문서).
[ "$(uname)" = "Darwin" ] && printf "${DIM}투명도까지 바꾸려면 ghostty 를 완전히 다시 띄워야 한다 (macOS 제약).${NC}\n"

# 셰이더 컴파일 실패는 설정 에러가 아니라 렌더 스레드 로그로만 나가고 창이 새까매질 수 있다(ghostty 문서).
[ "$name" = "off" ] || printf "${DIM}창이 새까매지면: apps/rice/term off${NC}\n"
