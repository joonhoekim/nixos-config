# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
#
# Windows CLI 도구. modules/shared/packages.nix 를 winget 으로 옮긴 것이다. 순서와
# 묶음도 그 파일을 따른다. ./cli.ps1 이 적용한다.
#
# 줄 맨 앞의 `#` 를 지우면 켜진다. winget 에 없는 것은 ./cli.ps1 의 Scoop·uv·npm
# 목록에 있고, Windows 에서 직접 돌지 않는 것은 맨 아래에 이유와 함께 적는다.
# ID 와 버전은 2026-10-03 에 `winget show --exact` 로 확인했다.
properties:
  configurationVersion: 0.2.0
  resources:
    # --- 모바일 (docs/packages/mobile.md) ------------------------------------
    # adb + fastboot. ./cli.ps1 이 환경 변수 ADB 를 이 adb 로 고정한다 — scrcpy 가
    # 자기 zip 에 든 다른 버전의 adb 를 띄우면 두 adb 서버가 서로를 죽이고 다시
    # 띄우면서 기기 연결이 수시로 끊긴다("adb server version doesn't match").
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: platform-tools, settings: { id: Google.PlatformTools, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: scrcpy, settings: { id: Genymobile.scrcpy, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: qrencode, settings: { id: PedroAlbanese.QREncode, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: watchman, settings: { id: facebook.watchman, source: winget } }

    # --- 일반 ---------------------------------------------------------------
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: bat, settings: { id: sharkdp.bat, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: btop, settings: { id: aristocratos.btop4win, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: coreutils, settings: { id: uutils.coreutils, source: winget } }
    # Windows 에는 OpenSSH 클라이언트가 기본으로 있다. 이것은 더 새 판이다.
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: openssh, settings: { id: Microsoft.OpenSSH.Preview, source: winget } }
    # wireguard-tools 대응. GUI 클라이언트지만 wg.exe 도 같이 깔린다.
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: wireguard, settings: { id: WireGuard.WireGuard, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: sqlite, settings: { id: SQLite.SQLite, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: wget, settings: { id: JernejSimoncic.Wget, source: winget } }
    # zip/unzip/p7zip/xz 대응
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: 7zip, settings: { id: 7zip.7zip, source: winget } }

    # --- 암호·보안 (docs/packages/security-hygiene.md) ------------------------
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: age, settings: { id: FiloSottile.age, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: gnupg, settings: { id: GnuPG.GnuPG, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: sops, settings: { id: SecretsOPerationS.SOPS, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: gitleaks, settings: { id: Gitleaks.Gitleaks, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: osv-scanner, settings: { id: Google.OSVScanner, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: lefthook, settings: { id: evilmartians.lefthook, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: trivy, settings: { id: AquaSecurity.Trivy, source: winget } }

    # --- 컨테이너 -------------------------------------------------------------
    # CLI 만이다. 컨테이너를 돌리는 데몬은 Windows 에서 결국 Linux VM 위에 있다
    # (Docker Desktop 은 WSL2, Podman 은 WSL2 나 Hyper-V). colima/lima 는 대응이 없다.
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: docker, settings: { id: Docker.DockerCLI, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: docker-compose, settings: { id: Docker.DockerCompose, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: lazydocker, settings: { id: JesseDuffield.Lazydocker, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: dive, settings: { id: wagoodman.dive, source: winget } }

    # --- 텍스트·터미널 --------------------------------------------------------
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: fd, settings: { id: sharkdp.fd, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: jq, settings: { id: jqlang.jq, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: gron, settings: { id: TomHudson.gron, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: jd, settings: { id: josephburnett.jd, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: ripgrep, settings: { id: BurntSushi.ripgrep.MSVC, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: yq, settings: { id: MikeFarah.yq, source: winget } }
    # tmux 대응. 0.45 부터 Windows 를 지원한다.
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: zellij, settings: { id: Zellij.Zellij, source: winget } }

    # --- 개발 도구 ------------------------------------------------------------
    # gh 는 이미 설치돼 있다 (configuration.winget 의 gh 항목).
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: terraform, settings: { id: Hashicorp.Terraform, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: awscli, settings: { id: Amazon.AWSCLI, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: lazygit, settings: { id: JesseDuffield.lazygit, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: fzf, settings: { id: junegunn.fzf, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: uv, settings: { id: astral-sh.uv, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: delta, settings: { id: dandavison.delta, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: poppler, settings: { id: oschwartz10612.Poppler, source: winget } }
    # MSVC 빌드 도구(rust·node-gyp 의 링커)는 워크로드 인자가 필요해 ./cli.ps1 에서 깐다.
    # 런타임 버전 관리. 버전 선언은 ./mise.toml
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: mise, settings: { id: jdx.mise, source: winget } }
    # 전역 python. shared 쪽은 분석 라이브러리를 얹은 nix 인터프리터다 — 여기서는
    # 라이브러리를 `uv` 프로젝트별로 둔다.
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: python, settings: { id: Python.Python.3.13, source: winget } }
    - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: cmake, settings: { id: Kitware.CMake, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: pkg-config, settings: { id: bloodrock.pkg-config-lite, source: winget } }

    # --- 현대식 CLI·TUI --------------------------------------------------------
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: difftastic, settings: { id: Wilfred.difftastic, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: neovim, settings: { id: Neovim.Neovim, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: yazi, settings: { id: sxyazi.yazi, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: tealdeer, settings: { id: dbrgn.tealdeer, source: winget } }
