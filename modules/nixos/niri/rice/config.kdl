// niri config — EDITED BY HAND, not generated.
//
// This file is the ricing scratchpad. The live copy at ~/.config/niri/config.kdl
// is a plain writable file: niri watches it and hot-reloads on save, and a
// broken edit only prints an error while the previous config keeps running.
// So iterate there, then run `apps/rice-save` to snapshot it back here.
//
// The repo copy is a seed + backup, never a source of truth. Nothing in Nix
// reads it except the activation script that copies it in when the file is
// *missing* (see ../default.nix) — an existing config is never overwritten.
//
// Originally generated from `wayland.windowManager.niri`, which is why the
// indentation is tabs and the nodes are alphabetical.

// 창 열림/닫힘을 브라운관 전원처럼 만드는 셰이더. 통째로 지우면 니리 기본
// 애니메이션으로 돌아간다 — optional 이라 없는 게 에러가 아니다. DMS 블록보다
// 위에 두는 건, DMS 가 자기 include 를 아래 헤더 밑에 이어 붙이기 때문이다.
include "animations.kdl" optional=true

// DMS Include Configs
// DMS writes these fragments itself and expects to be included from here;
// without the includes its theme never reaches niri's focus ring, borders or
// wallpaper backdrop. `optional=true` matters: a plain include of a missing
// file is a hard parse error, which would leave niri unstartable on a machine
// where DMS has not run yet.
//
// dms/layout.kdl is deliberately absent — it carries gaps/border widths that
// the `layout` block below already owns. Include it only after deleting those.
//
// DMS appends further includes under this exact header when a settings tab
// needs one, so keep the comment line verbatim.
include "profile.kdl" optional=true
include "dms/colors.kdl" optional=true
include "dms/cursor.kdl" optional=true
include "dms/windowrules.kdl" optional=true
include "dms/outputs.kdl" optional=true
include "dms/binds.kdl" optional=true
include "dms/alttab.kdl" optional=true
include "dms/wpblur.kdl" optional=true

debug {
	honor-xdg-activation-with-invalid-serial
}
// 세 티어가 전부다. 하이프랜드와 rift 도 같은 세 티어이고, macOS 만 Mod 가 Alt
// 다(Cmd 는 시스템이 가져간다). 전체 표는 docs/keymap.md.
//
//   Mod         간다, 연다
//   Mod+Shift   창을 데리고 간다
//   Mod+Ctrl    모니터를 넘는다, WM 에게 말한다
//
// 방향은 IJKL, 화살표와 같은 역T자다:
//
//         I                 ↑
//    J    K    L        ←   ↓   →
//
// 화살표는 어느 티어에서든 같은 동작에 같이 걸려 있다.
binds {
	// ── 티어 1 — Mod: 간다 ─────────────────────────────────────────────
	Mod+J { focus-column-left; }
	Mod+L { focus-column-right; }
	Mod+Left { focus-column-left; }
	Mod+Right { focus-column-right; }
	Mod+I { focus-window-up; }
	Mod+K { focus-window-down; }
	Mod+Up { focus-window-up; }
	Mod+Down { focus-window-down; }

	// 워크스페이스는 세로로 쌓인다. U 가 뒤로(위), O 가 앞으로(아래) — I 를
	// 위에서 감싸는 두 자리다. 예전엔 U/I 였는데 IJKL 이 I 를 가져갔다.
	Mod+U { focus-workspace-up; }
	Mod+O { focus-workspace-down; }
	// 직전 워크스페이스. rift 와 하이프랜드에는 걸어 뒀는데 여기만 비어 있다 —
	// `focus-workspace-previous` 가 니리 기본 설정에 없어서 이름이 맞는지
	// 확인하지 못했다. 니리는 모르는 액션을 만나면 설정 전체를 거부하고, 그건
	// 로그인이 안 된다는 뜻이라 추측으로 넣을 자리가 아니다. 리눅스에서:
	//
	//   niri msg action | grep workspace-previous
	//
	// 이름이 나오면 아래 줄의 주석을 풀고 `niri validate` 로 확인할 것.
	// Mod+Tab { focus-workspace-previous; }

	Mod+1 { focus-workspace 1; }
	Mod+2 { focus-workspace 2; }
	Mod+3 { focus-workspace 3; }
	Mod+4 { focus-workspace 4; }
	Mod+5 { focus-workspace 5; }
	Mod+6 { focus-workspace 6; }
	Mod+7 { focus-workspace 7; }
	Mod+8 { focus-workspace 8; }
	Mod+9 { focus-workspace 9; }

	Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "ghostty"; }
	// 셸이 안 뜬 상태에서도 뭔가를 열 수 있는 폴백 런처.
	Mod+D { spawn "fuzzel"; }
	// 오버뷰. 하이프랜드는 같은 키에서 DMS 오버뷰를, rift 는 macOS 미션
	// 컨트롤을 연다. 니리 기본값은 Mod+O 인데 그 자리는 여기서 워크스페이스
	// 앞으로 가기다 — 세 WM 을 맞추는 쪽을 골랐다. repeat=false 는 니리 기본
	// 설정을 따른 것으로, 누르고 있을 때 토글이 연달아 터지는 걸 막는다.
	Mod+E repeat=false { toggle-overview; }
	// 치트시트. H 는 IJKL 이 왼쪽을 J 로 가져가면서 빈 자리가 됐고, Help 로
	// 읽힌다. rift 에는 대응물이 없다 — 그쪽 치트시트는 docs/keymap.md 다.
	Mod+H { show-hotkey-overlay; }

	Mod+Q { close-window; }
	Mod+F { maximize-column; }
	Mod+C { center-column; }
	Mod+Equal { set-column-width "+10%"; }
	Mod+Minus { set-column-width "-10%"; }
	Mod+R { switch-preset-column-width; }

	// DMS
	Mod+Space { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
	Mod+V { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
	Mod+N { spawn "dms" "ipc" "call" "notifications" "toggle"; }
	Mod+S { spawn "dms" "ipc" "call" "control-center" "toggle"; }
	Mod+Escape { spawn "dms" "ipc" "call" "powermenu" "toggle"; }

	// ── 티어 2 — Mod+Shift: 창을 데리고 간다 ───────────────────────────
	Mod+Shift+J { move-column-left; }
	Mod+Shift+L { move-column-right; }
	Mod+Shift+Left { move-column-left; }
	Mod+Shift+Right { move-column-right; }
	Mod+Shift+I { move-window-up; }
	Mod+Shift+K { move-window-down; }
	Mod+Shift+Up { move-window-up; }
	Mod+Shift+Down { move-window-down; }

	Mod+Shift+U { move-column-to-workspace-up; }
	Mod+Shift+O { move-column-to-workspace-down; }

	Mod+Shift+1 { move-column-to-workspace 1; }
	Mod+Shift+2 { move-column-to-workspace 2; }
	Mod+Shift+3 { move-column-to-workspace 3; }
	Mod+Shift+4 { move-column-to-workspace 4; }
	Mod+Shift+5 { move-column-to-workspace 5; }
	Mod+Shift+6 { move-column-to-workspace 6; }
	Mod+Shift+7 { move-column-to-workspace 7; }
	Mod+Shift+8 { move-column-to-workspace 8; }
	Mod+Shift+9 { move-column-to-workspace 9; }

	Mod+Shift+F { fullscreen-window; }
	Mod+Shift+Space { toggle-window-floating; }

	// ── 티어 3 — Mod+Ctrl: 모니터를 넘는다 ─────────────────────────────
	Mod+Ctrl+J { move-column-to-monitor-left; }
	Mod+Ctrl+L { move-column-to-monitor-right; }
	Mod+Ctrl+I { move-column-to-monitor-up; }
	Mod+Ctrl+K { move-column-to-monitor-down; }
	Mod+Ctrl+Left { move-column-to-monitor-left; }
	Mod+Ctrl+Right { move-column-to-monitor-right; }
	Mod+Ctrl+Up { move-column-to-monitor-up; }
	Mod+Ctrl+Down { move-column-to-monitor-down; }

	// ── 티어 밖 — 리눅스 전용 ──────────────────────────────────────────
	// 방향키도 워크스페이스도 아니라 어느 티어와도 실제로 부딪히지 않는다.
	Print { screenshot; }
	Ctrl+Print { screenshot-screen; }
	Alt+Print { screenshot-window; }

	// 레포의 스크립트를 직접 부른다. niri 의 spawn 은 $HOME 을 확장하지 않아서
	// sh -c 를 한 겹 씌운다. 스크립트를 PATH 에 올리지 않는 건, 리싱 중에는
	// 스크립트 자체도 자주 고치게 되는데 그때마다 rebuild 하고 싶지 않아서다.
	Mod+Shift+P hotkey-overlay-title="Next rice profile" {
		spawn "sh" "-c" "$HOME/nixos-config/apps/rice-switch --next"
	}
	Mod+Shift+W hotkey-overlay-title="Random wallpaper" {
		spawn "sh" "-c" "$HOME/nixos-config/apps/rice-wall"
	}
	Mod+Ctrl+W hotkey-overlay-title="Pick wallpaper" {
		spawn "sh" "-c" "$HOME/nixos-config/apps/rice-wall --pick"
	}
	// yazi 는 터미널이 필요해서 스크립트가 ghostty 를 하나 띄운다.
	// 미리보기(kitty 그래픽 프로토콜)를 보면서 고를 때.
	Mod+Alt+W hotkey-overlay-title="Pick wallpaper (preview)" {
		spawn "sh" "-c" "$HOME/nixos-config/apps/rice-wall --yazi"
	}
	// 축마다 키를 하나씩 외우는 대신, DMS 런처를 RiceSwitcher 플러그인의
	// 트리거(":")를 미리 친 채로 연다. 프로필·터미널·월페이퍼가 한 목록에 있고
	// 지금 걸린 것에 ✓ 가 붙는다(화면 셰이더 축은 하이프랜드 세션에서만 뜬다).
	// 플러그인은 ../../dms/plugins/RiceSwitcher, 값은 apps/rice-menu 에서 온다.
	Mod+Shift+R hotkey-overlay-title="Rice menu" {
		spawn "dms" "ipc" "call" "spotlight" "toggleQuery" ":"
	}

	XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
	XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
	XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
	XF86AudioMicMute allow-when-locked=true { spawn "dms" "ipc" "call" "mic" "mute"; }
	XF86MonBrightnessUp allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5"; }
	XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5"; }

	// 버린 것:
	//   Mod+L         잠금. IJKL 이 오른쪽을 L 로 가져갔다. 잠금은 Mod+Escape 의
	//                 파워메뉴에 있고, 거기엔 되돌릴 기회까지 있다.
	//   Mod+Comma     DMS 설정 GUI. 런처에서 이름으로 부르면 된다.
	//   Mod+Shift+E   `quit`. Mod+E(오버뷰)와 Mod+Shift+F 사이에 끼어 있어서
	//                 오타 한 번이면 세션이 통째로 날아간다. 하이프랜드 쪽은
	//                 같은 이유로 이미 빼 뒀다. 로그아웃은 파워메뉴로.
	//   Mod+Home/End  focus-column-first/last. 하이프랜드에는 이 동작 자체가
	//                 없어서(docs/hyprland-binds.md) 세 곳을 맞추려면 여기만
	//                 남길 수 없었다.
}
input {
	// focus-follows-mouse 를 뺐다. 세 WM 모두 클릭해야 포커스가 가도록 맞췄다
	// (하이프랜드 `follow_mouse = 0`, rift `focus_follows_mouse = false`).
	//
	// 호버 포커스와 키보드 타일러는 누가 주도권을 갖는지에 대해 답이 다르다.
	// 포인터는 마지막으로 놓아둔 자리에 그대로 있으면서 포커스에 대한 권리를
	// 계속 주장한다 — 키보드로 옮겨 간 창에 타이핑을 시작하면 첫 타가 커서가
	// 얹혀 있던 엉뚱한 창으로 들어갈 수 있고, 배경 창 위에서 스크롤하면
	// 포커스를 통째로 빼앗긴다.
	keyboard {
		xkb {
			layout "us"
		}
	}
	// 휠 클릭 + 드래그 = 스크롤. 누르고 움직이지 않은 채 떼면 휠 클릭은 그대로
	// 나가지만 눌린 순간이 아니라 뗀 순간에 나가고, 미들 드래그(패닝)는 스크롤
	// 로 먹혀 사라진다. scroll-button-lock 은 클릭 한 번을 스크롤 모드 토글로
	// 바꿔 휠 클릭을 죽이므로 켜지 않는다.
	//
	// 하이프랜드 쪽은 같은 설정을 hl.device 로 장치를 짚어서 건다(전역이
	// 터치패드까지 끌고 가서). 니리는 mouse/touchpad 가 애초에 갈라져 있어
	// 그럴 필요가 없는 대신, 이 블록이 ../pointer 의 가상 포인터에도 걸린다 —
	// Caps+9 를 누른 채 wasd 로 젓는 것도 스크롤이 된다. 그 손은 q/e 로 이미
	// 휠을 갖고 있으니 잃는 건 키보드 마우스의 미들 드래그뿐이다.
	mouse {
		scroll-method "on-button-down"
		scroll-button 274
	}
	touchpad {
		dwt
		natural-scroll
		tap
	}
}
layout {
	border {
		width 2
	}
	default-column-width {
		proportion 0.500000
	}
	gaps 8
	preset-column-widths {
		proportion 0.333330
		proportion 0.500000
		proportion 0.666670
	}
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
include "dms/layout.kdl"
