    # 한국어 traineddata 는 설치 때 언어를 골라야 들어간다
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: tesseract, settings: { id: UB-Mannheim.TesseractOCR, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: rclone, settings: { id: Rclone.Rclone, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: croc, settings: { id: schollz.croc, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: speedtest, settings: { id: Ookla.Speedtest.CLI, source: winget } }
