// 손으로 고치는 파일. 살아있는 사본은 ~/.config/niri/config.kdl(핫 리로드)이고 이건 시드 겸 백업이다.
// 되받기는 `apps/rice/save`.

// optional 이라 지워도 에러가 아니다. DMS 가 아래 헤더 밑에 include 를 이어 붙이므로 그보다 위에 둔다.
include "animations.kdl" optional=true

// DMS Include Configs
// DMS 가 바로 위 헤더 줄 밑에 include 를 덧붙이므로 그 줄은 글자 그대로 둔다. optional 이 없으면 없는 파일이
// 파싱 에러라 DMS 가 돈 적 없는 머신에서 니리가 안 뜬다. dms/layout.kdl 은 아래 layout 블록과 겹쳐 뺐다.
include "profile.kdl" optional=true
include "dms/colors.kdl" optional=true
include "dms/cursor.kdl" optional=true
include "dms/windowrules.kdl" optional=true
include "dms/outputs.kdl" optional=true
include "dms/binds.kdl" optional=true
include "dms/alttab.kdl" optional=true
include "dms/wpblur.kdl" optional=true

debug {
	honor-xdg-activation-with-invalid-serial
}
// 세 티어(Mod 간다 / +Shift 데리고 간다 / +Ctrl 모니터·WM), 방향은 IJKL. 전체 표: docs/keymap.md
binds {
	// ── 티어 1 — Mod: 간다 ─────────────────────────────────────────────
	Mod+J { focus-column-left; }
	Mod+L { focus-column-right; }
	Mod+Left { focus-column-left; }
	Mod+Right { focus-column-right; }
	Mod+I { focus-window-up; }
	Mod+K { focus-window-down; }
	Mod+Up { focus-window-up; }
	Mod+Down { focus-window-down; }

	// 워크스페이스는 세로로 쌓인다. U 가 위, O 가 아래.
	Mod+U { focus-workspace-up; }
	Mod+O { focus-workspace-down; }
	// 모르는 액션은 설정 전체를 거부하므로 `niri msg action --help`·`niri validate` 로 확인했다(2026-08-06).
	Mod+Tab { focus-workspace-previous; }

	Mod+1 { focus-workspace 1; }
	Mod+2 { focus-workspace 2; }
	Mod+3 { focus-workspace 3; }
	Mod+4 { focus-workspace 4; }
	Mod+5 { focus-workspace 5; }
	Mod+6 { focus-workspace 6; }
	Mod+7 { focus-workspace 7; }
	Mod+8 { focus-workspace 8; }
	Mod+9 { focus-workspace 9; }

	Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "subline-terminal"; }
	// 셸이 안 뜬 상태에서도 뭔가를 열 수 있는 폴백 런처.
	Mod+D { spawn "fuzzel"; }
	// 니리 기본 Mod+O 대신 세 WM 에 맞춰 E. repeat=false 는 누르고 있을 때 토글이 연달아 터지는 걸 막는다.
	Mod+E repeat=false { toggle-overview; }
	Mod+H { show-hotkey-overlay; }

	Mod+Q { close-window; }
	Mod+F { maximize-column; }
	Mod+C { center-column; }
	Mod+Equal { set-column-width "+10%"; }
	Mod+Minus { set-column-width "-10%"; }
	Mod+R { switch-preset-column-width; }

	Mod+Space { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
	Mod+V { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
	Mod+N { spawn "dms" "ipc" "call" "notifications" "toggle"; }
	Mod+S { spawn "dms" "ipc" "call" "control-center" "toggle"; }
	Mod+Escape { spawn "dms" "ipc" "call" "powermenu" "toggle"; }

	// ── 티어 2 — Mod+Shift: 창을 데리고 간다 ───────────────────────────
	Mod+Shift+J { move-column-left; }
	Mod+Shift+L { move-column-right; }
	Mod+Shift+Left { move-column-left; }
	Mod+Shift+Right { move-column-right; }
	Mod+Shift+I { move-window-up; }
	Mod+Shift+K { move-window-down; }
	Mod+Shift+Up { move-window-up; }
	Mod+Shift+Down { move-window-down; }

	Mod+Shift+U { move-column-to-workspace-up; }
	Mod+Shift+O { move-column-to-workspace-down; }

	Mod+Shift+1 { move-column-to-workspace 1; }
	Mod+Shift+2 { move-column-to-workspace 2; }
	Mod+Shift+3 { move-column-to-workspace 3; }
	Mod+Shift+4 { move-column-to-workspace 4; }
	Mod+Shift+5 { move-column-to-workspace 5; }
	Mod+Shift+6 { move-column-to-workspace 6; }
	Mod+Shift+7 { move-column-to-workspace 7; }
	Mod+Shift+8 { move-column-to-workspace 8; }
	Mod+Shift+9 { move-column-to-workspace 9; }

	Mod+Shift+F { fullscreen-window; }
	Mod+Shift+Space { toggle-window-floating; }

	// ── 티어 3 — Mod+Ctrl: 모니터를 넘는다 ─────────────────────────────
	Mod+Ctrl+J { move-column-to-monitor-left; }
	Mod+Ctrl+L { move-column-to-monitor-right; }
	Mod+Ctrl+I { move-column-to-monitor-up; }
	Mod+Ctrl+K { move-column-to-monitor-down; }
	Mod+Ctrl+Left { move-column-to-monitor-left; }
	Mod+Ctrl+Right { move-column-to-monitor-right; }
	Mod+Ctrl+Up { move-column-to-monitor-up; }
	Mod+Ctrl+Down { move-column-to-monitor-down; }

	// -right 는 하이프랜드 consume 이 오른쪽에서만 끌어와서다. expel-window-from-column 은 포커스와 무관하게
	// 맨 아래 창을 뱉어서 이 자리가 아니다.
	Mod+Ctrl+E { consume-or-expel-window-right; }

	// ── 티어 밖 — 리눅스 전용 ──────────────────────────────────────────
	Print { screenshot; }
	Ctrl+Print { screenshot-screen; }
	Alt+Print { screenshot-window; }

	// spawn 은 $HOME 을 확장하지 않아 sh -c 를 씌운다. RICE_REPO 가 빗나가면 키가 조용히 아무 일도 안 한다
	// (apps/doctor 가 짚는다). 스크립트를 PATH 에 안 올리는 건 라이싱 중 고칠 때마다 rebuild 하지 않으려는 것이다.
	Mod+Shift+P hotkey-overlay-title="Next rice profile" {
		spawn "sh" "-c" "${RICE_REPO:-$HOME/nixos-config}/apps/rice/switch --next"
	}
	Mod+Shift+W hotkey-overlay-title="Random wallpaper" {
		spawn "sh" "-c" "${RICE_REPO:-$HOME/nixos-config}/apps/rice/wall"
	}
	Mod+Ctrl+W hotkey-overlay-title="Pick wallpaper" {
		spawn "sh" "-c" "${RICE_REPO:-$HOME/nixos-config}/apps/rice/wall --pick"
	}
	// yazi 는 터미널이 필요해 스크립트가 ghostty 를 띄운다.
	Mod+Alt+W hotkey-overlay-title="Pick wallpaper (preview)" {
		spawn "sh" "-c" "${RICE_REPO:-$HOME/nixos-config}/apps/rice/wall --yazi"
	}
	// RiceSwitcher 트리거(":")를 친 채 런처를 연다(../../dms/plugins/RiceSwitcher).
	Mod+Shift+R hotkey-overlay-title="Rice menu" {
		spawn "dms" "ipc" "call" "spotlight" "toggleQuery" ":"
	}

	XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
	XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
	XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
	XF86AudioMicMute allow-when-locked=true { spawn "dms" "ipc" "call" "mic" "mute"; }
	// 밝기는 인자가 둘(step, device)이다. 하나만 넘기면 DMS 가 "Too few arguments" 로 조용히 거절한다.
	XF86MonBrightnessUp allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
	XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }

	// Mod+Shift+E(quit)는 오타 한 번에 세션이 날아가는 자리라 두지 않는다. 로그아웃은 파워메뉴로.
}
input {
	// focus-follows-mouse 는 두지 않는다 — 세 WM 모두 클릭 포커스다(키보드로 옮긴 창 대신 커서 밑 창에 첫 타가 간다).
	keyboard {
		xkb {
			layout "us"
		}
	}
	// 휠 클릭 + 드래그 = 스크롤(미들 드래그는 사라진다). scroll-button-lock 은 휠 클릭을 죽여 켜지 않는다.
	// ../pointer 의 가상 포인터에도 걸린다.
	mouse {
		scroll-method "on-button-down"
		scroll-button 274
	}
	touchpad {
		dwt
		natural-scroll
		tap
	}
}
layout {
	border {
		width 2
	}
	default-column-width {
		proportion 0.500000
	}
	gaps 8
	preset-column-widths {
		proportion 0.333330
		proportion 0.500000
		proportion 0.666670
	}
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
include "dms/layout.kdl"
