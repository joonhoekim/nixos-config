#!/bin/sh -e
#
# rift-grid(rift 포크, 워크스페이스 3×3 격자)를 소스에서 빌드해 깐다. macOS 전용.
#
#   apps/rift-grid              빌드 → ~/.local/bin 에 깔기 → 서명 → rift-grid 다시 띄우기
#   apps/rift-grid --status     깔린 것과 소스의 커밋, 서명 요구사항
#   apps/rift-grid --auto       build-switch 가 매번 부르는 꼴. 아래 참고
#
# ~/.local/bin 의 rift-grid 를 hosts/darwin/common.nix 의 rift-grid 에이전트가 띄운다. 설치 자리를 바꾸면 그쪽도 바꾼다.
# 원본 rift(brew)는 rice/rift-grid/config.toml 의 grid_focus 같은 포크 전용 명령을 읽지 못한다.
#
# nix 가 아니라 여기서 빌드해 이 기계 신원으로 서명한다: 임의 서명이면 손쉬운 사용·화면 기록 허가가 재빌드마다 조용히 끊긴다.
# --auto 는 받아 온 소스가 지난번에 깐 커밋 그대로면 빌드도 재시작도 안 한다(변경이 있는 트리는 매번 빌드).
# 전체 그림: docs/03-operating-on-macos.md

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

if [ "$(uname -s)" != "Darwin" ]; then
  printf "${RED}macOS 전용이다.${NC}\n"
  exit 1
fi

SRC="${RIFT_GRID_SRC:-$HOME/git/compositor/rift-grid}"
REPO="https://github.com/joonhoekim/rift-grid.git"
BIN="$HOME/.local/bin"
# apps/mac-signing-cert 와 같은 이름을 쓴다. 신원을 따로 만들지 않는다.
CN="${MAC_SIGN_ID:-$(id -un) local codesign}"
AGENT="gui/$(id -u)/org.nixos.rift-grid"
# 마지막으로 깐 소스 커밋. --auto 가 "할 일 없음"을 가르는 기준이다.
STAMP="$BIN/.rift-grid.commit"
# mise 가 rustup 으로 까는 자리. build-switch 의 셸 PATH 에는 아직 없을 수 있다.
PATH="$PATH:$HOME/.cargo/bin"

auto=""
if [ "${1:-}" = "--auto" ]; then auto=1; fi

installed_commit() {
  "$BIN/rift-grid" --version 2>/dev/null | head -1
}

if [ "${1:-}" = "--status" ]; then
  if [ -x "$BIN/rift-grid" ]; then
    printf "깔린 것: ${GREEN}%s${NC}\n" "$(installed_commit)"
    codesign -d -r- "$BIN/rift-grid" 2>&1 | sed -n 's/^#* *designated => /  요구사항 /p'
  else
    printf "깔린 것: ${YELLOW}없다${NC} (%s)\n" "$BIN/rift-grid"
  fi
  if [ -d "$SRC/.git" ]; then
    printf "소스:     %s ${DIM}(%s)${NC}\n" \
      "$(git -C "$SRC" log -1 --format='%h %s')" "$SRC"
  else
    printf "소스:     ${YELLOW}없다${NC} (%s)\n" "$SRC"
  fi
  exit 0
fi

# rift-grid 의 `service install`(src/sys/service.rs)이 만든 에이전트가 있으면 org.nixos.rift-grid 와 둘 중 늦은 쪽이
# "Another Rift instance is already running" 으로 끝나고 KeepAlive.PathState 가 영원히 다시 띄운다(check/mac 에 runs = 수백).
# 소스가 그대로여도 생기는 상태라 --auto 의 "할 일 없음" 보다 먼저 본다.
ORPHAN="$HOME/Library/LaunchAgents/io.github.joonhoekim.rift-grid.plist"
if [ -e "$ORPHAN" ]; then
  launchctl bootout "gui/$(id -u)" "$ORPHAN" 2>/dev/null || true
  rm -f "$ORPHAN"
  printf "${YELLOW}rift-grid 가 스스로 깐 LaunchAgent 를 지웠다${NC} ${DIM}(%s)${NC}\n" "$ORPHAN"
  launchctl kickstart -k "$AGENT" 2>/dev/null || true
fi

if ! command -v cargo >/dev/null 2>&1; then
  if [ -n "$auto" ]; then
    printf "${YELLOW}rift-grid: cargo 가 없어 건너뛴다.${NC} rust 가 깔린 뒤 build-switch 를 한 번 더.\n"
    exit 0
  fi
  printf "${RED}cargo 가 없다.${NC} rust 툴체인을 먼저 깔아라.\n"
  exit 1
fi
if ! security find-certificate -c "$CN" >/dev/null 2>&1; then
  if [ -z "$auto" ]; then
    printf "${RED}서명 신원이 없다 (%s).${NC} 먼저 apps/mac-signing-cert 를 돌려라.\n" "$CN"
    exit 1
  fi
  printf "서명 신원이 없어서 만든다: %s\n" "$CN"
  MAC_SIGN_ID="$CN" "$(dirname "$0")/mac-signing-cert"
fi

if [ ! -d "$SRC/.git" ]; then
  printf "소스가 없어서 클론한다: %s\n" "$SRC"
  git clone --branch grid "$REPO" "$SRC"
elif [ -z "$(git -C "$SRC" status --porcelain)" ] \
  && [ "$(git -C "$SRC" branch --show-current)" = "grid" ]; then
  # 맥이 여러 대라 다른 기계에서 올린 커밋을 받아 온다. 고치는 중인 트리
  # (변경이 있거나 다른 브랜치)는 건드리지 않고 그대로 빌드한다.
  git -C "$SRC" pull --ff-only --quiet \
    || printf "${YELLOW}grid 를 받아 오지 못했다. 지금 있는 것으로 빌드한다.${NC}\n"
fi

dirty="$(git -C "$SRC" status --porcelain)"
head="$(git -C "$SRC" rev-parse HEAD)"
if [ -n "$auto" ] && [ -z "$dirty" ] && [ -x "$BIN/rift-grid" ] \
  && [ "$(cat "$STAMP" 2>/dev/null)" = "$head" ]; then
  printf "rift-grid: ${GREEN}최신${NC} ${DIM}(%s)${NC}\n" "$(git -C "$SRC" log -1 --format='%h %s')"
  exit 0
fi

printf "빌드: %s\n" "$(git -C "$SRC" log -1 --format='%h %s')"
cargo build --release --manifest-path "$SRC/Cargo.toml" --bin rift-grid --bin rift-grid-cli

mkdir -p "$BIN"
for name in rift-grid rift-grid-cli; do
  # 덮어쓰지 않고 옮겨 넣는다. 돌고 있는 rift-grid 의 실행 파일을 그 자리에서 고쳐
  # 쓰면 macOS 가 그 프로세스를 죽인다(코드 서명 페이지 검증).
  install -m 755 "$SRC/target/release/$name" "$BIN/.$name.new"
  codesign --force --sign "$CN" --identifier "io.github.joonhoekim.$name" \
    --timestamp=none "$BIN/.$name.new"
  mv -f "$BIN/.$name.new" "$BIN/$name"
done
if [ -z "$dirty" ]; then echo "$head" > "$STAMP"; else rm -f "$STAMP"; fi
printf "${GREEN}깔았다${NC} %s\n" "$(installed_commit)"
codesign -d -r- "$BIN/rift-grid" 2>&1 | sed -n 's/^#* *designated => /  요구사항 /p'

# 에이전트가 이미 올라와 있으면 새 바이너리로 다시 띄운다. 아직 없으면(첫
# build-switch 전에 손으로 부른 경우) 그냥 둔다 — build-switch 가 올린다.
if launchctl print "$AGENT" >/dev/null 2>&1; then
  launchctl kickstart -k "$AGENT"
  printf "rift-grid 를 다시 띄웠다.\n"
fi

printf "\n${DIM}처음 까는 기계라면 rift-grid 가 손쉬운 사용과 화면 및 시스템 오디오 녹음을 묻는다.\n"
printf "허용하고 rift-grid 를 다시 띄운다. 그 뒤로는 다시 빌드해도 그대로다.${NC}\n"
