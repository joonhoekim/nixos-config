#!/bin/sh -e
#
# Switch the Hyprland output shader, live.
#
# 전체 그림(체인 접기, damage_tracking·vfr 두 축, !motion): modules/nixos/hyprland/rice/README.md
# 쓰는 법과 세부: docs/rice-scripts.md

# 목록·순환·거절은 apps/rice/switch·term 과 같은 모양이라 lib.sh 에 있다. rice_current 는 아래에서 갈아치운다.
here="$(dirname "$0")"
. "$here/lib.sh"

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
shaders="${RICE_SHADERS:-$cfg/hypr/shaders}"
termshaders="${RICE_TERM_SHADERS:-$cfg/ghostty/shaders}"
chains="${RICE_CHAINS:-$cfg/hypr/chains}"
state="${RICE_STATE:-$cfg/rice/shader}"

rice_kind="화면 셰이더"

# 세션 없이 eval 하면 조용히 실패한다. 읽기(목록·탭 수·합성)는 세션 없이도 되므로
# 거는 자리에서만 거절한다(need_session).
session=1
if ! command -v hyprctl >/dev/null 2>&1 || [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	session=0
fi

need_session() {
	if [ "$session" = 1 ]; then
		return 0
	fi
	printf "${RED}하이프랜드 세션이 아니다 — 화면 셰이더는 여기서만 걸린다.${NC}\n"
	printf "${DIM}터미널 창 하나에만 거는 브라운관은 양쪽에서 된다: apps/rice/term crt${NC}\n"
	exit 1
}

if [ ! -d "$shaders" ]; then
	printf "${RED}%s 가 없다. 한 번 rebuild 하면 시드된다 (apps/build-switch).${NC}\n" "$shaders"
	exit 1
fi

# ── 목록 ──────────────────────────────────────────────────────────────────
# 목록 순서가 --next 순서다 — 로그인 직후인 off 에서 시작해, 손으로 고른 체인, 재료인 낱장 순.
rice_list() {
	printf 'off\n'

	for f in "$chains"/*.chain; do
		[ -f "$f" ] || continue
		f="${f##*/}"
		printf 'chain/%s\n' "${f%.chain}"
	done | sort

	for f in "$shaders"/*/*.frag "$shaders"/*/*.glsl; do
		[ -f "$f" ] || continue
		f="${f#"$shaders"/}"
		printf '%s\n' "${f%.*}"
	done | sort

	# 고스티 전용 유니폼을 읽는 것은 뺀다 — 목록에 뜨는데 누르면 거절당하면 목록이 거짓말을 한다.
	for f in "$termshaders"/*.glsl; do
		[ -f "$f" ] || continue
		grep -q 'iCurrentCursor\|iPreviousCursor\|iTimeCursorChange' "$f" && continue
		f="${f##*/}"
		printf 'term/%s\n' "${f%.glsl}"
	done | sort
}

# ── 이름 → 칸들 ───────────────────────────────────────────────────────────
stages_of() { # stages_of <이름>
	case "$1" in
	off) ;;
	chain/*)
		f="$chains/${1#chain/}.chain"
		# 없으면 빈 결과다. rice_reject 를 부르면 안 된다 — 늘 `$( )` 안에서 불려 exit 가 서브셸만
		# 끝내고 메시지만 두 번 나온다. 거절은 부르는 쪽이 한다.
		[ -f "$f" ] || return 0
		sed 's/#.*//' "$f" | tr -s '[:space:]' '\n' | grep -v '^$' | tr '\n' ' '
		;;
	*) printf '%s' "$1" ;;
	esac
}

# 칸들 → 이름. 저장된 체인과 같으면 그 이름으로 보여 준다 — 화면에서는 둘이 구별되지 않는다.
name_of() { # name_of <칸> <칸>...
	want="$*"
	for f in "$chains"/*.chain; do
		[ -f "$f" ] || continue
		have="$(sed 's/#.*//' "$f" | tr -s '[:space:]' '\n' | grep -v '^$' | tr '\n' ' ')"
		# 뒤에 붙은 공백 하나까지 맞춘다.
		[ "${have% }" = "$want" ] && {
			f="${f##*/}"
			printf 'chain/%s\n' "${f%.chain}"
			return
		}
	done
	printf '%s\n' "$want"
}

# ── 머리말 ────────────────────────────────────────────────────────────────
# 첫 글줄이 `still.frag — 잔잔한 수면.` 꼴이면 ` — ` 뒤가 설명이다(apps/rice/layout 의 head_of 와 같은 규약).
# 첫 글줄만 본다 — --save 가 적는 안내 줄에도 ` — ` 가 있다. 한 awk 가 getline 으로 모든 파일을
# 돈다 — --json 은 창을 열 때마다, 걸 때마다 불린다.
blurbs() {
	awk -F'\t' '
		{
			name = $1; f = $2; out = ""
			c = (f ~ /\.chain$/ ? "#" : "//")
			while ((getline l < f) > 0) {
				if (l ~ /^#version/) continue
				if (index(l, c) == 1) {
					body = substr(l, length(c) + 1)
					gsub(/^[[:space:]]+|[[:space:]]+$/, "", body)
					if (body == "") continue
					if (i = index(body, " — ")) out = substr(body, i + length(" — "))
					break
				}
				if (l ~ /[^[:space:]]/) break
			}
			close(f)
			printf "%s\t%s\n", name, out
		}'
}

# 이름 → 그 파일. 칸을 찾는 규칙은 apps/rice/chain 의 find_stage 가 쥐고 있지만,
# 설명을 읽는 데 칸마다 프로세스를 띄울 수는 없어서 여기서 같은 자리를 본다.
file_of() { # file_of <이름>
	case "$1" in
	chain/*) printf '%s/%s.chain\n' "$chains" "${1#chain/}" ;;
	term/*) printf '%s/%s.glsl\n' "$termshaders" "${1#term/}" ;;
	*)
		if [ -f "$shaders/$1.frag" ]; then
			printf '%s/%s.frag\n' "$shaders" "$1"
		else
			printf '%s/%s.glsl\n' "$shaders" "$1"
		fi
		;;
	esac
}

# ── 지금 걸린 것 ──────────────────────────────────────────────────────────
# 컴포지터에게 묻는다 — 상태 파일을 믿으면 hyprctl eval 로 직접 건 것과 어긋나 --next 가 엉뚱하게 뛴다.
# 안 건드린 세션은 `[[EMPTY]]`, 껐다 켠 뒤로는 빈 문자열이다. 둘 다 off.
rice_current() {
	# 세션이 없으면 걸린 화면 셰이더도 없다 — off 가 사실이다.
	if [ "$session" = 0 ]; then
		printf 'off\n'
		return 0
	fi
	cur="$(hyprctl getoption decoration:screen_shader 2>/dev/null |
		sed -n 's/^str:[[:space:]]*//p' | sed 's/[[:space:]]*$//')"
	case "$cur" in
	"" | "[[EMPTY]]")
		printf 'off\n'
		;;
	*)
		st="$("$here/chain" --stages "$cur" 2>/dev/null || true)"
		if [ -n "$st" ]; then
			# shellcheck disable=SC2086
			name_of $st
		else
			# 합성본이 아니다 — 손으로 걸어 뒀거나 캐시가 지워진 뒤 남은 경로다.
			# 그대로 보여 준다. 이걸 이름인 척하면 --next 가 엉뚱한 데로 뛴다.
			printf '%s\n' "$cur"
		fi
		;;
	esac
}

# ── 걸기 ──────────────────────────────────────────────────────────────────
# keyword 가 아니라 eval 이다 — 0.56 의 lua 파서는 "keyword can't work with non-legacy parsers. Use eval." 로 거절한다.
# 떼고 → 두 축을 맞추고 → 다시 건다. 뒤집히면 time 을 쓰는 셰이더가 트래킹이 켜진 채 올라와
# 하이프랜드가 경고 오버레이와 time 고정으로 갚는다. hyprland.lua 의 키바인드도 같은 순서다.
set_shader() { # set_shader <절대 경로 또는 빈 문자열>
	hyprctl eval "hl.config({ decoration = { screen_shader = \"$1\" } })" >/dev/null
}

apply() { # apply <칸>...
	need_session
	if [ $# -eq 0 ]; then
		src=""
		damage=2 # 하이프랜드 기본값(full)
		vfr=true
	else
		# 합성이 실패하면 여기서 끝난다. 앞의 것만 걸어 두면 브라운관 뒤에 오던
		# 망점이 조용히 빠진 화면이 되는데, 그건 안 바뀐 화면보다 알아채기 어렵다.
		src="$("$here/chain" "$@")" || exit 1
		damage=0 # 이웃을 읽는 셰이더는 부분 재합성과 같이 못 산다
		if [ "$("$here/chain" --motion "$@")" = yes ]; then
			vfr=false # 흐르는 것이 있다 — 데미지가 없어도 그려야 한다
		else
			vfr=true
		fi
	fi

	set_shader ""
	hyprctl eval "hl.config({ debug = { damage_tracking = $damage, vfr = $vfr } })" >/dev/null
	set_shader "$src"

	# 설정 리로드가 screen_shader 를 비우므로(DMS 가 프로필 전환마다 hypr/dms 조각을 다시 쓴다) --boot 이
	# 이걸 도로 건다. off 도 적는다 — 안 적으면 리로드가 일부러 꺼 둔 셰이더를 도로 켠다.
	mkdir -p "${state%/*}"
	if [ $# -eq 0 ]; then
		printf 'off\n' >"$state"
	else
		printf '%s\n' "$*" >"$state"
	fi
}

# ── 명령 ──────────────────────────────────────────────────────────────────
case "${1:-}" in
--boot)
	# 로그인과 설정 리로드가 부른다(hyprland.lua 의 exec_cmd). 리로드마다 불리므로 죽으면 안 된다 —
	# 상태의 칸이 퇴역했을 수 있어 --check 로 먼저 접어 보고, 안 되면 인자의 기본값, 그것도 안 되면 off.
	def="${2:-off}"
	want="$(cat "$state" 2>/dev/null || true)"
	if [ -n "$want" ] && [ "$want" != off ]; then
		# shellcheck disable=SC2086
		"$here/chain" --check $want >/dev/null 2>&1 || want=""
	fi
	if [ -z "$want" ]; then
		want="$(stages_of "$def")"
		if [ -n "$want" ] && [ "$want" != off ]; then
			# shellcheck disable=SC2086
			"$here/chain" --check $want >/dev/null 2>&1 || want=off
		else
			want=off
		fi
	fi
	if [ "$want" = off ]; then
		apply
		printf "${GREEN}화면 셰이더: off${NC} ${DIM}(--boot)${NC}\n"
	else
		# shellcheck disable=SC2086
		set -- $want
		apply "$@"
		printf "${GREEN}화면 셰이더: %s${NC} ${DIM}(--boot)${NC}\n" "$(name_of "$@")"
	fi
	exit 0
	;;
--reload | -r)
	# 손잡이를 고친 뒤 부르면 다시 접혀서 반영된다. 이름 하나를 받는 rice_dispatch 문법에 안 맞아 따로 둔다.
	name="$(rice_current)"
	if [ "$name" = off ]; then
		printf "${DIM}지금은 off 다 — 고친 값을 보려면 셰이더를 먼저 걸 것 (apps/rice/crt --next).${NC}\n"
		exit 0
	fi
	;;
--stages)
	# 손잡이 UI 가 "지금 걸린 체인의 칸들"을 알아야 해서 낸다(apps/rice/knobs).
	# --current 는 chain/이름 으로 접어서 주므로 거기서는 칸이 안 보인다.
	cur="$(rice_current)"
	[ "$cur" = off ] && exit 0
	for s in $(stages_of "$cur"); do printf '%s\n' "$s"; done
	exit 0
	;;
--json)
	# apps/rice/studio 가 창을 그리는 데 쓰는 것 전부를 프로세스 하나로 낸다. 곱 한도는 여기서
	# 안 센다 — chain --addable 의 답을 옮겨 담기만 해야 규칙이 한 벌이다.
	cur="$(rice_current)"
	st="$(stages_of "$cur")"
	list="$(rice_list)"
	# 낱장만 센다. off 는 값이 아니고, 저장된 체인은 한 장이 아니라 칸 목록이라
	# 탭 수가 이 자리의 뜻과 다르다.
	singles="$(printf '%s\n' "$list" | grep -v '^off$' | grep -v '^chain/' || true)"
	# shellcheck disable=SC2086
	meta="$("$here/chain" --info-all $singles 2>/dev/null || true)"
	# shellcheck disable=SC2086
	add="$(printf '%s\n' "$singles" | "$here/chain" --addable $st 2>/dev/null || true)"
	# 설명은 체인에도 있다. off 만 파일이 없다.
	blurb="$(printf '%s\n' "$list" | grep -v '^off$' | while IFS= read -r n; do
		printf '%s\t%s\n' "$n" "$(file_of "$n")"
	done | blurbs)"

	jq -n \
		--arg cur "$cur" \
		--arg list "$list" \
		--arg stages "$st" \
		--arg meta "$meta" \
		--arg add "$add" \
		--arg blurb "$blurb" \
		--argjson limit "$("$here/chain" --limit)" \
		--argjson session "$session" '
		def rows: split("\n") | map(select(length > 0) | split("\t"));
		( $meta | rows
		  | map({ key: .[0], value: { taps: (.[1] | tonumber), motion: (.[2] == "yes") } })
		  | from_entries ) as $m
		| ( $add | rows
		    | map({ key: .[0], value: (.[1] | tonumber) })
		    | from_entries ) as $a
		| ( $blurb | rows
		    | map({ key: .[0], value: (.[1] // "") })
		    | from_entries ) as $b
		| { current: $cur,
		    session: ($session == 1),
		    chain: ($stages | split(" ") | map(select(length > 0))),
		    maxTaps: $limit,
		    values: ( $list | split("\n") | map(select(length > 0)) | map(
		        . as $v
		        | { name: $v,
		            group: (if ($v | contains("/")) then ($v | split("/")[0]) else "" end),
		            leaf:  (if ($v | contains("/")) then ($v | split("/")[1:] | join("/")) else $v end),
		            kind:  (if $v == "off" then "off"
		                    elif ($v | startswith("chain/")) then "chain"
		                    else "stage" end),
		            current: ($v == $cur),
		            blurb: ($b[$v] // "") }
		        + ($m[$v] // {})
		        + (if $a[$v] then { addable: true, thenTaps: $a[$v] } else { addable: false } end)
		      )) }'
	exit 0
	;;
--save)
	label="${2:?이름이 필요하다  (예: apps/rice/crt --save my-look)}"
	case "$label" in
	*/* | .*) printf "${RED}이름에 / 나 앞점은 못 쓴다: %s${NC}\n" "$label" >&2; exit 1 ;;
	esac
	cur="$(rice_current)"
	[ "$cur" = off ] && {
		printf "${RED}지금은 off 다 — 저장할 체인이 없다.${NC}\n" >&2
		exit 1
	}
	mkdir -p "$chains"
	# 첫 줄은 이름만이다. 여기에 ` — ` 를 쓰면 그 뒤가 설명으로 읽혀서(blurbs)
	# 스튜디오 목록에 "--save 가 적었다" 같은 글이 설명 자리에 뜬다.
	{
		printf '# %s\n' "$label"
		printf '# apps/rice/crt --save 가 적었다. 위 이름 뒤에 ` — 설명` 을 붙이면 스튜디오 목록에 뜬다.\n'
		printf '# 한 줄에 한 칸, 위에서 아래 순서로 겹친다. 레포에 남기려면 apps/rice/save.\n'
		# shellcheck disable=SC2086
		for s in $(stages_of "$cur"); do printf '%s\n' "$s"; done
	} >"$chains/$label.chain"
	printf "${GREEN}chain/%s 로 저장했다${NC} ${DIM}(%s)${NC}\n" "$label" "$chains/$label.chain"
	exit 0
	;;
esac

if [ -z "${name:-}" ]; then
	if [ $# -gt 1 ]; then
		# 즉석 체인은 칸을 늘어놓은 것이라 이름 하나를 받는 rice_dispatch 를 안 거친다.
		name="$*"
	else
		rice_dispatch "$@"
		name="$RICE_NAME"
		# 이름 하나로 골랐으면 목록에 있어야 한다 — 안 막으면 오타가 chain 의 "그런 셰이더가 없다"
		# 한 줄로 끝나 무엇이 있는지 안 알려 준다.
		rice_list | grep -qxF "$name" || rice_reject "$name"
	fi
fi

if [ "$name" = off ]; then
	apply
	printf "  hyprland   %s\n" "screen_shader ← (없음)"
	printf "${GREEN}화면 셰이더: off${NC}\n"
	exit 0
fi

# shellcheck disable=SC2046,SC2086
set -- $(stages_of "$name")
[ $# -gt 0 ] || rice_reject "$name"

apply "$@"

printf "  hyprland   screen_shader ← %s\n" "$*"
if [ "$vfr" = false ]; then
	printf "${GREEN}화면 셰이더: %s${NC} ${YELLOW}(VFR 끔 — 놀 때도 주사율대로 계속 그린다)${NC}\n" "$(name_of "$@")"
else
	printf "${GREEN}화면 셰이더: %s${NC}\n" "$(name_of "$@")"
fi

# 화면을 못 알아보게 되어도 이 명령은 다른 tty 나 눈 감고 칠 수 있다.
printf "${DIM}화면이 이상해지면: apps/rice/crt off${NC}\n"
