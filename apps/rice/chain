#!/bin/sh -e
#
# 화면 셰이더 여러 장(칸)을 하이프랜드가 받는 한 장으로 접는다. 칸은 `갈래/이름`, `term/<이름>`, 절대 경로.
# 전체 그림: modules/nixos/hyprland/rice/README.md · 쓰는 법과 접는 방식: docs/rice-scripts.md

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/rice/shaders"
metacache="$cache/meta.tsv"
shaders="${RICE_SHADERS:-$cfg/hypr/shaders}"
termshaders="${RICE_TERM_SHADERS:-$cfg/ghostty/shaders}"

# crt/crt(23탭)·term/glow(1탭)에 한 겹 더 얹을 여유. crt→neon(483)은 여기서 걸린다.
max_taps="${RICE_CHAIN_MAX_TAPS:-64}"

RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

die() {
	printf "${RED}%s${NC}\n" "$1" >&2
	exit 1
}

# ── 칸 이름 → 파일 ────────────────────────────────────────────────────────
# 확장자로 규약이 갈리지 않는다(convention() 이 내용을 본다). 못 찾아도 죽지 않는 것은
# --info-all 때문이다 — 한 칸이 없다고 죽으면 GUI 목록이 통째로 빈다.
find_stage() { # find_stage <칸>  →  경로 (없으면 1)
	case "$1" in
	/*)
		if [ -f "$1" ]; then
			printf '%s\n' "$1"
			return 0
		fi
		return 1
		;;
	term/*)
		n="${1#term/}"
		for ext in .glsl .frag ''; do
			if [ -f "$termshaders/$n$ext" ]; then
				printf '%s\n' "$termshaders/$n$ext"
				return 0
			fi
		done
		return 1
		;;
	esac
	for ext in .frag .glsl ''; do
		if [ -f "$shaders/$1$ext" ]; then
			printf '%s\n' "$shaders/$1$ext"
			return 0
		fi
	done
	return 1
}

resolve() { # resolve <칸>
	if p="$(find_stage "$1")"; then
		printf '%s\n' "$p"
		return 0
	fi
	case "$1" in
	/*) die "그런 파일이 없다: $1" ;;
	term/*) die "그런 터미널 셰이더가 없다: $1  (${termshaders} 아래를 본다)" ;;
	esac
	die "그런 셰이더가 없다: $1  (${shaders} 아래를 본다)"
}

# 주석을 걷고 mainImage 를 본다 — 셰이더 머리말이 다른 규약을 자주 인용한다.
convention() { # convention <파일>  →  shadertoy | hyprland
	if sed 's|//.*||' "$1" | grep -q 'mainImage[[:space:]]*('; then
		printf 'shadertoy\n'
	else
		printf 'hyprland\n'
	fi
}

# ── 탭 세기 ───────────────────────────────────────────────────────────────
# 픽셀당 texture() 평가 횟수. 함수 단위로 세고 호출 횟수를 곱해 올린다 —
# 줄만 세면 루프를 품은 bloom() 을 두 번 부르는 경우를 놓친다.
# 루프 횟수를 못 읽으면 "?" 를 낸다. 1 로 치면 무거운 조합이 조용히 통과한다.
taps() { # taps <파일>
	awk '
		function trip(head,   a, b) {
			# for (int i = 0; i < BLOOM_TAPS; i++)  →  BLOOM_TAPS
			# for (int i = 2; i >= 0; i--)          →  3
			if (match(head, /=[[:space:]]*-?[0-9]+[[:space:]]*;/)) {
				a = substr(head, RSTART + 1, RLENGTH - 2) + 0
			} else return -1
			if (match(head, /<[[:space:]]*[A-Za-z0-9_]+/)) {
				b = substr(head, RSTART + 1, RLENGTH - 1)
				gsub(/[[:space:]]/, "", b)
				if (b in def) b = def[b]
				if (b !~ /^-?[0-9]+$/) return -1
				return (b + 0) - a
			}
			if (match(head, />=[[:space:]]*-?[0-9]+/)) {
				b = substr(head, RSTART + 2, RLENGTH - 2) + 0
				return a - b + 1
			}
			return -1
		}

		# 주석을 먼저 걷는다 — 셰이더 주석이 코드를 자주 인용해서 없는 탭을 센다.
		{
			line = $0
			if (inblock) {
				if (match(line, /\*\//)) { line = substr(line, RSTART + 2); inblock = 0 }
				else next
			}
			if (match(line, /\/\*/)) {
				rest = substr(line, RSTART)
				line = substr(line, 1, RSTART - 1)
				if (!match(rest, /\*\//)) inblock = 1
			}
			sub(/\/\/.*$/, "", line)
			src[++n] = line
			if (line ~ /^[[:space:]]*#define[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]+-?[0-9]+[[:space:]]*$/) {
				split(line, p, /[[:space:]]+/)
				def[p[2]] = p[3]
			}
			# 함수 이름을 미리 다 모아 둔다. 호출을 세려면 목록이 먼저 있어야 한다.
			if (line ~ /^[A-Za-z_][A-Za-z0-9_]*[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(/) {
				h = line
				sub(/^[A-Za-z_][A-Za-z0-9_]*[[:space:]]+/, "", h)
				sub(/[[:space:]]*\(.*$/, "", h)
				if (h != "") isfn[h] = 1
			}
			next
		}

		END {
			fn = ""; depth = 0; nloop = 0; mul = 1
			for (i = 1; i <= n; i++) {
				line = src[i]

				if (depth == 0 && line ~ /^[A-Za-z_][A-Za-z0-9_]*[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(/) {
					fn = line
					sub(/^[A-Za-z_][A-Za-z0-9_]*[[:space:]]+/, "", fn)
					sub(/[[:space:]]*\(.*$/, "", fn)
				}

				if (fn != "" && line ~ /for[[:space:]]*\(/) {
					t = trip(line)
					if (t < 0) { print "?"; exit }
					nloop++; loopat[nloop] = depth; loopn[nloop] = t
					mul *= t
				}

				if (fn != "") {
					# 샘플러 이름은 안 본다(tex / iChannel0). 하이프랜드가 주는 샘플러가 화면뿐이라
					# texture( 는 전부 화면 읽기다. textureLod( 는 안 센다.
					c = gsub(/texture[[:space:]]*\(/, "&", line)
					if (c > 0) own[fn] += c * mul
					tmp = line
					while (match(tmp, /[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(/)) {
						g = substr(tmp, RSTART, RLENGTH)
						sub(/[[:space:]]*\($/, "", g)
						tmp = substr(tmp, RSTART + RLENGTH)
						if (g in isfn && g != fn) calls[fn, g] += mul
					}
				}

				depth += gsub(/{/, "&", line) - gsub(/}/, "&", line)
				while (nloop > 0 && depth <= loopat[nloop]) { mul /= loopn[nloop]; nloop-- }
				if (depth <= 0) { depth = 0; fn = ""; nloop = 0; mul = 1 }
			}

			# 호출을 펴서 올린다. 재귀가 없으니 함수 수만큼 돌면 반드시 굳는다.
			for (f in isfn) total[f] = own[f]
			for (round = 0; round < 64; round++) {
				changed = 0
				for (f in isfn) {
					v = own[f]
					for (g in isfn)
						if ((f SUBSEP g) in calls) v += calls[f, g] * total[g]
					if (v != total[f]) { total[f] = v; changed = 1 }
				}
				if (!changed) break
			}
			print (("main" in total) ? total["main"] : 0)
		}
	' "$1"
}

# ── 흐르는가 ──────────────────────────────────────────────────────────────
# 시간을 읽고, `!motion` 손잡이가 있으면 그중 하나라도 0 이 아닐 때 흐른다(debug:vfr 판정).
# 체인은 한 칸이라도 흐르면 흐른다. 주석을 먼저 걷는다 — 머리말의 `time` 언급 때문에
# 정지 셰이더가 흐르는 것으로 읽힌다.
motion() { # motion <파일>...
	for f in "$@"; do
		[ "$(motion_one "$f")" = yes ] && {
			printf 'yes\n'
			return
		}
	done
	printf 'no\n'
}

# 칸 하나씩 따로 봐야 한다. 여러 파일을 한 awk 에 밀어 넣으면 A 의 손잡이가 B 의
# `time` 을 막아 주는 것처럼 셈해져서, 흐르는 체인이 안 흐르는 것으로 읽힌다.
motion_one() { # motion_one <파일>
	awk '
		function has(w) {
			return match(code, "(^|[^A-Za-z0-9_])" w "([^A-Za-z0-9_]|$)") > 0
		}
		{
			l = $0
			tail = ""
			if (match(l, /\/\/.*$/)) tail = substr(l, RSTART)
			sub(/\/\/.*$/, "", l)
			code = l
			if (has("time") || has("iTime") || has("iTimeDelta") || has("iFrame"))
				anytime = 1
			if (l ~ /^[[:space:]]*#define[[:space:]]/ && tail ~ /!motion/) {
				split(l, p, /[[:space:]]+/)
				ngate++
				if (p[3] + 0 != 0) open = 1
			}
		}
		END {
			if (!anytime) print "no"
			else if (ngate == 0) print "yes"
			else print (open ? "yes" : "no")
		}
	' "$1"
}

# ── 탭과 흐름을 한꺼번에 ──────────────────────────────────────────────────
# 한 번에 묻고 mtime 으로 캐시한다 — 값마다 부르면 GUI 가 목록 한 번에 수십 번 포크한다.
# 캐시는 요청받은 목록으로 통째로 다시 쓴다. 안 그러면 슬라이더를 끌 때마다 한 줄씩 자란다.
# stat 플래그는 GNU 와 BSD 가 달라 둘 다 시도한다(맥에서도 부른다).
mtimes() { # mtimes <파일>...  →  <mtime>\t<경로>
	stat -c '%Y	%n' "$@" 2>/dev/null || stat -f '%m	%N' "$@" 2>/dev/null
}

info_all() { # info_all <칸>...  →  <칸>\t<탭>\t<흐름>
	names=""
	paths=""
	for s in "$@"; do
		# 없는 칸은 건너뛴다 — 죽으면 셰이더 하나를 지운 순간 목록 전체가 빈다.
		if p="$(find_stage "$s")"; then
			names="$names$s	$p
"
			paths="$paths $p"
		fi
	done
	[ -n "$paths" ] || return 0

	mkdir -p "$cache"
	# shellcheck disable=SC2086
	stamps="$(mtimes $paths)"

	# 캐시에 있고 mtime 이 그대로인 것만 살린다.
	miss="$(printf '%s\n' "$stamps" | awk -F'\t' -v cf="$metacache" '
		BEGIN { while ((getline l < cf) > 0) { if (split(l, c, "\t") >= 4) seen[c[4]] = c[1] } }
		NF >= 2 && seen[$2] != $1 { print $2 }')"

	fresh=""
	if [ -n "$miss" ]; then
		fresh="$(printf '%s\n' "$miss" | while IFS= read -r f; do
			[ -n "$f" ] || continue
			t="$(taps "$f")"
			# 못 읽은 루프는 0 이다 — 배치는 죽으면 안 되고, 1 로 치면 무거운 칸이 가벼운 척한다.
			# 부르는 쪽은 0 을 "셀 수 없어서 못 건다"로 읽는다.
			if [ "$t" = "?" ]; then
				t=0
			elif [ "$t" -lt 1 ]; then
				t=1
			fi
			printf '%s\t%s\t%s\t%s\n' \
				"$(mtimes "$f" | cut -f1)" "$t" "$(motion_one "$f")" "$f"
		done)"
	fi

	# 살린 것 + 새로 센 것 → 답과 캐시를 같은 표에서 낸다.
	{
		if [ -f "$metacache" ]; then cat "$metacache"; fi
		if [ -n "$fresh" ]; then printf '%s\n' "$fresh"; fi
		printf '\034\n' # 여기부터는 "무엇을 물었는지"다
		printf '%s' "$names"
	} | awk -F'\t' -v out="$cache/meta.tsv.$$" '
		!split_done && $0 == "\034" { split_done = 1; next }
		!split_done { if (NF >= 4) { tap[$4] = $2; mot[$4] = $3; stamp[$4] = $1 } ; next }
		NF >= 2 {
			p = $2
			if (!(p in tap)) next
			print $1 "\t" tap[p] "\t" mot[p]
			if (!(p in written)) {
				written[p] = 1
				print stamp[p] "\t" tap[p] "\t" mot[p] "\t" p > out
			}
		}'
	# 캐시 교체가 실패해도(디스크가 참) 답은 이미 나갔다 — 다음에 다시 센다.
	mv "$cache/meta.tsv.$$" "$metacache" 2>/dev/null || rm -f "$cache/meta.tsv.$$"
}

# ── 합성 ──────────────────────────────────────────────────────────────────
# 칸마다 #define 껍데기를 두르고 원본을 그대로 끼운다(모양: docs/rice-scripts.md).
# 칸 하나도 같은 길로 접는다 — 안 그러면 crt/glow.glsl 처럼 precision 이 없는 파일이
# 혼자 걸릴 때만 깨진다.
compose() { # compose <파일>...
	# #version 이 첫 줄이어야 한다 — es 프로파일은 그 앞에 주석도 못 둔다
	# ("statement must appear first in es-profile shader; before comments or newlines").
	printf '#version 300 es\n'
	printf '// 이 파일은 apps/rice/chain 이 만든다. 고치지 말 것 — 다시 접히면\n'
	printf '// 통째로 날아간다. 고칠 것은 아래 칸들의 원본이다.\n'
	# --stages 가 이 줄을 되읽는다. 컴포지터는 합성본 경로만 돌려줘서 칸을 되짚을 길이 이것뿐이다.
	printf '// rice-chain:'
	for s in $stage_names; do printf ' %s' "$s"; done
	printf '\n'

	# 쓰는 유니폼만 선언한다 — 다 선언하면 apps/rice/crt 의 재그리기 판정이 `time` 을 보고 늘 켬으로 읽는다.
	# awk 에서 \b 를 쓰면 안 된다 — gawk 는 백스페이스로 읽어 검사가 조용히 빗나가고,
	# 합성본이 "screen_size : undeclared identifier" 로 죽는다.
	uniforms=$(cat "$@" | sed 's|//.*||' | awk -v st="$has_shadertoy" '
		function has(w) {
			return match($0, "(^|[^A-Za-z0-9_])" w "([^A-Za-z0-9_]|$)") > 0
		}
		{
			if (has("screen_size"))               u["screen_size"] = 1
			if (has("time"))                      u["time"] = 1
			if (has("iTime") || has("iTimeDelta") || has("iFrame")) u["time"] = 1
			if (has("pointer_position") || has("iMouse")) u["pointer_position"] = 1
			if (has("pointer_pressed_positions")) u["pointer_pressed_positions"] = 1
			if (has("pointer_pressed_times"))     u["pointer_pressed_times"] = 1
		}
		END {
			# 셰이더토이 껍데기는 fragCoord 를 만들 때 화면 크기가 있어야 한다.
			if (st != "") u["screen_size"] = 1
			for (k in u) print k
		}')

	printf '\nprecision highp float;\n\n'
	printf 'in vec2 v_texcoord;\nlayout(location = 0) out vec4 fragColor;\n\n'
	# tex 는 늘 선언한다 — 첫 칸은 화면을 읽고, 셰이더토이의 iChannel0 도 이 이름으로 접힌다.
	printf 'uniform sampler2D tex;\n'
	for u in $uniforms; do
		case "$u" in
		screen_size) printf 'uniform vec2 screen_size;\n' ;;
		time) printf 'uniform float time;\n' ;;
		pointer_position) printf 'uniform vec2 pointer_position;\n' ;;
		pointer_pressed_positions) printf 'uniform vec2 pointer_pressed_positions[32];\n' ;;
		pointer_pressed_times) printf 'uniform float pointer_pressed_times[32];\n' ;;
		esac
	done

	k=0
	for f in "$@"; do
		awk -v k="$k" -v path="$f" -v conv="$(convention "$f")" '
			# 규약의 선언 줄은 합성본 머리에서 한 번만 한다. 이 이름들만 지운다 — 셰이더가 만든
			# 다른 uniform 은 남겨야 거절된다.
			function isdecl(l) {
				return l ~ /^[[:space:]]*#version/ ||
				       l ~ /^[[:space:]]*precision[[:space:]]+[a-z]+p[[:space:]]+[a-z]+[[:space:]]*;/ ||
				       l ~ /^[[:space:]]*(layout[[:space:]]*\([^)]*\)[[:space:]]*)?in[[:space:]]+vec2[[:space:]]+v_texcoord[[:space:]]*;/ ||
				       l ~ /^[[:space:]]*(layout[[:space:]]*\([^)]*\)[[:space:]]*)?out[[:space:]]+vec4[[:space:]]+fragColor[[:space:]]*;/ ||
				       l ~ /^[[:space:]]*uniform[[:space:]]+sampler2D[[:space:]]+tex[[:space:]]*;/ ||
				       l ~ /^[[:space:]]*uniform[[:space:]]+vec2[[:space:]]+(screen_size|pointer_position)[[:space:]]*;/ ||
				       l ~ /^[[:space:]]*uniform[[:space:]]+float[[:space:]]+time[[:space:]]*;/ ||
				       l ~ /^[[:space:]]*uniform[[:space:]]+vec2[[:space:]]+pointer_pressed_positions[[:space:]]*\[/ ||
				       l ~ /^[[:space:]]*uniform[[:space:]]+float[[:space:]]+pointer_pressed_times[[:space:]]*\[/
			}
			function sep(c,   s, i) { s = ""; for (i = 0; i < 60; i++) s = s c; return s }
			{
				body[++n] = $0
				l = $0
				sub(/\/\/.*$/, "", l)
				if (l ~ /^[[:space:]]*#define[[:space:]]+[A-Za-z_]/) {
					split(l, p, /[[:space:]]+/)
					m = p[2]
					sub(/\(.*$/, "", m)   # 함수형 매크로도 이름만
					if (!(m in seenm)) { seenm[m] = 1; macro[++nm] = m }
				}
				# 최상단 선언(함수·전역·const)은 들여쓰기 없는 줄만 본다. 놓치면 칸끼리 이름이
				# 겹쳐 컴파일이 깨질 뿐, 조용히 틀린 그림이 나오지는 않는다.
				else if (l ~ /^(const[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*[\(=;\[]/) {
					d = l
					sub(/^const[[:space:]]+/, "", d)
					sub(/^[A-Za-z_][A-Za-z0-9_]*[[:space:]]+/, "", d)
					sub(/[[:space:]]*[\(=;\[].*$/, "", d)
					if (d != "" && d != "main" && !(d in seend)) {
						seend[d] = 1; name[++nn] = d
					}
				}
			}
			END {
				print ""
				print "// " sep("=")
				print "// 칸 " k " — " path "  (" conv ")"

				if (conv == "shadertoy") {
					# 뒤집기가 두 번이다: fragCoord 는 좌하단 원점이라 껍데기에서 한 번, 그 좌표로 화면을
					# 읽을 때 또 한 번. 이 함수가 `#define texture` 앞에 있어야 몸통의 texture 가 아직
					# 매크로가 아니다.
					if (k == 0)
						print "vec4 _p" k "_tex(sampler2D _s, vec2 _c) { return texture(_s, vec2(_c.x, 1.0 - _c.y)); }"
					else
						print "vec4 _p" k "_tex(sampler2D _s, vec2 _c) { return _p" (k - 1) "(vec2(_c.x, 1.0 - _c.y)); }"
					print "#define texture(_s, _c) _p" k "_tex(_s, _c)"
					print "#define iChannel0   tex"
					print "#define iResolution vec3(screen_size, 1.0)"
					print "#define iTime       time"
					print "#define iTimeDelta  (1.0 / 60.0)"
					print "#define iFrame      int(time * 60.0)"
					print "#define iMouse      vec4(pointer_position * screen_size, 0.0, 0.0)"
				} else {
					print "vec2 _uv" k "; vec4 _fc" k ";"
					print "#define v_texcoord _uv" k
					print "#define fragColor _fc" k
					print "#define main _p" k "_main"
					if (k > 0) print "#define texture(_s, _c) _p" (k - 1) "(_c)"
				}
				for (i = 1; i <= nn; i++) print "#define " name[i] " _p" k "_" name[i]

				for (i = 1; i <= n; i++) if (!isdecl(body[i])) print body[i]

				for (i = 1; i <= nn; i++) print "#undef " name[i]
				for (i = 1; i <= nm; i++) print "#undef " macro[i]
				if (conv == "shadertoy") {
					print "#undef texture"
					print "#undef iChannel0"
					print "#undef iResolution"
					print "#undef iTime"
					print "#undef iTimeDelta"
					print "#undef iFrame"
					print "#undef iMouse"
					print "vec4 _p" k "(vec2 _c) {"
					print "    vec4 _o = vec4(0.0, 0.0, 0.0, 1.0);"
					print "    _p" k "_mainImage(_o, vec2(_c.x, 1.0 - _c.y) * screen_size);"
					print "    return _o;"
					print "}"
				} else {
					print "#undef v_texcoord"
					print "#undef fragColor"
					print "#undef main"
					if (k > 0) print "#undef texture"
					print "vec4 _p" k "(vec2 _c) { _uv" k " = _c; _p" k "_main(); return _fc" k "; }"
				}
			}
		' "$f"
		k=$((k + 1))
	done

	printf '\nvoid main() { fragColor = _p%d(v_texcoord); }\n' "$((k - 1))"
}

# ── 명령 ──────────────────────────────────────────────────────────────────
mode=apply
case "${1:-}" in
--check) mode=check; shift ;;
--cost) mode=cost; shift ;;
--motion) mode=motion; shift ;;
--stages)
	[ -f "${2:-}" ] || die "합성본 경로가 필요하다"
	sed -n 's|^// rice-chain: ||p' "$2"
	exit 0
	;;
--limit)
	# UI 가 64 를 따로 적지 않게 밖에서 묻는다 — RICE_CHAIN_MAX_TAPS 를 올린 머신에서 어긋난다.
	printf '%s\n' "$max_taps"
	exit 0
	;;
--info-all)
	shift
	[ $# -gt 0 ] || die "칸을 하나 이상 줘야 한다"
	info_all "$@"
	exit 0
	;;
--addable)
	# 곱 한도 규칙은 여기 한 곳에만 둔다 — UI 가 따로 세면 한쪽만 고친 날 목록이 거짓말을 한다.
	shift
	cands="$(cat)"
	# 현재 칸과 후보를 프로세스 하나로 센다.
	# shellcheck disable=SC2086
	table="$(info_all "$@" $cands)"
	{
		printf '%s\n' "$table"
		printf '\034\n'
		printf '%s\n' "$cands"
	} | awk -F'\t' -v cur="$*" -v lim="$max_taps" '
		!split_done && $0 == "\034" {
			split_done = 1
			now = 1
			n = split(cur, c, " ")
			for (i = 1; i <= n; i++) {
				if (c[i] == "") continue
				# 지금 칸을 못 세면 빈 목록을 낸다 — 아무거나 권하는 것보다 낫다.
				if (!(c[i] in tap) || tap[c[i]] + 0 < 1) { bad = 1; break }
				now *= tap[c[i]]
			}
			next
		}
		!split_done { if (NF >= 2) tap[$1] = $2; next }
		{
			v = $1
			if (v == "" || bad) next
			if (!(v in tap) || tap[v] + 0 < 1) next
			if (now * tap[v] > lim) next
			print v "\t" (now * tap[v])
		}'
	exit 0
	;;
-*) die "알 수 없는 옵션: $1" ;;
esac

[ $# -gt 0 ] || die "칸을 하나 이상 줘야 한다  (예: apps/rice/chain water/still print/paper)"

stage_names="$*"
files=""
for s in "$@"; do
	files="$files $(resolve "$s")"
done
# shellcheck disable=SC2086
set -- $files

if [ "$mode" = motion ]; then
	motion "$@"
	exit 0
fi

# 비용부터 본다. 못 쓸 조합이면 파일을 만들 이유가 없다.
product=1
detail=""
has_shadertoy=""
for f in "$@"; do
	[ "$(convention "$f")" = shadertoy ] && has_shadertoy=1

	# 고스티 전용 유니폼은 하이프랜드가 안 준다. 검증기의 "iCurrentCursor : undeclared identifier"
	# 보다 원인과 할 일을 바로 말해 준다.
	bad="$(sed 's|//.*||' "$f" |
		grep -o 'iCurrentCursor[A-Za-z]*\|iPreviousCursor[A-Za-z]*\|iTimeCursorChange' |
		sort -u | tr '\n' ' ')"
	if [ -n "$bad" ]; then
		printf "${RED}%s 는 고스티 전용 유니폼을 읽는다: %s${NC}\n" "$(basename "$f")" "$bad" >&2
		die "화면 셰이더에는 그 값이 없다 — 터미널 창에서만 도는 셰이더다."
	fi

	# 셰이더가 직접 선언한 유니폼은 접기도 검증기도 통과하고, 하이프랜드가 안 주니 0 이 든 그림이
	# 조용히 나온다 — 검증기가 못 잡는 자리라 여기서 막는다. 이름을 마지막 낱말에서 뽑는 것은
	# `uniform highp float time;` 같은 정밀도 한정자 때문이다.
	unknown="$(sed 's|//.*||' "$f" | awk '
		$1 == "uniform" {
			n = $NF
			sub(/[\[;].*$/, "", n)
			if (n !~ /^(tex|screen_size|time|pointer_position|pointer_pressed_positions|pointer_pressed_times|iChannel0|iResolution|iTime|iTimeDelta|iFrame|iMouse)$/)
				print n
		}' | sort -u | tr '\n' ' ')"
	if [ -n "$unknown" ]; then
		printf "${RED}%s 가 선언한 유니폼을 하이프랜드가 줄 수 없다: %s${NC}\n" \
			"$(basename "$f")" "$unknown" >&2
		printf "${DIM}컴포지터가 주는 것은 tex · screen_size · time · pointer_* 뿐이다. 값을 밖에서 넣고 싶으면 유니폼이 아니라 #define 으로 두고 apps/rice/knobs 를 쓸 것.${NC}\n" >&2
		die "안 막으면 그 값이 0 인 채로 조용히 걸린다 — 검증기는 이걸 안 잡는다."
	fi

	t="$(taps "$f")"
	[ "$t" = "?" ] && die "$(basename "$f") 의 루프 횟수를 못 읽었다 — 탭 수를 셀 수 없어서 안 건다."
	[ "$t" -lt 1 ] && t=1
	product=$((product * t))
	detail="$detail  $(basename "$f") ${t}탭"
done

if [ "$mode" = cost ]; then
	printf '%s\n' "$product"
	printf "${DIM}%s${NC}\n" "$detail" >&2
	exit 0
fi

if [ "$product" -gt "$max_taps" ]; then
	printf "${RED}이 조합은 픽셀당 tex 를 %d 번 읽는다 (한도 %d). 안 건다.${NC}\n" \
		"$product" "$max_taps" >&2
	printf "${DIM}%s${NC}\n" "$detail" >&2
	printf "${DIM}인라인 합성이라 비용이 곱이다 — 순서를 바꿔도 안 준다. 탭 많은 칸은 하나만 두고 나머지는 한 탭짜리로 (apps/rice/chain 머리말).${NC}\n" >&2
	exit 1
fi

mkdir -p "$cache"

# 신원은 cksum 이 맡고 슬러그는 사람이 읽으라고 있다 — 슬러그만으로는 `/a/b` 와 `/a.b` 가
# 뭉개지고, 앞의 `/` 가 `.` 이 되어 숨김 파일이 된다.
slug="$(printf '%s' "$stage_names" | tr ' /' '+.' | tr -c 'A-Za-z0-9.+_-' '_' | sed 's/^\.*//')"
sum="$(printf '%s' "$stage_names" | cksum | cut -d' ' -f1)"
out="$cache/$slug.$sum.frag"

# 임시 파일 이름이 고정이면 같은 체인을 동시에 접을 때 서로 덮어쓴다. 슬라이더를
# 끄는 동안 --reload 가 연달아 들어오는 자리가 정확히 그렇다.
tmp="$(mktemp "$cache/.compose.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

compose "$@" >"$tmp"

# 하이프랜드는 컴파일 실패를 알리지 않는다 — 다음 프레임에 컴파일하고 hyprctl 은 ok 를 돌려주며
# 화면만 검게 남는다(0.56.1 실측). 검증기가 없어도 도는 것은 맥·니리에서도 부르기 때문이다
# (하이프랜드 세션에는 모듈이 glslang 을 깐다).
if command -v glslangValidator >/dev/null 2>&1; then
	if ! err="$(glslangValidator -S frag "$tmp" 2>&1)"; then
		printf "${RED}합성본이 컴파일되지 않는다. 안 건다.${NC}\n" >&2
		printf '%s\n' "$err" | sed 's/^/  /' >&2
		printf "${DIM}합성본을 보려면: %s${NC}\n" "$tmp" >&2
		trap - EXIT
		exit 1
	fi
fi

mv "$tmp" "$out"
trap - EXIT
[ "$mode" = check ] || printf '%s\n' "$out"
