#!/bin/sh -e
#
# 라이싱 스튜디오의 슬라이더가 셰이더 값을 읽고 쓰는 뒤판(apps/rice/studio). 쓰는 법과 세부: docs/rice-scripts.md
#
# 스크린 셰이더에 넣을 유니폼이 없어서(tex·time·screen_size·pointer_* 뿐) 값은 #define 을 고쳐 다시 건다.
# 손잡이는 셰이더가 `// @최소..최대[:눈금]` 으로 스스로 선언한다. 쓰는 곳은 늘 $HOME 이고 레포는 비교·되돌리기용이다.

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

# rice-save 와 달리 cwd 를 못 믿는다(DMS 안에서 불린다). $0 의 체크아웃에 묻고, 안 되면 관례 경로.
repo="${RICE_REPO:-$(git -C "$(dirname "$0")" rev-parse --show-toplevel 2>/dev/null || echo "$HOME/nixos-config")}"

# ── 대상 ──────────────────────────────────────────────────────────────────
# 한 줄 = <id> <라이브 파일> <레포 파일> <종류>. 종류가 다시 거는 방법을 정한다.
targets() {
	for f in "$cfg"/hypr/shaders/*/*.frag "$cfg"/hypr/shaders/*/*.glsl; do
		[ -f "$f" ] || continue
		n="${f#"$cfg"/hypr/shaders/}"
		printf '%s\t%s\t%s\t%s\n' "${n%.*}" "$f" \
			"$repo/modules/nixos/hyprland/rice/shaders/$n" hypr
	done
	for f in "$cfg"/ghostty/shaders/*.glsl; do
		[ -f "$f" ] || continue
		n="${f##*/}"; n="${n%.glsl}"
		printf 'term/%s\t%s\t%s\t%s\n' "$n" "$f" \
			"$repo/modules/shared/ghostty/shaders/$n.glsl" term
	done
}

field() { # field <id> <열번호>
	targets | awk -F'\t' -v id="$1" -v c="$2" '$1 == id { print $c; exit }'
}

# ── 파서 ──────────────────────────────────────────────────────────────────
# JSON 조립은 jq 에 맡긴다 — 설명에 따옴표와 한글이 들어온다. `all` 은 표시 없는 #define 도
# 뽑는다 — 표시가 아직 없는 레포 사본에서도 레포 값과 되돌리기가 돌아야 한다.
parse() { # parse <파일> [all]
	[ -f "$1" ] || return 0
	awk -v all="${2:-}" '
		# "// ── 형태 ────" 를 그룹 머리로 읽는다 — 셰이더의 구역 나눔 그대로 슬라이더가 묶인다.
		/^\/\/[[:space:]]*──/ {
			g = $0
			sub(/^\/\/[[:space:]]*──[[:space:]]*/, "", g)
			sub(/[[:space:]]*─.*$/, "", g)
			group = g; doc = ""; next
		}
		# 붙어 있는 주석 줄은 바로 아래 #define 의 설명이 된다.
		/^\/\// {
			l = $0
			sub(/^\/\/[[:space:]]?/, "", l)
			doc = (doc == "" ? l : doc " " l)
			next
		}
		/^#define[[:space:]]/ {
			ann = ""; rest = ""; mot = 0
			if (match($0, /\/\/[[:space:]]*@[^[:space:]]+/)) {
				ann = substr($0, RSTART, RLENGTH)
				rest = substr($0, RSTART + RLENGTH)
				sub(/^\/\/[[:space:]]*@/, "", ann)

				# `@범위` 뒤 나머지가 설명이다. 섞인 `!motion` 은 chain --motion 이 debug:vfr 판정에 쓰는
				# 표시라 설명에서 뺀다.
				if (rest ~ /!motion/) mot = 1
				gsub(/!motion/, "", rest)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", rest)
				if (rest != "") doc = (doc == "" ? rest : doc " " rest)
			}
			# 숫자만 손잡이가 된다. TINT 같은 vec3 을 슬라이더에 태우면
			# 되돌리기가 그 줄을 0.0000 으로 만들어 버린다.
			if ((ann != "" || all != "") && $3 ~ /^-?[0-9]+(\.[0-9]+)?$/) {
				n = split(ann, ps, ":")
				step = (n > 1 ? ps[2] : "")
				split(ps[1], mm, /\.\./)
				printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
					group, $2, $3, mm[1], mm[2], step, doc, mot
			}
			doc = ""; next
		}
		{ doc = "" }
	' "$1"
}

# ── 명령 ──────────────────────────────────────────────────────────────────
case "${1:-}" in
"" | targets)
	# 플러그인은 지금 걸린 것을 기본 선택으로 쓴다. 체인은 순서가 뜻을 가지므로(앞칸의 출력이
	# 뒷칸의 입력) 걸렸는지(applied)와 몇째 칸인지(pass)를 같이 준다.
	stages=""
	if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
		stages="$("$(dirname "$0")/crt" --stages 2>/dev/null || true)"
	fi
	targets | jq -Rs --arg stages "$stages" '
		($stages | split("\n") | map(select(length > 0))) as $s
		| [ split("\n")[] | select(length > 0) | split("\t")
		    | . as $t
		    | ($s | index($t[0])) as $i
		    | { id: $t[0], file: $t[1], kind: $t[3],
		        applied: ($i != null),
		        pass: (if $i == null then null else $i + 1 end) } ]
		| { targets: ., chain: $s }'
	;;

get)
	id="${2:?대상이 필요하다}"
	live="$(field "$id" 2)"
	[ -n "$live" ] || { printf '그런 대상은 없다: %s\n' "$id" >&2; exit 1; }

	# 레포 값이 없으면(스토어에서 실행·파일 없음) "레포와 다름" 표시가 안 뜰 뿐이다.
	# mktemp + trap 이다 — jq 가 죽어 set -e 로 나가도 파일이 남지 않는다.
	reposnap="$(mktemp)"
	trap 'rm -f "$reposnap"' EXIT

	parse "$(field "$id" 3)" all | jq -Rs '
		[ split("\n")[] | select(length > 0) | split("\t") | { key: .[1], value: .[2] } ] | from_entries
	' >"$reposnap"

	parse "$live" | jq -Rs --arg id "$id" --slurpfile repo "$reposnap" '
		[ split("\n")[] | select(length > 0) | split("\t")
		  | { group: .[0], name: .[1],
		      value: (.[2] | tonumber),
		      min:   (.[3] | tonumber),
		      max:   (.[4] | tonumber),
		      # 기본 눈금은 범위의 1/100. 부동소수 찌꺼기(0.013999…)가 GUI 에 뜨지 않게 유효숫자에서 자른다.
		      step:  (if .[5] == "" then (((.[4] | tonumber) - (.[3] | tonumber)) / 100 * 10000 | round) / 10000
		              else (.[5] | tonumber) end),
		      doc:   .[6],
		      # 0 으로 내리면 흐르는 것이 멈춘다는 표시 — 배터리를 먹는 이유를 UI 에서 확인할 수 있다.
		      motion: (.[7] == "1"),
		      repo:  ($repo[0][.[1]] // null | if . == null then null else tonumber end) } ]
		| map(. + { dirty: (.repo != null and (.repo - .value | fabs) > 1e-9) })
		# 그룹은 파일에 나온 순서를 지킨다(형태 → 광학 → 줄무늬 → 색). 이름순이면 읽기 나빠진다.
		| { target: $id,
		    groups: (reduce .[] as $k ([];
		               if (length > 0 and (.[-1].label == $k.group))
		               then .[0:-1] + [ .[-1] + { knobs: (.[-1].knobs + [$k]) } ]
		               else . + [ { label: $k.group, knobs: [$k] } ] end)) }'
	;;

set | reset)
	cmd="$1"
	id="${2:?대상이 필요하다}"
	key="${3:-}"
	live="$(field "$id" 2)"
	[ -n "$live" ] || { printf '그런 대상은 없다: %s\n' "$id" >&2; exit 1; }

	if [ "$cmd" = set ]; then
		[ -n "$key" ] || { printf '이름이 필요하다\n' >&2; exit 1; }
		val="${4:?값이 필요하다}"
		pairs="$key	$val"
		raw=""
	else
		# 되돌릴 값은 레포에서 읽는다. 이름을 주면 그것만, 안 주면 전부.
		pairs="$(parse "$(field "$id" 3)" all |
			awk -F'\t' -v k="$key" '(k == "" || $2 == k) { printf "%s\t%s\n", $2, $3 }')"
		[ -n "$pairs" ] || { printf '레포에서 되돌릴 값을 못 찾았다\n' >&2; exit 1; }
		raw=1
	fi

	tmp="$(mktemp)"
	trap 'rm -f "$tmp"' EXIT
	cp "$live" "$tmp"

	printf '%s\n' "$pairs" | while IFS='	' read -r k v; do
		[ -n "$k" ] || continue
		awk -v k="$k" -v v="$v" -v raw="$raw" '
			# 이미 그 값이면 줄을 그대로 둔다 — 열 맞춤만 다른 헛 diff 가 apps/rice/save 에 남는다.
			# reset 은 표시 없는 #define(`#define TAU 6.2831853`)까지 훑어서 특히 잘 걸린다.
			$1 == "#define" && $2 == k && $3 == v && raw != "" { print; next }

			$1 == "#define" && $2 == k {
				# 되돌리기는 레포에 적힌 글자를 그대로 쓴다. 0.10 을 0.1 로
				# 정규화해 버리면 값은 같은데 diff 만 남는다.
				if (raw != "")
					s = v
				# 원래 값에 소수점이 있었으면 새 값에도 있어야 한다. GLSL 에서
				# `1` 은 int 라, float 자리에 들어가면 곱셈부터 컴파일이 깨진다.
				else if ($3 ~ /\./) {
					s = sprintf("%.4f", v + 0)
					sub(/0+$/, "", s)
					if (s ~ /\.$/) s = s "0"
				} else
					s = sprintf("%d", v + 0)

				# 뒤에 붙은 주석(범위 표시)은 그대로 옮기고, 열은 매번 같은
				# 자리로 다시 맞춘다. 원래 폭을 기준으로 메우면 값 길이가 바뀔
				# 때마다 조금씩 밀려서 파일이 서서히 지저분해진다.
				tail = $0
				sub(/^#define[[:space:]]+[A-Za-z0-9_]+[[:space:]]+[^[:space:]]+[[:space:]]*/,
				    "", tail)
				# do-while 이어야 이름이 이미 20 칸을 채운 줄에도 공백이 붙는다. while 이면 `#define FOCUS_RADIUS0.13`
				# 이 되어 컴파일 에러가 셰이더 탓으로 보인다. 그 줄만 열이 한 칸 밀리는 것은 감수한다.
				out = sprintf("#define %s", k)
				do { out = out " " } while (length(out) < 20)
				out = out s
				if (tail != "") {
					do { out = out " " } while (length(out) < 38)
					out = out tail
				}
				print out
				next
			}
			{ print }
		' "$tmp" >"$tmp.new" && mv "$tmp.new" "$tmp"
	done

	cp "$tmp" "$live"

	# ── 다시 걸기 ────────────────────────────────────────────────────────
	here="$(dirname "$0")"
	case "$(field "$id" 4)" in
	hypr)
		# 체인의 한 칸일 수 있어 칸 목록에서 찾는다. 안 걸린 셰이더는 다음에 고를 때 새로 접힌다.
		if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] &&
			"$here/crt" --stages 2>/dev/null | grep -qxF "$id"; then
			"$here/crt" --reload >/dev/null
		fi
		;;
	term)
		# 조각을 다시 넣으면 셰이더까지 새로 읽는다. 지금 룩이 이 셰이더를 쓰는지 보려면 .conf 를
		# 파싱해야 해서 그냥 다시 건다 — 같은 것을 다시 거는 건 무해하다.
		t="$("$here/term" --current 2>/dev/null || echo '')"
		[ -n "$t" ] && "$here/term" "$t" >/dev/null 2>&1 || true
		;;
	esac
	;;

*)
	printf '알 수 없는 명령: %s\n' "$1" >&2
	exit 1
	;;
esac
