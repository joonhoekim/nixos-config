    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: eza, settings: { id: eza-community.eza, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: atuin, settings: { id: Atuinsh.Atuin, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: duf, settings: { id: muesli.duf, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: fastfetch, settings: { id: Fastfetch-cli.Fastfetch, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: glow, settings: { id: charmbracelet.glow, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: d2, settings: { id: Terrastruct.D2, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: hyperfine, settings: { id: sharkdp.hyperfine, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: tokei, settings: { id: XAMPPRocky.Tokei, source: winget } }
    # entr 대응도 겸한다
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: watchexec, settings: { id: watchexec.watchexec, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: just, settings: { id: Casey.Just, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: gum, settings: { id: charmbracelet.gum, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: onefetch, settings: { id: o2sh.onefetch, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: bottom, settings: { id: Clement.bottom, source: winget } }
    # ncdu 대응
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: gdu, settings: { id: dundee.gdu, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: gitui, settings: { id: StephanDilly.gitui, source: winget } }
    # - { resource: Microsoft.WinGet.DSC/WinGetPackage, id: chafa, settings: { id: hpjansson.Chafa, source: winget } }

