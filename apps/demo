	say "Super + Shift + O" "이 창을 다음 워크스페이스로" \
		"Shift 는 어디서나 '창을 데리고 간다' 는 뜻이다." \
		"테스트 창이 여기서 빠져 옆자리로 넘어간다."
	wfocus "$W_TESTS"
	act "hl.dsp.window.move({ workspace = $NEXT_WS })"
	beat 16

	say "Super + O → Super + Tab" "가 보면 거기 있다" \
		"옆 워크스페이스로 넘어갔다가 직전 자리로 돌아온다." \
		"철자는 previous 하나뿐이다 — prev 는 조용히 아무 일도 안 한다."
	act "hl.dsp.focus({ workspace = \"e+1\" })"
	beat 14
	act "hl.dsp.focus({ workspace = \"previous\" })"
	beat 12

	say "Ctrl + C 해도 같다" "정리" \
		"열었던 창은 전부 스스로 나간다." \
		"원래 있던 워크스페이스로 돌아간다."
	beat 12
}

# DMS 오버레이는 창이 아니라 레이어다 — 워크스페이스에 속하지 않고 타일 배치를
# 밀어내지도 않으면서 화면 위에 그려진다. 그래서 이 시나리오는 배경으로 쓸 창
# 몇을 깔아 두고, 그 위로 셸을 부르는 것만 한다.
#
# 키는 전부 toggle 이지만 여기서는 **open / close 를 따로 부른다.** toggle 은
# 지금 상태에 기대는데, 시연을 시작할 때 그 상태를 알 수 없다 — 누가 치트시트를
# 켜 둔 채 부르면 첫 스텝이 그걸 끄고, 그 뒤로 모든 오버레이가 한 칸씩 어긋난다.
# 실제로 그렇게 돌아서 치트시트만 화면에 안 뜬 판을 한 번 찍었다. `dms ipc` 는
# 짝을 다 갖고 있으므로(open/close, openOverview/closeOverview, hide) 상태를
# 안 물어도 되는 쪽을 쓴다.
#
# 열어 둔 채 다음 스텝으로 넘어가면 안 되는 이유도 있다: 스포트라이트처럼
# 키보드를 통째로 잡는 것이 있어서 그 뒤가 전부 막힌다.
hypr_shell() {
	TOTAL=7
	_dms() { dms ipc call $1 >/dev/null 2>&1 || true; }

	# 오버뷰·알림·컨트롤센터·스포트라이트는 layer-shell 로 그려져서 창 위에
	# 그냥 얹힌다. 그런데 **치트시트만 창이다** — quickshell 이 보통 창으로
	# 띄우고 하이프랜드가 다른 창과 똑같이 타일링한다. 그래서 컬럼이 이미 셋인
	# 상태에서 열면 넷째 컬럼으로 들어가 화면 밖으로 밀린다: 열리기는 열렸는데
	# 화면에는 아무것도 안 나타나는 판을 두 번 찍고서야 알았다.
	#
	# 열고 나서 그 창으로 포커스를 옮기면 띠가 그쪽으로 스크롤해 온다.
	_dms_window() {
		_b="$(hyprctl clients -j | jq -c '[.[].address]')"
		_dms "$1"
		beat 8
		_w="$(hyprctl clients -j |
			jq -r --argjson old "$_b" '[.[].address] - $old | first // empty')"
		wfocus "$_w"
	}

	say "Super + $WS_LABEL" "빈 워크스페이스로 간다" \
		"셸을 부를 배경으로 창 몇을 깔아 둔다."
	act "hl.dsp.focus({ workspace = $DEMO_WS })"
	beat 6

	spawn narrator 62 9 15
	NARRATOR="$SPAWNED"
	focus_spawned
	act "hl.dsp.layout(\"colresize -0.1\")"
	act "hl.dsp.layout(\"colresize -0.1\")"
	spawn logs 92 30 11 "$NARRATOR"
	spawn editor 88 34 11 "$SPAWNED"
	beat 8

	say "Super + H" "치트시트 — 살아 있는 키맵" \
		"DMS 가 컴포지터에게 직접 물어서 그린다." \
		"문서를 옮겨 적은 게 아니라서 설정과 어긋날 수 없다." \
		"이것만 레이어가 아니라 창이라 컬럼 하나를 차지한다." \
		"macOS 에는 이 셸이 없어 같은 키가 keymap.md 를 연다."
	_dms_window "keybinds open hyprland"
	beat 26
	_dms "keybinds close"
	beat 6

	say "Super + E" "오버뷰" \
		"워크스페이스 전부와 그 안의 창을 한눈에."
	_dms "hypr openOverview"
	beat 28
	_dms "hypr closeOverview"
	beat 6

	say "Super + N" "알림 센터" \
		"창이 아니라 레이어라 타일 배치는 그대로 있다."
	_dms "notifications open"
	beat 24
	_dms "notifications close"
	beat 6

	say "Super + S" "컨트롤 센터" \
		"소리·와이파이·블루투스·배터리." \
		"macOS 의 그것과 같은 자리를 차지한다."
	_dms "control-center open"
	beat 24
	_dms "control-center hide"
	beat 6

	say "Super + Space" "스포트라이트" \
		"런처. Super+D 의 fuzzel 과 따로 있다 —" \
		"이쪽은 셸이 그리고, 그쪽은 독립 프로그램이다."
	_dms "spotlight open"
	beat 24
	_dms "spotlight close"
	beat 6

	say "Super + Escape" "파워메뉴는 부르지 않는다" \
		"로그아웃·잠금의 유일한 입구라서다." \
		"자동 시연이 건드릴 물건은 아니다."
	beat 14
}

printf "\n${BOLD}%s${NC} ${DIM}— 워크스페이스 %s 를 빌려 쓴다${NC}\n\n" "$SCENARIO" "$WS_LABEL"

case "$WM/$SCENARIO" in
rift/incident) rift_incident ;;
rift/layouts) rift_layouts ;;
hypr/incident) hypr_incident ;;
hypr/shell) hypr_shell ;;
esac
