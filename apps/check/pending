#!/bin/sh
#
# 사람이 해야 하는 단계 중 아직 안 된 것만 보인다. macOS 전용. **아무것도 고치지 않는다.**
#
#   apps/check/pending          build-switch 가 끝에서 부른다. 남은 것이 없으면 아무것도 안 찍는다
#   apps/check/pending --open   남은 단계의 설정 화면을 차례로 띄우고, 승인될 때까지 기다린다
#
# 전부 macOS 가 사람의 클릭을 요구하는 단계라 activation 은 성공하고 데몬은 KeepAlive 로 조용히 재시작만 반복한다.
# 화면 이름과 URL 은 macOS 27.0.1 에서 열어 보고 확인한 것이다. 판이 바뀌어 엉뚱한 화면이 뜨면
# 다시 확인하는 법: docs/clean-install-macos.md 의 7절.

YELLOW='\033[1;33m'; GREEN='\033[1;32m'; DIM='\033[2m'; NC='\033[0m'

[ "$(uname)" = Darwin ] || exit 0
open_mode=0
[ "${1:-}" = --open ] && open_mode=1

sys=/run/current-system
url_im='x-apple.systempreferences:com.apple.preference.security?Privacy_ListenEvent'
url_ax='x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility'
url_sc='x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture'
url_ext='x-apple.systempreferences:com.apple.LoginItems-Settings.extension?ExtensionItems'

has_kanata() { [ -e "$sys/Library/LaunchDaemons/org.nixos.kanata.plist" ]; }
dext_ok() {
  systemextensionsctl list 2>/dev/null \
    | grep 'org.pqrs.Karabiner-DriverKit-VirtualHIDDevice' | grep -q 'activated enabled'
}
# kanata 는 모자란 권한을 한 번에 하나만 로그에 적으므로 이번 실행의 권한 오류가 지금 모자란 것이다. 출력: im / ax / ok / starting / other
# 권한이 없어도 약 2 초 떠 있다 죽고 KeepAlive 가 10 초마다 다시 띄우므로(kanata 1.12, macOS 27 실측),
# 5 초 넘게 오류 없이 떠 있어야 ok 다. running 만 보면 --open 이 승인 없이 끝난다.
kanata_need() {
  _kanata_need || { sleep 1; _kanata_need; } || echo other
}
# 이번 실행이 오류 줄을 쓰기 전에 끝난 순간이면(pid 는 없고 오류도 아직 없다) 1 을
# 돌려준다. 위에서 한 번 더 읽고, 그래도 같으면 권한이 아닌 이유로 끝난 것이다.
_kanata_need() {
  run="$(awk '/kanata v[^ ]* starting/ { buf = "" } { buf = buf $0 "\n" } END { printf "%s", buf }' \
    /var/log/kanata.log 2>/dev/null)"
  case "$(printf '%s' "$run" | grep 'failed to open keyboard' | tail -1)" in
    *"Input Monitoring"*) echo im; return ;;
    *"Accessibility"*) echo ax; return ;;
    ?*) echo other; return ;;
  esac
  pid="$(sudo -n launchctl print system/org.nixos.kanata 2>/dev/null | awk '$1 == "pid" { print $3; exit }')"
  [ -n "$pid" ] || return 1
  # etime 은 [[dd-]hh:]mm:ss. 5 초와만 견주므로 dd 의 자릿값은 맞추지 않는다.
  up="$(ps -o etime= -p "$pid" 2>/dev/null | awk -F'[-:]' '{ s = 0; for (i = 1; i <= NF; i++) s = s * 60 + $i; print s }')"
  if [ "${up:-0}" -ge 5 ]; then echo ok; else echo starting; fi
}
# 한 번만 보는 자리(목록)에서 쓴다. 막 다시 뜬 참이면 판가름이 날 때까지 몇 초 기다린다.
kanata_settled() {
  for _ in 1 2 3 4; do
    r="$(kanata_need)"
    [ "$r" = starting ] || break
    sleep 2
  done
  echo "$r"
}
# Device Control and Data Access 권한이 없으면 rift-grid 는 떠 있어도 창을 못 본다(check/mac 의 rift-grid 절과 같은 기준).
# 창이 정말 없어도 실패하지만, 이 스크립트는 터미널 창 안에서 돌아서 실패하면 권한 쪽일 가능성이 높다.
cli="$HOME/.local/bin/rift-grid-cli"
has_rift() {
  [ -x "$cli" ] && launchctl print "gui/$(id -u)/org.nixos.rift-grid" 2>/dev/null | grep -q 'state = running'
}
rift_ok() { "$cli" query windows 2>/dev/null | grep -q '"bundle_id"'; }

n=0
item() {  # <무엇을> <어디서> [<확인>]
  [ $n -eq 0 ] && printf "\n${YELLOW}사람이 해야 할 단계가 남아 있다${NC}\n"
  n=$((n+1))
  printf "  %d. %s\n" "$n" "$1"
  printf "     ${DIM}%s${NC}\n" "$2"
  [ -n "${3:-}" ] && printf "     ${DIM}확인: %s${NC}\n" "$3"
}

if has_kanata; then
  # 순서가 있다. 드라이버가 승인되기 전에는 kanata 가 권한이 있어도 키를 내보낼 곳이 없다.
  dext_ok || item "Karabiner VirtualHIDDevice 드라이버 확장을 켠다" \
    "System Settings > General > Login Items & Extensions > (아래로) Extensions > Driver Extensions" \
    "systemextensionsctl list 가 [activated enabled]"
  # 목록에서는 둘을 한꺼번에 안내한다. 하나씩 따라가면 왕복이 두 번이 된다.
  case "$(kanata_settled)" in
    im|ax) item "/usr/local/libexec/kanata/kanata 를 두 목록에 넣고 켠다 (목록에 없으면 + 에서 ⌘⇧G 로 경로 입력)" \
      "System Settings > Privacy & Security > Input Monitoring, 그리고 > Device Control and Data Access" \
      "/var/log/kanata.log 의 'entering the event loop' 뒤로 오류가 없다
     예전 자리 /usr/local/libexec/kanata 의 항목이 폴더 아이콘으로 켜져 있으면 그건 효과가 없다. − 로 지우고 그 안의 kanata 를 넣는다" ;;
  esac
fi
if has_rift && ! rift_ok; then
  item "~/.local/bin/rift-grid 를 두 목록에 켠다" \
    "System Settings > Privacy & Security > Device Control and Data Access, 그리고 > Screen & System Audio Recording" \
    "launchctl kickstart -k gui/$(id -u)/org.nixos.rift-grid 뒤 nix run .#check 의 rift-grid 절"
fi

if [ $n -eq 0 ]; then
  [ $open_mode = 1 ] && printf "${GREEN}남은 단계가 없다.${NC}\n"
  exit 0
fi
if [ $open_mode = 0 ]; then
  printf "  ${DIM}설정 화면을 차례로 띄우려면: apps/check/pending --open   전체 점검: nix run .#check${NC}\n"
  exit 0
fi

# --open: 3 초마다 상태를 다시 읽어 토글이 켜지면 다음 화면으로 넘어간다. kanata 는 다시 뜨며 다음에 모자란
# 권한을 로그에 적으므로 Input Monitoring → Device Control and Data Access 순으로 따라간다. 그만두려면 Ctrl-C.
shown=""
show() {  # <url> <안내>
  [ "$shown" = "$1" ] && return
  shown="$1"
  printf "\n${YELLOW}→ %s${NC}\n" "$2"
  open "$1"
}
waiting() { printf "${DIM}.${NC}"; sleep 3; }

if has_kanata; then
  while ! dext_ok; do
    show "$url_ext" "Login Items & Extensions 를 아래로 내려 Extensions 의 Driver Extensions (i) 에서 Karabiner 를 켠다"
    waiting
  done
  while :; do
    case "$(kanata_need)" in
      ok|other) break ;;
      starting) ;;
      im) show "$url_im" "Input Monitoring 에 kanata 를 켠다 (없으면 + → ⌘⇧G → /usr/local/libexec/kanata/kanata. 폴더 아이콘의 kanata 는 옛 자리라 효과가 없다)" ;;
      ax) show "$url_ax" "Device Control and Data Access 에 kanata 를 켠다 (없으면 + → ⌘⇧G → /usr/local/libexec/kanata/kanata. 폴더 아이콘의 kanata 는 옛 자리라 효과가 없다)" ;;
    esac
    waiting
  done
  [ "$(kanata_settled)" = ok ] && printf "\n${GREEN}kanata 가 돈다.${NC}\n"
fi
if has_rift && ! rift_ok; then
  show "$url_ax" "Device Control and Data Access 에 rift-grid 를 켠다"
  printf "${DIM}  다음으로 Screen & System Audio Recording 을 띄운다. 켰으면 Enter.${NC}"
  read -r _ </dev/tty
  show "$url_sc" "Screen & System Audio Recording 에 rift-grid 를 켠다 — 켰으면 Enter"
  read -r _ </dev/tty
  # 허가는 다시 띄워야 먹는다.
  launchctl kickstart -k "gui/$(id -u)/org.nixos.rift-grid" 2>/dev/null
  sleep 3
  rift_ok && printf "${GREEN}rift-grid 가 창을 본다.${NC}\n"
fi
exit 0
