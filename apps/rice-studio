#!/bin/sh -e
#
# 라이싱 스튜디오를 띄운다 — 화면 셰이더를 고르고, 겹치고, 값을 맞추는 창.
#
#   apps/rice-studio        띄운다 (이미 떠 있으면 아무 일도 안 한다)
#
# ── 왜 별도 프로그램인가 ──────────────────────────────────────────────────
# 이 일은 원래 DMS 플러그인 둘이 나눠 하고 있었다 — 런처에서 고르고, 설정 모달의
# 슬라이더로 값을 맞췄다. 축이 하나 는 게 아니라 **축의 성질이 달라진** 것이
# 갈라선 이유다. 다른 라이싱 축은 값 하나를 고르는 일인데 셰이더는 여러 장을
# 순서대로 쌓고, 조합마다 비용이 곱으로 늘고, 칸마다 손잡이가 따로 있다. 그걸
# 런처의 한 줄짜리 항목 계약에 우겨넣다가 플러그인이 갈래 이름·탭 곱셈·체인
# 동사를 전부 알게 됐고, "이 파일은 축이 뭔지 모른다"는 자기 머리말과 어긋났다.
#
# DMS 에 남은 것은 여는 단추와 탈출구다(../modules/nixos/dms).
#
# ── 껍데기가 하는 일은 셋뿐이다 ───────────────────────────────────────────
# 창 자체는 QML 이고 ~/.config/rice-studio 에 시드된다(../modules/nixos/hyprland).
# 다른 라이싱 파일과 같은 자리·같은 규칙이라 rebuild 없이 고쳐진다.
#
#   1. RICE_APPS 로 스크립트가 어디 있는지 알려 준다. QML 이 경로를 짐작하지
#      않아야 `nix run .#rice-studio` 로 띄웠을 때 스토어 쪽 스크립트를 부른다.
#   2. -n 으로 두 번 안 뜨게 한다.
#   3. 없으면 왜 없는지 말해 준다.

here="$(cd "$(dirname "$0")" && pwd)"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
studio="${RICE_STUDIO:-$cfg/rice-studio}"

RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

if ! command -v quickshell >/dev/null 2>&1; then
	printf "${RED}quickshell 이 없다.${NC}\n" >&2
	printf "${DIM}이 창은 DMS 와 같은 툴킷으로 돌아간다 — 하이프랜드나 니리 세션이 있는 머신이면 이미 깔려 있다.${NC}\n" >&2
	exit 1
fi

if [ ! -f "$studio/shell.qml" ]; then
	printf "${RED}%s 가 없다. 한 번 rebuild 하면 시드된다 (apps/build-switch).${NC}\n" "$studio" >&2
	exit 1
fi

# 셰이더를 거는 것은 하이프랜드에서만 된다. 다만 값 맞추기와 합성 검증은 어디서나
# 되므로 여기서 막지 않는다 — 창이 그 사정을 머리에 적어서 뜬다.
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	printf "${DIM}하이프랜드 세션이 아니다 — 값은 고칠 수 있지만 화면에 거는 것은 안 된다.${NC}\n" >&2
fi

# -n: 이미 같은 설정이 돌고 있으면 그냥 나간다. 바 조각을 여러 번 눌러도 창이
# 하나만 뜬다.
RICE_APPS="$here" exec quickshell -n -p "$studio"
