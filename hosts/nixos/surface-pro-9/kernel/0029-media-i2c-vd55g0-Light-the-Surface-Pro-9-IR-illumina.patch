From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Sun, 22 Nov 2026 02:57:02 +0900
Subject: [PATCH] media: i2c: vd55g0: Light the Surface Pro 9 IR illuminator,
 use 10-bit output

Measured on the Surface Pro 9 (IPU6, CSI-2 port 3, one lane):

- 8-bit output (Y8/SGRBG8) arrives truncated in about 90 % of the frames
  ("Transfer FIFO overflow", ISYS error STR2MMIO), at any frame size and
  frame rate; 10-bit output arrives intact. Without a device tree, offer
  only the 10-bit codes and default to Y10.
- The IR illuminator is on sensor GPIO 1. In strobe mode it stops lighting
  once the exposure exceeds about 65 % of the frame, so the exposure range
  is limited to 60 % of the frame while the strobe is on.
- The sensor's AE runs the exposure up to the frame length, which turns the
  illuminator off in a dark room. On the Surface Pro 9 start in manual
  exposure with the strobe on (exposure 1000 lines, analogue gain 16), so
  that libcamera controls exposure and gain within the range.

A led_gpio module parameter selects another GPIO on ACPI systems.

Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
 drivers/media/i2c/vd55g0.c | 104 ++++++++++++++++++++++++++++++++-----
 1 file changed, 92 insertions(+), 12 deletions(-)

diff --git a/drivers/media/i2c/vd55g0.c b/drivers/media/i2c/vd55g0.c
index fdf79210c..afd8183ca 100644
--- a/drivers/media/i2c/vd55g0.c
+++ b/drivers/media/i2c/vd55g0.c
@@ -12,6 +12,7 @@
 #include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/dmi.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/iopoll.h>
@@ -135,7 +136,7 @@
 #define VD55G0_MIN_FRAME_LENGTH				(605 + 76)
 #define VD55G0_FRAME_LENGTH_DEF				1860 /* 60 fps */
 #define VD55G0_TIMEOUT_MS				500
-#define VD55G0_MEDIA_BUS_FMT_DEF			MEDIA_BUS_FMT_Y8_1X8
+#define VD55G0_MEDIA_BUS_FMT_DEF			MEDIA_BUS_FMT_Y10_1X10
 #define VD55G0_DARKCAL_PEDESTAL_DEF			0x40
 #define VD55G0_EXPO_MAX_TERM				64
 #define VD55G0_EXPO_DEF					200
@@ -175,6 +176,10 @@ static const char * const vd55g0_supply_name[] = {
 	"dovdd",
 };
 
+static int led_gpio = -1;
+module_param(led_gpio, int, 0644);
+MODULE_PARM_DESC(led_gpio, "Sensor GPIO (0-3) driving the IR illuminator on ACPI systems, -1 for the platform default");
+
 static const s64 link_freq[] = {
 	/*
 	 * MIPI output freq is 804Mhz / 2, as it uses both rising edge and
@@ -366,6 +371,31 @@ static u8 get_bpp_by_code(__u32 code)
 	return 8;
 }
 
+/*
+ * The IPU6 truncates most 8-bit frames from this sensor (CSI-2 "Transfer
+ * FIFO overflow"); 10-bit frames arrive intact. Without a device tree, only
+ * offer the 10-bit codes.
+ */
+static bool vd55g0_code_usable(struct vd55g0_dev *sensor, unsigned int index)
+{
+	return sensor->i2c_client->dev.of_node ||
+	       vd55g0_supported_codes[index].bpp != 8;
+}
+
+/*
+ * The illuminator stops lighting once the exposure exceeds about 65 % of
+ * the frame (measured on the Surface Pro 9): keep the exposure below 60 %
+ * while the strobe is on.
+ */
+static u32 vd55g0_expo_max(struct vd55g0_dev *sensor)
+{
+	u32 max = sensor->frame_length - VD55G0_EXPO_MAX_TERM;
+
+	if (sensor->flash_en)
+		max = min_t(u32, max, sensor->frame_length * 3 / 5);
+	return max;
+}
+
 static u8 get_data_type_by_code(__u32 code)
 {
 	unsigned int i;
@@ -617,6 +647,21 @@ static int vd55g0_apply_flash(struct vd55g0_dev *sensor)
 {
 	struct vd55g0_gpios *gpios = &sensor->gpios;
 
+	/* ACPI gives no LED wiring: the module parameter can change it at run time */
+	if (!sensor->i2c_client->dev.of_node) {
+		int i;
+
+		for (i = 0; i < VD55G0_NB_GPIOS; i++)
+			if (gpios->leds[i] != ~0)
+				vd55g0_update_gpio_mode(sensor,
+							VD55G0_GPIO_MODE_DISABLED,
+							gpios->leds[i]);
+		if (led_gpio >= 0 && led_gpio < VD55G0_NB_GPIOS) {
+			memset(gpios->leds, ~0, sizeof(gpios->leds));
+			gpios->leds[0] = led_gpio;
+		}
+	}
+
 	enum vd55g0_gpio_modes mode = sensor->flash_en ?
 				      VD55G0_GPIO_MODE_STROBE :
 				      VD55G0_GPIO_MODE_DISABLED;
@@ -825,11 +870,12 @@ static int vd55g0_try_fmt_internal(struct v4l2_subdev *sd,
 	unsigned int index;
 
 	for (index = 0; index < ARRAY_SIZE(vd55g0_supported_codes); index++) {
-		if (vd55g0_supported_codes[index].code == fmt->code)
+		if (vd55g0_supported_codes[index].code == fmt->code &&
+		    vd55g0_code_usable(sensor, index))
 			break;
 	}
 	if (index == ARRAY_SIZE(vd55g0_supported_codes))
-		index = 0;
+		index = 1;	/* Y10 */
 
 	mode = v4l2_find_nearest_size(vd55g0_mode_data,
 				      ARRAY_SIZE(vd55g0_mode_data), width,
@@ -1330,12 +1376,19 @@ static int vd55g0_enum_mbus_code(struct v4l2_subdev *sd,
 				 struct v4l2_subdev_mbus_code_enum *code)
 #endif
 {
-	if (code->index >= ARRAY_SIZE(vd55g0_supported_codes))
-		return -EINVAL;
+	struct vd55g0_dev *sensor = to_vd55g0_dev(sd);
+	unsigned int i, n = 0;
 
-	code->code = vd55g0_supported_codes[code->index].code;
+	for (i = 0; i < ARRAY_SIZE(vd55g0_supported_codes); i++) {
+		if (!vd55g0_code_usable(sensor, i))
+			continue;
+		if (n++ == code->index) {
+			code->code = vd55g0_supported_codes[i].code;
+			return 0;
+		}
+	}
 
-	return 0;
+	return -EINVAL;
 }
 
 #if KERNEL_VERSION(5, 14, 0) > LINUX_VERSION_CODE
@@ -1430,7 +1483,7 @@ static int vd55g0_set_fmt(struct v4l2_subdev *sd,
 					 1, sensor->vblank);
 		__v4l2_ctrl_s_ctrl(sensor->vblank_ctrl, sensor->vblank);
 		/* Max exposure changes with vblank */
-		expo_max = sensor->frame_length - VD55G0_EXPO_MAX_TERM;
+		expo_max = vd55g0_expo_max(sensor);
 		__v4l2_ctrl_modify_range(sensor->expo_ctrl, 0, expo_max, 1,
 					 VD55G0_EXPO_DEF);
 		/* Update hblank according to new width */
@@ -1597,7 +1650,7 @@ static int vd55g0_s_ctrl(struct v4l2_ctrl *ctrl)
 	case V4L2_CID_VBLANK:
 		ret = vd55g0_update_vblank(sensor, ctrl->val);
 		/* Max exposure changes with vblank */
-		expo_max = sensor->frame_length - VD55G0_EXPO_MAX_TERM;
+		expo_max = vd55g0_expo_max(sensor);
 		__v4l2_ctrl_modify_range(sensor->expo_ctrl, 0, expo_max, 1,
 					 VD55G0_EXPO_DEF);
 		break;
@@ -1618,6 +1671,10 @@ static int vd55g0_s_ctrl(struct v4l2_ctrl *ctrl)
 		break;
 	case V4L2_CID_FLASH_LED_MODE:
 		ret = vd55g0_update_flash(sensor, ctrl->val);
+		/* The illuminator limits the exposure */
+		__v4l2_ctrl_modify_range(sensor->expo_ctrl, 0,
+					 vd55g0_expo_max(sensor), 1,
+					 VD55G0_EXPO_DEF);
 		break;
 	default:
 		ret = -EINVAL;
@@ -1730,8 +1787,9 @@ static int vd55g0_init_controls(struct vd55g0_dev *sensor)
 						  NULL);
 	sensor->expo_ctrl =
 		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 0,
-				  sensor->frame_length - VD55G0_EXPO_MAX_TERM,
-				  1, sensor->manual_expo);
+				  vd55g0_expo_max(sensor), 1,
+				  min_t(u32, sensor->manual_expo,
+					vd55g0_expo_max(sensor)));
 
 	if (hdl->error) {
 		ret = hdl->error;
@@ -1972,7 +2030,7 @@ static int vd55g0_probe(struct i2c_client *client)
 
 	sensor->i2c_client = client;
 	sensor->streaming = false;
-	sensor->fmt.code = MEDIA_BUS_FMT_SGBRG8_1X8;
+	sensor->fmt.code = MEDIA_BUS_FMT_Y10_1X10;
 	sensor->fmt.field = V4L2_FIELD_NONE;
 	sensor->fmt.colorspace = V4L2_COLORSPACE_SRGB;
 	sensor->manual_expo = VD55G0_EXPO_DEF;
@@ -2025,6 +2083,28 @@ static int vd55g0_probe(struct i2c_client *client)
 		memset(sensor->gpios.leds, ~0, sizeof(sensor->gpios.leds));
 		memset(sensor->gpios.out_sync, ~0, sizeof(sensor->gpios.out_sync));
 		sensor->gpios.in_sync = ~0;
+		/*
+		 * ACPI gives no LED wiring. The Surface Pro 9 drives its IR
+		 * illuminator from sensor GPIO 1 (measured); strobe it whenever
+		 * the camera streams, as Windows Hello does.
+		 */
+		if (dmi_match(DMI_SYS_VENDOR, "Microsoft Corporation") &&
+		    dmi_match(DMI_PRODUCT_NAME, "Surface Pro 9")) {
+			sensor->gpios.leds[0] = 1;
+			sensor->flash_en = true;
+			/*
+			 * The sensor's own AE runs the exposure up to the
+			 * frame length, past what the illuminator allows:
+			 * start in manual mode so that the host (libcamera)
+			 * sets exposure and gain within the limited range.
+			 */
+			sensor->expo_state = VD55G0_EXP_MANUAL;
+			/* A starting point that shows a lit room (measured) */
+			sensor->manual_expo = 1000;
+			sensor->analog_gain = 16;
+		}
+		if (led_gpio >= 0 && led_gpio < VD55G0_NB_GPIOS)
+			sensor->gpios.leds[0] = led_gpio;
 	}
 
 	ret = vd55g0_tx_from_ep(sensor, handle);
