// amoled — 순검정 배경, 얇은 단색 보더, 그림자·블러 없음, 좁은 갭.
//
// 색은 dms/colors.kdl 이 넣는다. 여기는 형태뿐이다(apps/rice/switch 가 profile.kdl 로 복사).

layout {
    gaps 6

    // 링과 보더를 겹치면 검정 배경에서 테두리가 두 겹으로 보인다.
    border {
        width 1
    }

    focus-ring {
        off
    }

    // OLED 에서 그림자는 검정 위에 검정이라 보이지도 않으면서 합성 비용만 든다.
    shadow {
        off
    }
}

overview {
    backdrop-color "#000000"
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}
