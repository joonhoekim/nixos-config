#!/bin/sh -e
#
# Switch the ghostty look, live.
#
#   apps/rice-term              현재 룩과 목록만 출력
#   apps/rice-term crt          전환
#   apps/rice-term --next       목록 순서대로 다음 것 (키에 바인딩하기 좋다)
#   apps/rice-term off          셰이더 없는 기본 상태로 (탈출구)
#
# 룩 하나 = ~/.config/ghostty/rices/<name>.conf 조각 하나. 고른 조각을
# ~/.config/ghostty/rice.conf 로 복사하면 끝이다 — config 끝의
# `config-file = ?rice.conf` 가 그걸 읽고, ghostty 는 config-file 을 자기를 담은
# 파일보다 *나중에* 읽으므로 조각이 항상 본체를 이긴다.
#
# 반영은 D-Bus 로 reload-config 액션을 보내서 한다. custom-shader 는 런타임에
# 바꿀 수 있는 키라 열려 있는 창 전부에 즉시 적용된다. 손으로 하려면 ctrl+shift+,
# 이고, ghostty 가 안 떠 있으면 다음에 뜰 때 알아서 읽는다.
#
# ── rice-switch 와는 다른 축이다 ──────────────────────────────────────────
# 프로필(amoled/frosted/matugen)은 색과 형태를 정하고, 여기는 터미널 셰이더만
# 정한다. 색은 어차피 ghostty 가 DMS/matugen 이 써 주는 themes/dankcolors 를
# 읽어서 프로필을 따라오므로, 두 축을 엮을 이유가 없다. crt 를 켜 둔 채 프로필만
# 바꿔도 셰이더는 그대로 남는다.

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

# 목록·순환·거절은 apps/rice-switch 와 같은 모양이어야 해서 rice-lib.sh 에 있다.
. "$(dirname "$0")/rice-lib.sh"

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
gt="$cfg/ghostty"
rices="$gt/rices"
live="$gt/rice.conf"

rice_kind="룩"
rice_current_file="$cfg/rice/term"
rice_list() { find "$rices" -maxdepth 1 -name '*.conf' -printf '%f\n' | sed 's/\.conf$//' | sort; }

if [ ! -d "$rices" ]; then
  printf "${RED}%s 가 없다. 한 번 rebuild 하면 시드된다 (apps/build-switch).${NC}\n" "$rices"
  exit 1
fi

# 조각을 읽어 들이는 배선. 시드는 파일이 없을 때만 도므로, 이 줄이 생기기 전부터
# 쓰던 머신에는 안 들어가 있다. 그러면 아래가 전부 성공하고 화면만 안 바뀐다.
rice_ensure_line "$gt/config" "config-file = ?rice.conf" \
  "# apps/rice-term 이 갈아끼우는 룩 조각. 없어도 되도록 ? 를 붙인다."

rice_dispatch "$@"
name="$RICE_NAME"

src="$rices/$name.conf"
[ -f "$src" ] || rice_reject "$name"

# 없는 셰이더 파일을 가리키는 조각은 여기서 잡는다. ghostty 는 그런 경로를 조용히
# 버리고 +validate-config 도 통과시키므로(실측), 오타를 내면 "바꿨는데 아무 일도
# 안 일어났다"가 된다. 경로는 조각 기준 상대이니 $gt 에서 푼다.
missing="$(sed -n 's/^[[:space:]]*custom-shader[[:space:]]*=[[:space:]]*\(..*[^[:space:]]\)[[:space:]]*$/\1/p' "$src" |
  while IFS= read -r p; do
    case "$p" in /*) full="$p" ;; *) full="$gt/$p" ;; esac
    [ -f "$full" ] || printf ' %s' "$p"
  done)"
if [ -n "$missing" ]; then
  printf "${RED}%s 가 없는 셰이더를 가리킨다:${NC}%s\n" "$name" "$missing"
  exit 1
fi

# 되돌릴 자리를 잡아 두고 바꾼다. 조각이 문법적으로 깨져 있으면 ghostty 는 그
# 줄만 버리고 나머지를 살리는데, 그러면 반쯤 적용된 룩이 남는다.
prev="$(mktemp)"
trap 'rm -f "$prev"' EXIT
had_live=0
[ -f "$live" ] && cp "$live" "$prev" && had_live=1
cp "$src" "$live"

if ! out="$(ghostty +validate-config 2>&1)"; then
  printf "${RED}%s 를 넣으니 설정이 유효하지 않다. 되돌린다.${NC}\n" "$name"
  printf '%s\n' "$out" | sed 's/^/  /'
  [ "$had_live" -eq 1 ] && cp "$prev" "$live" || rm -f "$live"
  exit 1
fi

mkdir -p "$(dirname "$rice_current_file")"
printf '%s\n' "$name" > "$rice_current_file"
printf "  ghostty    %s\n" "rice.conf ← rices/$name.conf"

# 떠 있는 ghostty 에 리로드를 시킨다. 안 떠 있으면 이름이 버스에 없어서 실패하는데,
# 그건 정상이다 — 다음에 뜰 때 새 설정을 읽는다.
if gdbus call --session --dest com.mitchellh.ghostty \
     --object-path /com/mitchellh/ghostty \
     --method org.gtk.Actions.Activate reload-config '[]' '{}' >/dev/null 2>&1; then
  printf "${GREEN}터미널 룩 전환: %s${NC}\n" "$name"
else
  printf "${GREEN}터미널 룩 전환: %s${NC} ${DIM}(열려 있는 ghostty 없음 — 다음 실행부터)${NC}\n" "$name"
fi

# 셰이더 컴파일 실패는 설정 에러로 잡히지 않는다. ghostty 문서가 명시하는 대로
# 렌더 스레드에서 로그로만 나가고, 최악의 경우 창이 새까매진다. 그 상태에서도
# 이 스크립트는 다른 터미널이나 런처에서 돌릴 수 있다.
[ "$name" = "off" ] || printf "${DIM}창이 새까매지면: apps/rice-term off${NC}\n"
