#version 300 es
//
// riso.frag — 리소 인쇄. 망점 넷을 각각 다른 각도로 겹쳐 찍는다.
//
// ── 이 셋은 시간을 안 읽는다 ──────────────────────────────────────────────
// ./riso.frag · ./dither.frag · ./paper.frag 셋은 `time` 을 한 번도 안 쓴다.
// 그래서 재그리기가 꺼지고, **정지 화면에서 GPU 를 안 쓴다**(../../README.md
// 「계속 그릴지는 셰이더가 정한다」). 물 셋과 정확히 반대 축이고, 그쪽이
// 어쩔 수 없이 치르던 배터리 값을 여기서는 안 치른다.
//
// 이건 우연이 아니라 고른 것이다. 인쇄물은 움직이지 않는다 — 종이 결도 망점
// 각도도 판 어긋남도 전부 **찍히는 순간 정해져서 그대로 있는 것**이라, 시간을
// 넣을 자리가 애초에 없다. 라이싱에서 "값이 0 인 룩"이 하나쯤 필요하다면
// 이쪽이 맞는 자리다. `crt.frag` 뒤에 겹쳐도 그 파일의 정지 화면 공짜가
// 안 깨진다.
//
// ── 왜 각도를 틀어 놓는가 ─────────────────────────────────────────────────
// 망점 판 넷을 같은 각도로 겹치면 점이 점 위에 정확히 얹혀서, 색이 안 섞이고
// 무늬가 격자로 굳는다. 실제 인쇄에서 C 15° · M 75° · Y 0° · K 45° 를 쓰는 것은
// 그 각도들이 서로 만드는 모아레가 가장 작기 때문이고 — 완전히 없앨 수는 없다,
// 그래서 남은 무늬를 장미꽃(rosette)이라 부르고 그건 결함이 아니라 인쇄물의
// 결로 친다. 이 파일이 흉내 내는 것이 그 결이다.
//
// ── 판 어긋남이 이 룩의 절반이다 ──────────────────────────────────────────
// 리소가 오프셋 인쇄와 다르게 보이는 가장 큰 이유는 **판이 정확히 안 맞는
// 것**이다. 등록이 한두 밀리 어긋나서 색 테두리가 삐져나오고, 그게 싸구려
// 인쇄가 아니라 리소의 성격으로 읽힌다. MISREG 가 0 이면 이 파일은 그냥
// 하프톤이고 리소가 아니다.
//
// ── 겹쳐 쓰기 ─────────────────────────────────────────────────────────────
//   global-shader shaders/print/riso.frag                    인쇄물
//   global-shader shaders/print/riso.frag shaders/cyberpunk/glitch.frag 스캔한 인쇄물이 깨진다
//
// 앞칸에 두는 것이 맞는다. 뒤칸에 두면 앞이 만든 결(스캔라인·블룸)까지 망점으로
// 다시 찍혀서 무엇이 인쇄고 무엇이 화면인지가 섞인다.

precision highp float;

in vec2 v_texcoord;
layout(location = 0) out vec4 fragColor;

uniform sampler2D tex;
uniform vec2 screen_size;

// ── 망점 ──────────────────────────────────────────────────────────────────
// 망점 간격(픽셀). 인쇄의 선수(lpi)에 해당한다. HiDPI 백킹 기준이라 6 이면
// 논리 픽셀로는 3 이고, 그 아래로 내리면 점이 한 픽셀보다 작아져서 아래
// fwidth 안티에일리어싱이 다 먹어 치운다 — 하프톤이 아니라 그냥 흐린 원본이 된다.
#define DOT_PX      7.0               // @3..24

// 점의 최대 반지름(칸 기준). 0.71 이면 대각으로 이웃 점과 딱 붙는다. 그보다
// 키우면 진한 부분에서 점들이 겹쳐 뭉개지는데, 실제 인쇄에서도 그렇게 되고
// 그걸 도트 게인이라 부른다. 기본값은 붙기 직전이다.
#define DOT_MAX     0.68              // @0.3..0.9

// ── 판 어긋남 ─────────────────────────────────────────────────────────────
// 판마다 엇나가는 폭(픽셀). 위 머리말대로 이 값이 이 파일을 리소로 만든다.
// 3 을 넘기면 색이 겹치는 자리가 줄어서 회색이 회색으로 안 보이기 시작한다.
#define MISREG      1.4               // @0..6:0.1

// ── 잉크와 종이 ───────────────────────────────────────────────────────────
// 원본과 섞는 비율. 1 이면 완전히 인쇄물, 0 이면 원본 그대로. 0.85 인 것은
// 잔글씨 때문이다 — 본문 글씨가 망점 간격보다 얇으면 점 사이로 빠져서
// 사라지는데, 원본을 조금 남겨 두면 획이 흐리게라도 남는다.
#define INK         0.85              // @0..1

// 종이의 밝기. 1 이면 순백이고, 조금 낮춰야 종이로 보인다.
#define PAPER       0.94              // @0.6..1

// 종이의 따뜻한 기. 순수한 회색 종이는 인쇄물로 안 읽힌다.
#define PAPER_WARM  vec3(1.00, 0.985, 0.95)

// 잉크 색. 공정 CMYK 보다 채도가 높다 — 리소 잉크는 별색이라 실제로 그렇다.
// 각 vec3 는 "이 잉크가 100% 덮인 자리에서 종이 색에 곱해질 값"이다.
#define INK_C       vec3(0.05, 0.62, 0.92)
#define INK_M       vec3(0.95, 0.10, 0.52)
#define INK_Y       vec3(1.00, 0.90, 0.05)
#define INK_K       vec3(0.12, 0.12, 0.14)

// ── 종이 결 ───────────────────────────────────────────────────────────────
// 종이 섬유의 얼룩. 시간이 안 들어가므로 화면 자리마다 고정이다 — 종이가
// 화면에 붙어 있는 셈이고, 그게 맞는 뜻이다.
#define GRAIN       0.05              // @0..0.25


// 좌표를 돌린다. mat2 의 열 우선 규약에서 부호를 틀리기 쉬워서 내적 둘로 쓴다
// (../water/river.frag 의 같은 판단).
vec2 rot(vec2 p, float a) {
    float c = cos(a), s = sin(a);
    return vec2(dot(p, vec2(c, -s)), dot(p, vec2(s, c)));
}

float hash21(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

// 한 판의 덮임. 각도 a 로 돌린 격자에서, 잉크 농도 v 만큼 큰 점을 찍는다.
//
// 반지름을 sqrt(v) 로 잡는 것이 핵심이다. 눈에 보이는 것은 점의 **넓이**라
// 반지름에 비례시키면 중간톤이 통째로 어두워진다.
//
// fwidth 로 가장자리를 부드럽게 하는 것은 선택이 아니다. 백킹 해상도에서 점
// 하나가 몇 픽셀뿐이라, 하드 컷이면 격자 전체가 프레임마다 자글거린다
// (../crt/crt.frag 의 stripes() 가 같은 이유로 fwidth 를 쓴다).
float plate(vec2 pix, float a, float v, vec2 nudge) {
    vec2  q = rot(pix + nudge, a) / DOT_PX;
    float d = length(fract(q) - 0.5);
    float r = sqrt(clamp(v, 0.0, 1.0)) * DOT_MAX;
    float w = max(fwidth(d), 1e-4);
    return smoothstep(r + w, r - w, d);
}

void main() {
    vec2 uv  = v_texcoord;
    vec2 pix = uv * screen_size;

    vec3 src = texture(tex, uv).rgb;

    // RGB → CMYK. K 를 빼내야 어두운 곳에서 잉크 셋이 다 진해지는 것을 막는다 —
    // 실제 인쇄에서 검정 판을 따로 두는 이유와 같다.
    float k   = 1.0 - max(src.r, max(src.g, src.b));
    vec3  cmy = (1.0 - src - k) / max(1.0 - k, 1e-3);

    // 판마다 다른 방향으로 엇나간다. 같은 방향으로 밀면 넷이 통째로 움직인
    // 셈이라 어긋남이 안 보인다.
    vec2 s = MISREG * vec2(1.0, 1.0);
    float pc = plate(pix,  0.2618, cmy.x, s * vec2( 1.0,  0.3));   // 15°
    float pm = plate(pix,  1.3090, cmy.y, s * vec2(-0.7,  0.7));   // 75°
    float py = plate(pix,  0.0,    cmy.z, s * vec2( 0.2, -1.0));   // 0°
    float pk = plate(pix,  0.7854, k,     vec2(0.0));              // 45° — 기준 판

    // 종이 위에 잉크를 곱해서 쌓는다. 더하기가 아니라 곱하기인 것이 인쇄다 —
    // 잉크는 빛을 내지 않고 빼기만 한다.
    vec3 col = PAPER * PAPER_WARM;
    col *= mix(vec3(1.0), INK_C, pc);
    col *= mix(vec3(1.0), INK_M, pm);
    col *= mix(vec3(1.0), INK_Y, py);
    col *= mix(vec3(1.0), INK_K, pk);

    // 종이 결. 자리마다 고정이라 화면이 안 바뀌면 이것도 안 바뀐다.
    col *= 1.0 - GRAIN * hash21(floor(pix));

    col = mix(src, col, INK);

    fragColor = vec4(col, 1.0);
}
