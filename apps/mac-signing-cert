#!/bin/sh -e
#
# 이 기계에서 쓸 코드 서명 신원을 하나 만든다. macOS 전용.
#
#   apps/mac-signing-cert              만든다 (이미 있으면 그대로 둔다)
#   apps/mac-signing-cert --status     지금 상태
#   apps/mac-signing-cert sign <경로>  그 .app 을 이 신원으로 다시 서명한다
#   apps/mac-signing-cert --remove     지운다
#
# 임의 서명이면 TCC 허가가 cdhash 에 묶여 재빌드마다 조용히 끊긴다. 인증서로 서명하면 허가는 기계당 한 번이다.
# 개인키가 딸려서 선언형(/nix/store)으로 두지 않는다. 전체 그림: docs/03-operating-on-macos.md

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

if [ "$(uname -s)" != "Darwin" ]; then
  printf "${RED}macOS 전용이다.${NC}\n"
  exit 1
fi

# 앱마다 만들지 않고 하나를 나눠 쓴다: 신원이 늘수록 재승인할 조합만 는다.
# 기본 이름에 계정 이름이 들어가고 키체인에서 이 문자열로 찾으므로, 기존 인증서가 있으면 MAC_SIGN_ID 로 그 이름을 준다.
CN="${MAC_SIGN_ID:-$(id -un) local codesign}"
KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"

exists() { security find-certificate -c "$CN" >/dev/null 2>&1; }

show_status() {
  if exists; then
    printf "신원: ${GREEN}%s${NC}\n" "$CN"
    security find-identity -p codesigning 2>/dev/null \
      | sed -n "s/.*\([0-9A-F]\{40\}\) \"$CN\"/  지문 \1/p" | head -1
  else
    printf "신원: ${YELLOW}없다${NC} (%s)\n" "$CN"
    printf "${DIM}  apps/mac-signing-cert 로 만든다.${NC}\n"
  fi
}

# ── sign: 남의 install.sh 가 임의 서명으로 끝내는 앱을 이 신원으로 다시 서명해 TCC 허가가 재빌드를 견디게 한다.
if [ "${1:-}" = "sign" ]; then
  app="${2:-}"
  if [ -z "$app" ] || [ ! -d "$app" ]; then
    printf "${RED}사용법: apps/mac-signing-cert sign /Applications/Foo.app${NC}\n"
    exit 1
  fi
  if ! exists; then
    printf "${RED}신원이 없다. 먼저 apps/mac-signing-cert 를 돌려라.${NC}\n"
    exit 1
  fi
  # 안쪽 코드(프레임워크·헬퍼)는 안쪽부터 서명해야 한다. 조용히 반쪽 서명이 되느니 말해 준다.
  if [ -d "$app/Contents/Frameworks" ] || [ -d "$app/Contents/XPCServices" ]; then
    printf "${YELLOW}안쪽에 코드가 더 있다. --deep 이 필요할 수 있다.${NC}\n"
  fi
  codesign --force --sign "$CN" --timestamp=none "$app"
  printf "${GREEN}다시 서명했다${NC} %s\n" "$app"
  codesign -d -r- "$app" 2>&1 | sed -n 's/^#* *designated => /  요구사항 /p'
  printf "\n"
  printf "${YELLOW}서명이 바뀌었으므로 이 앱의 TCC 허가는 한 번 다시 줘야 한다.${NC}\n"
  printf "${DIM}  tccutil reset <서비스> <bundle id>   후 앱을 다시 띄운다${NC}\n"
  printf "${DIM}  서비스: Accessibility · ScreenCapture · ListenEvent 등${NC}\n"
  exit 0
fi

if [ "${1:-}" = "--status" ]; then
  show_status
  exit 0
fi

if [ "${1:-}" = "--remove" ]; then
  if ! exists; then
    printf "${YELLOW}그런 인증서가 없다: %s${NC}\n" "$CN"
    exit 0
  fi
  security delete-certificate -c "$CN" "$KEYCHAIN"
  printf "${GREEN}지웠다${NC} %s\n" "$CN"
  printf "\n"
  printf "${YELLOW}이 신원으로 서명한 앱들은 다음 빌드부터 임의 서명으로 돌아간다.${NC}\n"
  printf "${DIM}  곧 재빌드마다 권한을 다시 줘야 하는 상태가 된다.${NC}\n"
  exit 0
fi

if exists; then
  printf "${GREEN}이미 있다${NC}\n"
  show_status
  printf "\n${DIM}다시 만들려면 먼저 --remove.${NC}\n"
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT INT TERM

# 확장은 설정 파일로 넘긴다. -addext 플래그는 macOS 가 들고 있는 LibreSSL 에서
# 안 먹는 판이 있어서, 두 구현에서 다 도는 이 길을 쓴다.
cat > "$tmp/openssl.cnf" <<EOF
[ req ]
distinguished_name = dn
x509_extensions    = ext
prompt             = no

[ dn ]
CN = $CN

[ ext ]
basicConstraints = critical,CA:FALSE
keyUsage         = critical,digitalSignature
# 이게 있어야 codesign 이 이 인증서를 서명에 쓸 물건으로 알아본다.
extendedKeyUsage = critical,codeSigning
EOF

printf "인증서를 만든다: ${GREEN}%s${NC}\n" "$CN"
openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
  -config "$tmp/openssl.cnf" -keyout "$tmp/key.pem" -out "$tmp/cert.pem" 2>/dev/null

# 인증서와 개인키를 따로 넣는다. p12 는 OpenSSL 3 과 LibreSSL 의 기본 암호화가 달라 -legacy 유무로 갈린다.
# -T /usr/bin/codesign: codesign 이 이 키를 쓸 때 매번 묻지 않게 미리 허용한다.
printf "키체인에 넣는다\n"
security import "$tmp/cert.pem" -k "$KEYCHAIN" -T /usr/bin/codesign >/dev/null
security import "$tmp/key.pem"  -k "$KEYCHAIN" -T /usr/bin/codesign >/dev/null

# 코드 서명 용도로만 신뢰한다. GUI 암호 창이 한 번 뜬다. 실패해도 서명은 되므로(필요한 것은 같은 인증서라는 사실) 멈추지 않는다.
printf "코드 서명 용도로 신뢰 표시 ${DIM}(암호를 한 번 묻는다)${NC}\n"
if security add-trusted-cert -r trustRoot -p codeSign -k "$KEYCHAIN" "$tmp/cert.pem" 2>/dev/null; then
  printf "  ${GREEN}됐다${NC}\n"
else
  printf "  ${YELLOW}건너뛴다${NC} ${DIM}(서명에는 지장 없다)${NC}\n"
fi

printf "\n"
show_status
printf "\n"
printf "이 신원을 쓰는 것:\n"
printf "  ${DIM}global-shader${NC}  build.sh 가 알아서 집는다 (GS_SIGN_ID 로 덮을 수 있다)\n"
printf "\n"
printf "${YELLOW}각 앱마다 TCC 허가를 한 번씩 다시 줘야 한다.${NC} 옛 허가는 옛 서명에 묶여 있다.\n"
printf "${DIM}  tccutil reset ScreenCapture dev.jh.global-shader${NC}\n"
printf "${DIM}  그 다음부터는 몇 번을 다시 빌드해도 안 묻는다.${NC}\n"
