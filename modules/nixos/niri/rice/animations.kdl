// niri 창 열림/닫힘을 브라운관 전원처럼. config.kdl 이 optional 로 include 한다.
//
// 니리는 애니메이션 안에서만 셰이더를 받는다(26.04 에 화면 전체 훅 없음). open_color/close_color 만 정의한다.
// coords_geo 는 픽셀이 아니라 0..1 이다 — 픽셀로 가정하면 마스크가 늘 0 이라 창이 사라진다(실측).
// GLSL ES 1.00, KDL 원시 문자열이라 #define 대신 const. 셰이더 규약 전체: docs/niri.md

animations {
	// 켜짐: 가운데에 가로선이 그어지고(앞 35%), 그 선이 세로로 열린다.
	// 내용은 열린 만큼의 띠 안에 세로로 눌려 들어가 있다가 제 비율을 찾는다.
	window-open {
		duration-ms 260
		curve "linear"
		custom-shader r"
			vec4 open_color(vec3 coords_geo, vec3 size_geo) {
			    const float SPLIT   = 0.35;   // 가로선을 긋는 데 쓰는 앞 구간 비율
			    const float LINE_PX = 1.5;    // 선 두께 절반(논리 픽셀)
			    const float SOFT_PX = 1.0;    // 가장자리 부드러움(논리 픽셀)
			    const float FLASH   = 0.85;   // 인광체 섬광 세기

			    float p = niri_clamped_progress;
			    float pw = clamp(p / SPLIT, 0.0, 1.0);
			    float ph = clamp((p - SPLIT) / (1.0 - SPLIT), 0.0, 1.0);

			    // 둘 다 뒤로 갈수록 느려진다. 선은 튀어나오고 화면은 스르르 열린다.
			    pw = 1.0 - (1.0 - pw) * (1.0 - pw);
			    ph = 1.0 - (1.0 - ph) * (1.0 - ph);

			    // 창 크기가 달라도 선 두께가 같게 보이도록 정규화 좌표로 옮긴다.
			    vec2 sz   = max(size_geo.xy, vec2(1.0));
			    vec2 line = vec2(LINE_PX) / sz;
			    vec2 soft = vec2(SOFT_PX) / sz;

			    vec2 d = abs(coords_geo.xy - 0.5);
			    float halfW = mix(line.x, 0.5, pw);
			    float halfH = mix(line.y, 0.5, ph);

			    // 열린 띠 안에 창 전체를 눌러 넣는다. halfH 가 0.5 면 항등이다.
			    vec2 g = coords_geo.xy;
			    g.y = 0.5 + (g.y - 0.5) * (0.5 / max(halfH, 0.00001));

			    vec4 color = texture2D(niri_tex, (niri_geo_to_tex * vec3(g, 1.0)).st);
			    color *= step(0.0, g.y) * step(g.y, 1.0);

			    float ax = 1.0 - smoothstep(halfW - soft.x, halfW + soft.x, d.x);
			    float ay = 1.0 - smoothstep(halfH - soft.y, halfH + soft.y, d.y);
			    float mask = ax * ay;
			    color *= mask;

			    // 섬광은 선일 때 제일 세고 열리면서 사라진다.
			    float f = FLASH * (1.0 - p) * (1.0 - p) * mask;
			    return color * (1.0 - f) + vec4(f);
			}
		"
	}

	// 꺼짐: 세로로 접혀 선이 되고(앞 55%), 선이 가로로 줄어들어 점이 된다.
	// 마지막에 가운데 점이 잠깐 남았다 사라진다 — 전원 끈 브라운관의 그것.
	window-close {
		duration-ms 220
		curve "linear"
		custom-shader r"
			vec4 close_color(vec3 coords_geo, vec3 size_geo) {
			    const float SPLIT   = 0.55;   // 세로로 접는 데 쓰는 앞 구간 비율
			    const float LINE_PX = 1.5;
			    const float SOFT_PX = 1.0;
			    const float FLASH   = 0.9;

			    float p = niri_clamped_progress;
			    float ph = clamp(p / SPLIT, 0.0, 1.0);
			    float pw = clamp((p - SPLIT) / (1.0 - SPLIT), 0.0, 1.0);

			    ph = 1.0 - (1.0 - ph) * (1.0 - ph);
			    pw = 1.0 - (1.0 - pw) * (1.0 - pw);

			    vec2 sz   = max(size_geo.xy, vec2(1.0));
			    vec2 line = vec2(LINE_PX) / sz;
			    vec2 soft = vec2(SOFT_PX) / sz;

			    vec2 d = abs(coords_geo.xy - 0.5);
			    float halfH = mix(0.5, line.y, ph);
			    float halfW = mix(0.5, line.x, pw);

			    vec2 g = coords_geo.xy;
			    g.y = 0.5 + (g.y - 0.5) * (0.5 / max(halfH, 0.00001));

			    vec4 color = texture2D(niri_tex, (niri_geo_to_tex * vec3(g, 1.0)).st);
			    color *= step(0.0, g.y) * step(g.y, 1.0);

			    float ax = 1.0 - smoothstep(halfW - soft.x, halfW + soft.x, d.x);
			    float ay = 1.0 - smoothstep(halfH - soft.y, halfH + soft.y, d.y);
			    float mask = ax * ay;
			    color *= mask;

			    // 접힐수록 밝아지다가, 점만 남는 구간에서 한 번 더 탄다.
			    float f = FLASH * max(ph * 0.5, pw) * mask;
			    color = color * (1.0 - f) + vec4(f);

			    // 그리고 통째로 꺼진다. 점이 사라지는 마지막 15%.
			    return color * (1.0 - smoothstep(0.85, 1.0, p));
			}
		"
	}
}
