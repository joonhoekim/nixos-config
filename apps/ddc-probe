#!/bin/sh -e
#
# 모니터가 DDC/CI 로 **실제로 무엇을 받아들이는지** 눈으로 확인한다.
#
#   apps/ddc-probe                 감지된 디스플레이 목록
#   apps/ddc-probe 1               1 번 디스플레이를 시각 테스트 (기본 항목)
#   apps/ddc-probe 1 --dump        1 번의 VCP 값을 전부 덤프
#   apps/ddc-probe 1 --caps        1 번이 지원한다고 *주장하는* 기능 목록
#   apps/ddc-probe 1 --feature 0A  임의의 VCP 코드 하나를 직접 시험
#
# 되읽기(getvcp)는 모니터가 값을 기억한다는 뜻일 뿐이라 판정은 사람 눈이 한다. 눈으로도 안 변하면
# 모니터 OSD 의 HDR·DCR·다이내믹 명암·에코를 본다(켜져 있으면 수동 밝기가 잠긴다). 전체 그림: docs/ddc-probe.md
# 원래 값을 먼저 읽고 trap 으로 EXIT·INT·TERM 을 잡아 되돌린다. 없으면 밝기 0 에서 죽을 때 화면이 깜깜하게 남는다.
# /dev/i2c-* 는 hardware.i2c 의 udev uaccess 태그로 좌석 사용자에게 ACL 로 열린다. 원격 SSH 등에서는 DDC_SUDO=1.

DDCUTIL="${DDCUTIL:-ddcutil}"
GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

command -v "$DDCUTIL" >/dev/null 2>&1 || {
	printf "${RED}ddcutil 이 없다.${NC} modules/nixos/packages.nix 에 들어 있어야 한다.\n"
	printf "임시로는: ${DIM}nix shell nixpkgs#ddcutil --command apps/ddc-probe %s${NC}\n" "$*"
	exit 1
}

# uaccess ACL 이 있으면 맨몸으로 되고, 없으면 sudo 로 넘어간다. 판정을 --probe
# 같은 실제 통신으로 하지 않는 것은 그것만으로도 몇 초가 걸리기 때문이다.
ddc() {
	if [ "${DDC_SUDO:-0}" = "1" ]; then
		sudo "$DDCUTIL" "$@"
	else
		"$DDCUTIL" "$@"
	fi
}

# 커넥터 이름(card1-DP-1)까지 보여야 "지금 보고 있는 그 모니터"를 고를 수 있다.
list_displays() {
	# 라벨은 ddcutil 판마다 다르다(DRM connector / DRM_connector). `.` 로 둘 다 받고, 값은
	# 마지막 필드로 집는다(모델 문자열에는 공백이 없다).
	ddc detect --brief 2>/dev/null | awk '
		/^Display /       { n = $2 }
		/I2C bus:/        { split($NF, a, "-"); bus = a[2] }
		/DRM.connector:/  { conn = $NF }
		/Monitor:/        { mon = $NF }
		/^$/              { if (n) printf "%s\t%s\t%s\t%s\n", n, bus, conn, mon; n = "" }
		END               { if (n) printf "%s\t%s\t%s\t%s\n", n, bus, conn, mon }
	'
}

show_displays() {
	_found="$(list_displays)"
	if [ -z "$_found" ]; then
		printf "  ${RED}없다.${NC} ${DIM}DDC/CI 를 지원하지 않거나, 모니터 OSD 에서 꺼져 있거나,\n"
		printf "  /dev/i2c-* 에 접근할 수 없는 경우다 (DDC_SUDO=1 로 다시 해 볼 것).${NC}\n"
		return 0
	fi
	printf '%s\n' "$_found" | while IFS="$(printf '\t')" read -r n bus conn mon; do
		printf "  ${GREEN}%s${NC}  bus ${YELLOW}i2c-%-3s${NC} %-14s %s\n" "$n" "$bus" "$conn" "$mon"
	done
}

bus_for() { # bus_for <display-number>
	list_displays | awk -F"$(printf '\t')" -v want="$1" '$1 == want { print $2; found = 1 } END { exit !found }'
}

# 현재값 읽기 → 시험값 쓰기 → **걸어 둔 채로** 질문 → 복구. 먼저 되돌리고 물으면 기억에 의존해 답이 흔들린다.
# --noverify: ddcutil 의 쓰기 뒤 되읽기 확인이 값은 들어간 채로 DDCRC_VERIFY 를 낼 수 있다(40LGD5K 실측, docs/ddc-probe.md).
# 그래서 쓰기가 오류를 내도 복구는 반드시 한다. 오류가 "안 들어갔다"는 뜻이 아니다.
RESULTS=""
probe_feature() { # probe_feature <bus> <code> <이름> <시험값>
	_bus="$1"; _code="$2"; _label="$3"; _test="$4"

	_cur="$(ddc getvcp "$_code" --bus "$_bus" 2>/dev/null |
		sed -n 's/.*current value = *\([0-9]*\).*/\1/p')"
	if [ -z "$_cur" ]; then
		printf "  ${DIM}0x%s (%s): 연속값으로 안 읽힌다 — 건너뛴다${NC}\n" "$_code" "$_label"
		RESULTS="${RESULTS}0x${_code}\t${_label}\t읽기실패\n"
		return 0
	fi

	printf "\n  0x%s (%s): 현재 %s ${YELLOW}-> %s${NC} 로 바꾼다\n" "$_code" "$_label" "$_cur" "$_test"
	RESTORE_BUS="$_bus"; RESTORE_CODE="$_code"; RESTORE_VAL="$_cur"
	_note=""
	if ! ddc setvcp "$_code" "$_test" --bus "$_bus" --noverify >/dev/null 2>&1; then
		_note=" ${DIM}(쓰기가 오류를 냈다)${NC}"
		printf "  ${YELLOW}쓰기가 오류를 반환했다 — 그래도 들어갔을 수 있으니 화면을 본다.${NC}\n"
	fi

	printf "  ${GREEN}화면을 보세요.${NC} 지금 눈에 띄게 변했습니까? [y/N] "
	# /dev/tty 를 실제로 열어 보고, 안 되면(CI·훅·에이전트) stdin, 둘 다 안 되면 "안 변했다" 로 친다.
	# `[ -r /dev/tty ]` 는 제어 터미널이 없어도 통과하고 open 만 ENXIO 로 실패한다. 열어 보기는 서브셸에서 한다:
	# `: </dev/tty` 는 특수 내장이라 리다이렉션 실패가 if 조건 안에서도 비대화형 셸을 끝낸다(POSIX).
	if (: </dev/tty) 2>/dev/null; then
		read -r ans </dev/tty || ans=""
	else
		read -r ans || ans=""
	fi

	ddc setvcp "$_code" "$_cur" --bus "$_bus" --noverify >/dev/null 2>&1 || true
	RESTORE_CODE=""
	printf "  ${DIM}%s 로 복구${NC}\n" "$_cur"

	case "$ans" in
	y | Y | yes)
		RESULTS="${RESULTS}0x${_code}\t${_label}\t${GREEN}실제로 먹는다${NC}${_note}\n" ;;
	*)
		RESULTS="${RESULTS}0x${_code}\t${_label}\t${RED}값만 받고 무시${NC}${_note}\n" ;;
	esac
}

# `[ ... ] && printf` 로 쓰면 마지막 줄의 거짓이 루프 종료값이 되어 set -e 가 뒤의 안내문 전에 스크립트를 끝낸다.
show_results() {
	printf '%b' "$RESULTS" | while IFS="$(printf '\t')" read -r c l r; do
		if [ -n "$c" ]; then printf "  %-6s %-16s %b\n" "$c" "$l" "$r"; fi
	done
}

# 질문 도중에 죽어도 걸어 둔 값을 되돌린다. 되돌릴 게 없으면 아무 일도 안 한다.
RESTORE_CODE=""
cleanup() {
	[ -n "$RESTORE_CODE" ] || return 0
	printf "\n${YELLOW}>>> 중단됨. 0x%s 를 %s 로 되돌린다.${NC}\n" "$RESTORE_CODE" "$RESTORE_VAL"
	ddc setvcp "$RESTORE_CODE" "$RESTORE_VAL" --bus "$RESTORE_BUS" --noverify >/dev/null 2>&1 || true
	RESTORE_CODE=""
}
trap cleanup EXIT INT TERM

NUM="${1:-}"
if [ -z "$NUM" ]; then
	printf "감지된 DDC 디스플레이:\n"
	show_displays
	printf "\n${DIM}시각 테스트: apps/ddc-probe <번호>${NC}\n"
	exit 0
fi

BUS="$(bus_for "$NUM")" || {
	printf "${RED}그런 번호의 디스플레이가 없다: %s${NC}\n" "$NUM"
	show_displays
	exit 1
}
shift

case "${1:-}" in
--dump)
	ddc getvcp ALL --bus "$BUS"
	exit 0
	;;
--caps)
	# "주장하는": 여기 없는 코드가 답하기도 하고, 있는 코드가 화면에 반영되지 않기도 한다(docs/ddc-probe.md).
	ddc capabilities --bus "$BUS"
	exit 0
	;;
--feature)
	[ -n "${2:-}" ] || { printf "${RED}--feature 뒤에 VCP 코드가 필요하다 (예: 0A)${NC}\n"; exit 1; }
	probe_feature "$BUS" "$2" "직접 지정" "${3:-10}"
	printf "\n"
	show_results
	exit 0
	;;
"") ;;
*)
	printf "${RED}알 수 없는 옵션: %s${NC}\n" "$1"
	exit 1
	;;
esac

# 명암이 대조군이라 먼저 한다: 명암이 변하면 DDC 쓰기는 통하므로, 밝기가 안 변할 때 "0x10 만 안 이어짐"을 가를 수 있다.
# 밝기는 15 와 0 두 번 본다. 미묘했을 뿐인지 꿈쩍 안 하는지는 결론이 다르다.
printf "\n디스플레이 %s (i2c-%s) 를 시험한다.\n" "$NUM" "$BUS"
printf "${DIM}각 단계는 값을 걸어 둔 채 묻는다. 천천히 보고 답하면 된다.${NC}\n"

probe_feature "$BUS" 12 "명암(대조군)" 10
probe_feature "$BUS" 10 "밝기" 15
probe_feature "$BUS" 10 "밝기(0까지)" 0

printf "\n=== 결과 ===\n"
show_results

printf "\n${DIM}명암은 먹는데 밝기만 안 먹는다면, 다음에 볼 곳은 이 컴퓨터가 아니라
**모니터 OSD** 다. HDR·DCR·다이내믹 명암·에코 중 하나가 켜져 있으면 패널이 수동
밝기를 무시한다 — 40LGD5K 에서 HDR 이 Auto 였던 것이 정확히 그 경우였고, DDC 는
그동안 내내 정상이었다. 펌웨어를 의심하는 건 그 다음이다.${NC}\n"
