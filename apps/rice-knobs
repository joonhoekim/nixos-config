#!/bin/sh -e
#
# 라이싱 값을 밖에서 읽고 쓰는 뒤판. DMS 플러그인의 슬라이더가 이걸 쓴다.
#
#   apps/rice-knobs                        조절 가능한 대상 목록 (JSON)
#   apps/rice-knobs get crt/crt            그 대상의 손잡이 전부 (JSON)
#   apps/rice-knobs set crt/crt CURVE 0.14
#   apps/rice-knobs reset crt/crt [CURVE]  레포 값으로 되돌린다
#
# ── 대상 이름은 셰이더 칸 이름과 같다 ─────────────────────────────────────
# `crt/crt` · `water/still` · `term/glow` — apps/rice-chain 이 칸을 부르는 이름
# 그대로다. 예전에는 `hypr/crt` 처럼 종류를 앞에 붙였는데, 체인이 생기면서 같은
# 것을 두 이름으로 부르게 됐다. 종류는 아래 targets() 의 넷째 열에 그대로 있고,
# 다시 거는 방법을 정하는 데만 쓰인다.
#
# 맥 판은 체인에서 이름이 겹칠 때 `1.BLOOM` 처럼 칸 번호를 앞에 붙인다. 여기서는
# 그럴 일이 없다 — 거기서는 손잡이가 메모리에 있고 두 칸이 같은 이름을 가질 수
# 있지만, 여기서는 손잡이가 파일 안의 `#define` 이라 파일 이름이 곧 유일한
# 주소다. 대신 아래 targets 가 지금 걸린 체인의 **몇째 칸**인지를 같이 준다.
#
# ── 왜 파일을 다시 쓰는가 ─────────────────────────────────────────────────
# 하이프랜드의 스크린 셰이더에는 우리가 넣을 수 있는 유니폼이 없다. 넘어오는 것은
# tex / time / screen_size / pointer_* 뿐이고 그 목록은 컴포지터가 정한다. 그래서
# 값을 바꾸는 유일한 길은 셰이더 안의 #define 을 고치고 다시 거는 것이다.
#
# 다행히 그게 싸다. 하이프랜드는 셰이더를 걸 때마다 파일을 새로 읽으므로
# (apps/rice-crt --reload 이 그 성질을 쓴다) 쓰고 → 다시 걸면 즉시 반영된다.
# 슬라이더를 끄는 동안 이걸 초당 여러 번 하게 되므로, 부르는 쪽에서 디바운스를
# 거는 것을 전제로 한다.
#
# ── 손잡이는 셰이더가 스스로 선언한다 ─────────────────────────────────────
# 어떤 #define 이 손잡이인지, 범위가 얼마인지를 여기 목록으로 들고 있으면 셰이더를
# 고칠 때마다 두 곳이 어긋난다. 대신 값 옆의 주석에 적는다:
#
#   #define CURVE       0.10   // @0..0.3
#   #define BLOOM       0.32   // @0..1:0.01      (선택: 뒤가 눈금)
#
# `@` 가 붙은 것만 손잡이다. BLOOM_TAPS 나 TAU 처럼 슬라이더로 만질 것이 아닌
# 값은 표시를 안 하면 그만이라, 목록 관리가 따로 필요 없다. 새 셰이더를 넣어도
# 이 파일은 안 고친다.
#
# 설명은 #define 바로 위에 붙어 있는 주석 덩어리를 그대로 쓴다. 이 레포의
# 셰이더들은 이미 값마다 왜 그 값인지를 적어 두고 있어서, 따로 쓸 것이 없다.
#
# ── 로컬만 고친다 ─────────────────────────────────────────────────────────
# 쓰는 곳은 언제나 $HOME 쪽이다. 레포는 비교 대상으로만 읽어서 "레포와 다른 값"을
# 표시하고 되돌릴 수 있게 한다. 레포에 넣는 것은 여기가 아니라 apps/rice-save 다 —
# 값이 자리를 잡은 뒤 한 번에, 사람이 판단해서.

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

# 레포 경로. rice-save 와 달리 cwd 를 못 믿는다 — DMS 안에서 불리기 때문이다.
# $0 이 있는 곳에서 물어보고(체크아웃에서 부른 경우), 안 되면 관례 경로.
repo="${RICE_REPO:-$(git -C "$(dirname "$0")" rev-parse --show-toplevel 2>/dev/null || echo "$HOME/nixos-config")}"

# ── 대상 ──────────────────────────────────────────────────────────────────
# 한 줄 = <id> <라이브 파일> <레포 파일> <종류>. 종류가 다시 거는 방법을 정한다.
targets() {
	# 갈래 폴더 한 단을 훑는다. 평면이던 것이 열 장을 넘기면서 갈렸고, 이름도
	# `<갈래>/<이름>` 이 됐다 — 셰이더 하나가 어느 갈래인지가 이름에 들어 있어야
	# 슬라이더 목록도 같은 순서로 접힌다.
	for f in "$cfg"/hypr/shaders/*/*.frag "$cfg"/hypr/shaders/*/*.glsl; do
		[ -f "$f" ] || continue
		n="${f#"$cfg"/hypr/shaders/}"
		printf '%s\t%s\t%s\t%s\n' "${n%.*}" "$f" \
			"$repo/modules/nixos/hyprland/rice/shaders/$n" hypr
	done
	for f in "$cfg"/ghostty/shaders/*.glsl; do
		[ -f "$f" ] || continue
		n="${f##*/}"; n="${n%.glsl}"
		printf 'term/%s\t%s\t%s\t%s\n' "$n" "$f" \
			"$repo/modules/shared/ghostty/shaders/$n.glsl" term
	done
}

field() { # field <id> <열번호>
	targets | awk -F'\t' -v id="$1" -v c="$2" '$1 == id { print $c; exit }'
}

# ── 파서 ──────────────────────────────────────────────────────────────────
# 파일 하나에서 손잡이를 뽑아 TSV 로. JSON 을 awk 에서 직접 만들지 않는 건 설명에
# 따옴표와 한글이 들어오기 때문이다 — 조립은 jq 에게 맡긴다.
# `all` 을 주면 표시가 없는 #define 도 이름·값만 뽑는다. 레포 쪽을 읽을 때 쓴다 —
# 아직 표시가 안 붙은 레포 사본에서도 "레포 값"과 되돌리기가 동작해야 한다.
parse() { # parse <파일> [all]
	[ -f "$1" ] || return 0
	awk -v all="${2:-}" '
		# "// ── 형태 ────────" 를 그룹 머리로 읽는다. 셰이더들이 이미 이 모양으로
		# 구역을 나눠 두고 있어서, 슬라이더도 같은 순서로 묶인다.
		/^\/\/[[:space:]]*──/ {
			g = $0
			sub(/^\/\/[[:space:]]*──[[:space:]]*/, "", g)
			sub(/[[:space:]]*─.*$/, "", g)
			group = g; doc = ""; next
		}
		# 붙어 있는 주석 줄은 바로 아래 #define 의 설명이 된다.
		/^\/\// {
			l = $0
			sub(/^\/\/[[:space:]]?/, "", l)
			doc = (doc == "" ? l : doc " " l)
			next
		}
		/^#define[[:space:]]/ {
			ann = ""; rest = ""; mot = 0
			if (match($0, /\/\/[[:space:]]*@[^[:space:]]+/)) {
				ann = substr($0, RSTART, RLENGTH)
				rest = substr($0, RSTART + RLENGTH)
				sub(/^\/\/[[:space:]]*@/, "", ann)

				# `@범위` 뒤에 남은 줄 전체가 설명이고, 거기에 `!motion` 이
				# 섞여 있을 수 있다. 그건 "이 값이 0 이면 흐르는 것이 멈춘다"는
				# 셰이더 자신의 선언이고, apps/rice-chain --motion 이 그걸 보고
				# debug:vfr 을 켤지 말지 정한다. 표시로만 쓰이므로 설명에서는 뺀다.
				if (rest ~ /!motion/) mot = 1
				gsub(/!motion/, "", rest)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", rest)
				if (rest != "") doc = (doc == "" ? rest : doc " " rest)
			}
			# 숫자만 손잡이가 된다. TINT 같은 vec3 을 슬라이더에 태우면
			# 되돌리기가 그 줄을 0.0000 으로 만들어 버린다.
			if ((ann != "" || all != "") && $3 ~ /^-?[0-9]+(\.[0-9]+)?$/) {
				n = split(ann, ps, ":")
				step = (n > 1 ? ps[2] : "")
				split(ps[1], mm, /\.\./)
				printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
					group, $2, $3, mm[1], mm[2], step, doc, mot
			}
			doc = ""; next
		}
		{ doc = "" }
	' "$1"
}

# ── 명령 ──────────────────────────────────────────────────────────────────
case "${1:-}" in
"" | targets)
	# 지금 걸려 있는 것도 같이 준다. 플러그인이 그걸 기본 선택으로 쓴다.
	#
	# 체인이면 칸이 여럿이고 **순서가 뜻을 가진다** — 앞칸의 출력이 뒷칸의 입력
	# 이라 같은 두 셰이더도 순서가 바뀌면 다른 그림이다. 그래서 걸렸는지(applied)
	# 만이 아니라 몇째 칸인지(pass)까지 준다.
	stages=""
	if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
		stages="$("$(dirname "$0")/rice-crt" --stages 2>/dev/null || true)"
	fi
	targets | jq -Rs --arg stages "$stages" '
		($stages | split("\n") | map(select(length > 0))) as $s
		| [ split("\n")[] | select(length > 0) | split("\t")
		    | . as $t
		    | ($s | index($t[0])) as $i
		    | { id: $t[0], file: $t[1], kind: $t[3],
		        applied: ($i != null),
		        pass: (if $i == null then null else $i + 1 end) } ]
		| { targets: ., chain: $s }'
	;;

get)
	id="${2:?대상이 필요하다}"
	live="$(field "$id" 2)"
	[ -n "$live" ] || { printf '그런 대상은 없다: %s\n' "$id" >&2; exit 1; }

	# 레포 값은 비교용이다. 레포가 없거나(스토어에서 실행) 그 파일이 아직
	# 없으면 그냥 비어 있고, 그러면 "레포와 다름" 표시가 안 뜬다.
	parse "$(field "$id" 3)" all | jq -Rs '
		[ split("\n")[] | select(length > 0) | split("\t") | { key: .[1], value: .[2] } ] | from_entries
	' >"${TMPDIR:-/tmp}/rice-knobs-repo.$$"

	parse "$live" | jq -Rs --arg id "$id" --slurpfile repo "${TMPDIR:-/tmp}/rice-knobs-repo.$$" '
		[ split("\n")[] | select(length > 0) | split("\t")
		  | { group: .[0], name: .[1],
		      value: (.[2] | tonumber),
		      min:   (.[3] | tonumber),
		      max:   (.[4] | tonumber),
		      # 기본 눈금은 범위의 1/100. 부동소수 찌꺼기를 그대로 두면 GUI 에
		      # 0.013999999999999999 같은 것이 뜨므로 유효숫자에서 자른다.
		      step:  (if .[5] == "" then (((.[4] | tonumber) - (.[3] | tonumber)) / 100 * 10000 | round) / 10000
		              else (.[5] | tonumber) end),
		      doc:   .[6],
		      # 이 값을 0 으로 내리면 흐르는 것이 멈춘다는 표시. UI 가 이걸
		      # 보여 주면 "왜 이 셰이더는 배터리를 먹나"를 손으로 확인할 수 있다.
		      motion: (.[7] == "1"),
		      repo:  ($repo[0][.[1]] // null | if . == null then null else tonumber end) } ]
		| map(. + { dirty: (.repo != null and (.repo - .value | fabs) > 1e-9) })
		# 그룹은 파일에 나온 순서를 지킨다. 값들이 그렇게 배열돼 있는 데에 이유가
		# 있어서(형태 → 광학 → 줄무늬 → 색), 이름순으로 섞으면 읽기 나빠진다.
		| { target: $id,
		    groups: (reduce .[] as $k ([];
		               if (length > 0 and (.[-1].label == $k.group))
		               then .[0:-1] + [ .[-1] + { knobs: (.[-1].knobs + [$k]) } ]
		               else . + [ { label: $k.group, knobs: [$k] } ] end)) }'
	rm -f "${TMPDIR:-/tmp}/rice-knobs-repo.$$"
	;;

set | reset)
	cmd="$1"
	id="${2:?대상이 필요하다}"
	key="${3:-}"
	live="$(field "$id" 2)"
	[ -n "$live" ] || { printf '그런 대상은 없다: %s\n' "$id" >&2; exit 1; }

	if [ "$cmd" = set ]; then
		[ -n "$key" ] || { printf '이름이 필요하다\n' >&2; exit 1; }
		val="${4:?값이 필요하다}"
		pairs="$key	$val"
		raw=""
	else
		# 되돌릴 값은 레포에서 읽는다. 이름을 주면 그것만, 안 주면 전부.
		pairs="$(parse "$(field "$id" 3)" all |
			awk -F'\t' -v k="$key" '(k == "" || $2 == k) { printf "%s\t%s\n", $2, $3 }')"
		[ -n "$pairs" ] || { printf '레포에서 되돌릴 값을 못 찾았다\n' >&2; exit 1; }
		raw=1
	fi

	tmp="$(mktemp)"
	trap 'rm -f "$tmp"' EXIT
	cp "$live" "$tmp"

	printf '%s\n' "$pairs" | while IFS='	' read -r k v; do
		[ -n "$k" ] || continue
		awk -v k="$k" -v v="$v" -v raw="$raw" '
			$1 == "#define" && $2 == k {
				# 되돌리기는 레포에 적힌 글자를 그대로 쓴다. 0.10 을 0.1 로
				# 정규화해 버리면 값은 같은데 diff 만 남는다.
				if (raw != "")
					s = v
				# 원래 값에 소수점이 있었으면 새 값에도 있어야 한다. GLSL 에서
				# `1` 은 int 라, float 자리에 들어가면 곱셈부터 컴파일이 깨진다.
				else if ($3 ~ /\./) {
					s = sprintf("%.4f", v + 0)
					sub(/0+$/, "", s)
					if (s ~ /\.$/) s = s "0"
				} else
					s = sprintf("%d", v + 0)

				# 뒤에 붙은 주석(범위 표시)은 그대로 옮기고, 열은 매번 같은
				# 자리로 다시 맞춘다. 원래 폭을 기준으로 메우면 값 길이가 바뀔
				# 때마다 조금씩 밀려서 파일이 서서히 지저분해진다.
				tail = $0
				sub(/^#define[[:space:]]+[A-Za-z0-9_]+[[:space:]]+[^[:space:]]+[[:space:]]*/,
				    "", tail)
				# do-while 인 것에 이유가 있다. while 로 두면 이름이 길어서
				# 이미 20 칸을 채운 줄에 공백이 하나도 안 붙고, 값이 이름에
				# 그대로 달라붙는다 — `#define FOCUS_RADIUS0.13`. 컴파일은
				# 깨지는데 원인은 스위처가 아니라 셰이더 쪽으로 보인다.
				# ("#define 뒤에 공백이 없다" + "FOCUS_RADIUS 는 없는 이름이다")
				# 열이 한 칸 밀리는 것은 그 줄에서만이고, 그건 감수한다.
				out = sprintf("#define %s", k)
				do { out = out " " } while (length(out) < 20)
				out = out s
				if (tail != "") {
					do { out = out " " } while (length(out) < 38)
					out = out tail
				}
				print out
				next
			}
			{ print }
		' "$tmp" >"$tmp.new" && mv "$tmp.new" "$tmp"
	done

	cp "$tmp" "$live"

	# ── 다시 걸기 ────────────────────────────────────────────────────────
	# 지금 화면에 걸려 있지 않은 셰이더를 고쳤으면 아무것도 안 한다 — 다음에
	# 고를 때 어차피 새로 읽힌다.
	here="$(dirname "$0")"
	case "$(field "$id" 4)" in
	hypr)
		# 체인의 한 칸일 수도 있으므로 이름 하나를 견주는 게 아니라 칸 목록에서
		# 찾는다. 안 걸린 셰이더를 고쳤으면 아무것도 안 한다 — 다음에 고를 때
		# 어차피 새로 접힌다.
		if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] &&
			"$here/rice-crt" --stages 2>/dev/null | grep -qxF "$id"; then
			"$here/rice-crt" --reload >/dev/null
		fi
		;;
	term)
		# ghostty 는 조각을 다시 넣으면 셰이더까지 새로 읽는다. 지금 룩이 이
		# 셰이더를 안 쓸 수도 있지만, 확인하려면 .conf 를 파싱해야 해서
		# 그냥 한 번 다시 건다 — 같은 것을 다시 거는 건 무해하다.
		t="$("$here/rice-term" --current 2>/dev/null || echo '')"
		[ -n "$t" ] && "$here/rice-term" "$t" >/dev/null 2>&1 || true
		;;
	esac
	;;

*)
	printf '알 수 없는 명령: %s\n' "$1" >&2
	exit 1
	;;
esac
