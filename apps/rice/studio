#!/bin/sh -e
# 라이싱 스튜디오(화면 셰이더 고르기·겹치기·값 맞추기, QML)를 띄운다. 창은 ~/.config/rice-studio 에 시드된다.
# RICE_APPS 로 스크립트 위치를 넘긴다 — QML 이 짐작하면 `nix run .#rice-studio` 에서 스토어 쪽 스크립트를 못 부른다.
# 왜 DMS 플러그인이 아니라 별도 창인지: docs/rice-tools.md

here="$(cd "$(dirname "$0")" && pwd)"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
studio="${RICE_STUDIO:-$cfg/rice-studio}"

RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

if ! command -v quickshell >/dev/null 2>&1; then
	printf "${RED}quickshell 이 없다.${NC}\n" >&2
	printf "${DIM}이 창은 DMS 와 같은 툴킷으로 돌아간다 — 하이프랜드나 니리 세션이 있는 머신이면 이미 깔려 있다.${NC}\n" >&2
	exit 1
fi

if [ ! -f "$studio/shell.qml" ]; then
	printf "${RED}%s 가 없다. 한 번 rebuild 하면 시드된다 (apps/build-switch).${NC}\n" "$studio" >&2
	exit 1
fi

# 값 맞추기와 합성 검증은 세션 없이도 되므로 막지 않는다.
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	printf "${DIM}하이프랜드 세션이 아니다 — 값은 고칠 수 있지만 화면에 거는 것은 안 된다.${NC}\n" >&2
fi

# -n: 이미 같은 설정이 돌고 있으면 그냥 나간다(창이 하나만 뜬다).
RICE_APPS="$here" exec quickshell -n -p "$studio"
