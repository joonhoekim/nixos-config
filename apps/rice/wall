#!/bin/sh -e
# 월페이퍼를 고른다(~/Pictures/Wallpapers 재귀). 적용은 `dms ipc call wallpaper set` 에 맡긴다 —
# session.json 기록이 matugen 재생성을 촉발해 셸·니리 보더·터미널 팔레트가 이 호출 하나로 따라온다.

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

root="${RICE_WALLPAPERS:-$HOME/Pictures/Wallpapers}"

if [ ! -d "$root" ]; then
  printf "${RED}%s 가 없다. RICE_WALLPAPERS 로 다른 경로를 줄 수 있다.${NC}\n" "$root"
  exit 1
fi

# DMS 가 읽을 수 있는 확장자.
candidates() {
  find "$root" -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
       -o -iname '*.webp' -o -iname '*.bmp' \) 2>/dev/null | sort
}

# 경로 전체에 매칭해서 카테고리(walls/<category>/<file>)나 파일명 일부로 걸린다.
filtered() {
  if [ -n "${1:-}" ]; then candidates | grep -i -- "$1" || true
  else candidates
  fi
}

case "${1:-}" in
  --list|-l)
    filtered "${2:-}"
    exit 0
    ;;
  --pick|-p)
    # fuzzel 은 니리 세션의 폴백 런처로 이미 깔려 있다(modules/nixos/niri).
    pick="$(filtered "${2:-}" | fuzzel --dmenu --prompt 'wallpaper> ' || true)"
    [ -z "$pick" ] && { printf "${DIM}취소됨.${NC}\n"; exit 0; }
    ;;
  --yazi|-y)
    # yazi 는 ghostty 에서 kitty 그래픽(TERM_PROGRAM=ghostty → Adapter Kgp)으로 썸네일을 인라인으로 그린다.
    # 키바인드로 부르면 stdin 이 터미널이 아니라서 ghostty 안에서 자신을 다시 돌린다(결과를 주고받지 않게).
    if [ ! -t 0 ]; then
      exec ghostty -e "$0" --yazi "${2:-}"
    fi
    chooser="$(mktemp)"
    trap 'rm -f "$chooser"' EXIT
    # 패턴을 줬으면 그 이름의 디렉터리(대개 카테고리)에서 시작한다.
    start="$root"
    if [ -n "${2:-}" ]; then
      match="$(find "$root" -type d -iname "*$2*" 2>/dev/null | head -1)"
      [ -n "$match" ] && start="$match"
    fi
    yazi --chooser-file="$chooser" "$start"
    pick="$(head -1 "$chooser" 2>/dev/null || true)"
    [ -z "$pick" ] && { printf "${DIM}취소됨.${NC}\n"; exit 0; }
    ;;
  --categories|-c)
    candidates | sed "s|^$root/||" | awk -F/ 'NF>1 { print $(NF-1) }' | sort -u
    exit 0
    ;;
  /*|./*|../*)
    [ -f "$1" ] || { printf "${RED}그런 파일이 없다: %s${NC}\n" "$1"; exit 1; }
    pick="$1"
    ;;
  *)
    # shuf 없이 awk 로 뽑는다 — coreutils 배치를 가정하지 않는다.
    pick="$(filtered "${1:-}" | awk 'BEGIN { srand() } { a[NR] = $0 } END { if (NR) print a[int(rand() * NR) + 1] }')"
    ;;
esac

if [ -z "${pick:-}" ]; then
  printf "${RED}후보가 없다%s.${NC}\n" "${1:+ (패턴: $1)}"
  printf "${DIM}카테고리 목록: apps/rice/wall --categories${NC}\n"
  exit 1
fi

if ! dms ipc call wallpaper set "$pick" >/dev/null 2>&1; then
  printf "${RED}DMS 에 전달하지 못했다. 셸이 떠 있는지 확인: systemctl --user status dms${NC}\n"
  exit 1
fi

printf "${GREEN}월페이퍼:${NC} %s\n" "${pick#"$root"/}"

if [ "$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/rice/current" 2>/dev/null)" = "matugen" ]; then
  printf "${DIM}matugen 프로필이라 셸·니리·터미널 팔레트가 곧 따라온다.${NC}\n"
  # matugen 이 비동기라 팔레트 갱신을 기다렸다 fuzzel 을 다시 만든다. 나머지는 DMS 가 한다.
  "$(dirname "$0")/fuzzel" --wait || true
fi
