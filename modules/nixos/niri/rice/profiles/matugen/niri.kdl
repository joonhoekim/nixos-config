// matugen — 월페이퍼에서 뽑은 색이 주인공이라, 형태는 일부러 중립으로 둔다.
//
// 색은 matugen → dms/colors.kdl 이 넣는다. 보더 2px 는 active-color 가 눈에 들어오게 하려는 것이다.

layout {
    gaps 10

    border {
        width 2
    }

    focus-ring {
        off
    }

    shadow {
        on
        softness 20
        spread 2
        offset x=0 y=4
        color "#00000060"
    }
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}
