#version 300 es
//
// dither.frag — 순서 디더와 팔레트 고정. 게임보이 · 1비트 · 4색.
//
// 시간을 안 읽으므로 재그리기가 꺼진다. 그 축의 사정은 ./riso.frag 머리말에
// 적어 뒀다.
//
// ── 굵은 픽셀이 먼저다 ────────────────────────────────────────────────────
// 이 파일에서 순서를 틀리면 아무 일도 안 일어나는 자리가 하나 있다.
//
// 백킹 해상도가 2940x1912 라, 화면 픽셀 하나에 디더를 걸면 무늬 주기가 논리
// 픽셀의 절반이 된다 — 눈에는 그냥 약간 거칠어진 원본으로 보이고, 팔레트를
// 4색으로 묶어도 멀리서는 원본과 구별이 안 된다. 디더는 **눈이 점을 하나씩
// 셀 수 있을 때만** 디더로 보인다.
//
// 그래서 PIXEL 로 먼저 내린 뒤에 디더와 양자화를 건다. 이 파일은 사실상
// 픽셀화 셰이더 + 디더 셰이더이고, 둘을 나눠 두지 않은 것은 순서가 이렇게밖에
// 될 수 없어서다 — 나눠 두면 체인에서 뒤집어 걸 수 있게 되는데, 뒤집으면
// 안 되는 것을 걸 수 있게 만드는 건 손잡이가 아니라 함정이다.
//
// ── Bayer 를 표로 안 들고 있는 이유 ───────────────────────────────────────
// 8x8 표를 const 배열로 두면 64 개를 주석 없이 늘어놓게 되고, 그 숫자들이 왜
// 그 순서인지는 아무도 안 읽는다. 아래 bayer8() 은 그 표를 **만드는 규칙**을
// 그대로 적은 것이다 — 2x2 를 세 번 겹치는 것이 전부이고, 그러면 왜 그 값인지가
// 코드에 남는다.
//
// ── 겹쳐 쓰기 ─────────────────────────────────────────────────────────────
//   global-shader shaders/print/dither.frag                     게임보이
//   global-shader shaders/cyberpunk/neon.frag shaders/print/dither.frag   네온이 4색으로 뭉친다
//
// 마지막 칸에 두는 것이 맞는다. 뒤에 뭔가 더 오면 애써 묶어 둔 팔레트가 다시
// 풀린다 — 블룸이든 굴절이든 색을 섞는 순간 4색이 4색이 아니게 된다.

precision highp float;

in vec2 v_texcoord;
layout(location = 0) out vec4 fragColor;

uniform sampler2D tex;
uniform vec2 screen_size;

// ── 굵기 ──────────────────────────────────────────────────────────────────
// 한 칸의 크기(백킹 픽셀). 위 머리말대로 이 값이 1 이면 이 셰이더는 아무 일도
// 안 한 것처럼 보인다. 3 이면 논리 픽셀 1.5 칸쯤이라 글자가 겨우 읽히고,
// 6 이면 확실히 게임기 화면이지만 본문은 못 읽는다.
#define PIXEL       4.0               // @1..16:1

// ── 계조 ──────────────────────────────────────────────────────────────────
// 몇 단계로 묶는가. 2 면 1비트(흑백 둘), 4 면 게임보이.
#define LEVELS      4.0               // @2..16:1

// 디더의 세기. 1 이면 표 그대로, 0 이면 디더 없이 그냥 자른다(계단 띠가 생긴다).
// 1 을 넘기면 무늬가 원본보다 세져서 격자 자체가 그림이 된다.
#define DITHER      1.0               // @0..2:0.05

// ── 색 ────────────────────────────────────────────────────────────────────
// 팔레트로 묶는 정도. 0 이면 RGB 를 각각 양자화해서 색이 살아 있고(옛 256색
// 화면 쪽), 1 이면 밝기만 남기고 아래 두 색 사이로 다시 칠한다(게임보이 쪽).
#define MONO        1.0               // @0..1

// 팔레트의 양 끝. 사이는 LEVELS 단계로 이미 묶여 있으므로 두 색만 정하면
// 나머지는 저절로 정해진다 — 4단계면 정확히 4색이 된다.
//
// 기본값은 DMG 게임보이의 그 녹색이다. 다른 팔레트로 바꾸려면 이 두 줄만
// 고치고 저장하면 된다(vec3 는 손잡이가 안 된다 — Sources/Knobs.swift).
//   1비트 호박색  vec3(0.10,0.06,0.02) / vec3(1.00,0.72,0.20)
//   청사진        vec3(0.04,0.09,0.22) / vec3(0.70,0.86,1.00)
#define PAL_LO      vec3(0.06, 0.22, 0.06)
#define PAL_HI      vec3(0.61, 0.74, 0.06)

// 묶기 전에 거는 명암. 계조가 몇 단계뿐이라 원본의 중간톤이 한 칸에 몰리기
// 쉽다 — 조금 벌려 두면 단계가 고르게 쓰인다.
#define CONTRAST    1.15              // @0.5..2.5
#define BRIGHTNESS  1.00              // @0.5..1.8


// Bayer 8x8. 2x2 를 세 번 겹친 것이고, 그 겹치는 규칙이 이 함수다.
//
// 한 단계는 [[0,2],[3,1]] 이다. 다음 단계는 그 각 칸을 다시 넷으로 나눠 같은
// 순서를 넣는 것이라, 비트를 위에서부터 두 칸씩 쌓아 내려가면 그대로 나온다.
//
//   r = (r << 2) | ((x^y) << 1) | y
//
// 2x2 로 맞춰 보면 (0,0)→0 (1,0)→2 (0,1)→3 (1,1)→1 로 위 표와 같다.
// 결과는 0..63 이고 64 로 나눠 0..1 로 쓴다.
float bayer8(ivec2 p) {
    int x = p.x & 7, y = p.y & 7;
    int r = 0;
    for (int i = 2; i >= 0; i--) {
        int xi = (x >> i) & 1;
        int yi = (y >> i) & 1;
        r = (r << 2) | (((xi ^ yi) << 1) | yi);
    }
    return float(r) / 64.0;
}

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    // 칸 번호. 이 값 하나가 색과 디더 문턱 둘 다의 기준이 된다 — 따로 잡으면
    // 칸 안에서 문턱이 변해서 굵은 픽셀 안에 다시 미세한 무늬가 낀다.
    vec2  pix  = v_texcoord * screen_size;
    ivec2 cell = ivec2(floor(pix / PIXEL));

    // 칸 한가운데를 한 번만 읽는다. 평균을 내려면 탭이 여럿 필요한데, 굵은
    // 픽셀에서는 어차피 원본의 잔결이 버려지는 것이 뜻이라 가운데면 족하다.
    vec2 suv = (vec2(cell) + 0.5) * PIXEL / screen_size;
    vec3 src = texture(tex, suv).rgb;

    vec3 c = clamp(pow(max(src, 0.0), vec3(CONTRAST)) * BRIGHTNESS, 0.0, 1.0);

    // 문턱을 -0.5..0.5 로 옮겨서 더한다. 0..1 그대로 더하면 화면 전체가 반 단계
    // 밝아진다.
    float th = (bayer8(cell) - 0.5) * DITHER;

    float n = max(LEVELS - 1.0, 1.0);
    vec3  q = floor(c * n + th + 0.5) / n;
    float g = floor(luma(c) * n + th + 0.5) / n;

    vec3 col = mix(clamp(q, 0.0, 1.0), mix(PAL_LO, PAL_HI, clamp(g, 0.0, 1.0)), MONO);

    fragColor = vec4(col, 1.0);
}
