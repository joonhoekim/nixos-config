#!/bin/sh -e
#
# 창 관리자를 실제로 쓰는 모습을 자동으로 재연한다.
#
#   apps/demo                  시나리오 목록
#   apps/demo incident         그 시나리오를 지금 화면에서 시연
#   apps/demo incident --fast  두 배 빠르게 (--slow 는 그 반대)
#
# 자막의 키(docs/keymap.md)를 누르는 대신 그 키가 설정에서 부르는 액션을 직접 부른다(키 합성은 macOS 접근성 권한이 필요하다).
# 그래서 modules/darwin/rice/rift-grid/config.toml 의 [keys] 나 modules/nixos/hyprland/rice/hyprland.lua 가 바뀌면 여기도 고친다.
# 빈 워크스페이스에서만 돌고, 정리는 창을 닫지 않고 $SENTINEL 을 지워 창 안 루프가 스스로 끝나게 한다. 전체 그림: docs/demo.md

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'
DIM='\033[2m'; BOLD='\033[1m'; NC='\033[0m'

# ── 창 안에서 도는 모드. 터미널이 이 스크립트를 다시 부르므로 시나리오보다 먼저 처리해 무거운 준비를 건너뛴다.

# 살아 있는 동안 참. $SENTINEL 이 사라지면 창 안의 루프가 전부 스스로 끝난다.
alive() { [ -f "$SENTINEL" ]; }

# 통짜 sleep 이면 정리 신호를 받고도 창들이 하나씩 늦게 사라진다.
nap() {
	_n=0
	while [ "$_n" -lt "${1:-10}" ]; do
		alive || exit 0
		sleep 0.1
		_n=$((_n + 1))
	done
}

# 터미널의 --title 류는 -e 로 준 명령이 덮어써서 이스케이프 시퀀스로 직접 세운다. `rift-grid-cli query windows` 에 이 제목이 보인다.
set_title() { printf '\033]0;%s\007' "$1"; }

pane_logs() {
	set_title "logs · staging"
	printf '\033[1;33m staging / api  \033[0m \033[2mjournalctl -fu api\033[0m\n\n'
	_i=0
	while alive; do
		_i=$((_i + 1))
		case $((_i % 7)) in
		3) printf '\033[2m%s\033[0m \033[1;31mERROR\033[0m  POST /v1/orders → 500 (upstream timeout 30s)\n' "$(date +%T)" ;;
		5) printf '\033[2m%s\033[0m \033[1;33mWARN \033[0m  pool exhausted, 32/32 in use, %d waiting\n' "$(date +%T)" "$((_i % 9 + 2))" ;;
		0) printf '\033[2m%s\033[0m \033[1;31mERROR\033[0m  db: connection acquire timed out after 5000ms\n' "$(date +%T)" ;;
		*) printf '\033[2m%s\033[0m INFO   GET /v1/orders/%d → 200 (%dms)\n' "$(date +%T)" "$((_i * 7 % 900 + 100))" "$((_i * 13 % 40 + 8))" ;;
		esac
		nap 6
	done
}

pane_editor() {
	set_title "pool.rs — editor"
	_f="$DEMO_REPO/apps/rice/lib.sh"
	while alive; do
		clear
		printf '\033[1;36m ~/nixos-config/apps/rice/lib.sh \033[0m\n\n'
		if command -v bat >/dev/null 2>&1; then
			bat --style=numbers --color=always --paging=never --line-range=27:60 "$_f" 2>/dev/null
		else
			sed -n '27,60p' "$_f"
		fi
		nap 40
	done
}

pane_tests() {
	set_title "cargo test"
	while alive; do
		clear
		printf '\033[1m cargo test -p api pool \033[0m\n\n'
		nap 8
		printf '   \033[2mCompiling api v0.4.1\033[0m\n'
		nap 10
		printf '   \033[1;32mok\033[0m   pool::acquire_returns_to_pool\n'
		nap 4
		printf '   \033[1;32mok\033[0m   pool::respects_max_size\n'
		nap 4
		printf '   \033[1;31mFAILED\033[0m pool::times_out_when_exhausted\n'
		nap 6
		printf '\n   \033[1;31m2 passed; 1 failed\033[0m\n'
		nap 25
	done
}

pane_git() {
	set_title "git log"
	while alive; do
		clear
		printf '\033[1m git log --oneline --graph -12 \033[0m\n\n'
		git -C "$DEMO_REPO" log --oneline --graph --color=always -12 2>/dev/null | sed 's/^/  /'
		nap 40
	done
}

# 자막 창. 캡션 파일이 바뀌면 다시 그린다. 폰트가 큰 창이라 세 줄이면 꽉 찬다.
pane_narrator() {
	set_title "이 시연이 무엇을 하고 있는가"
	_seen=""
	while alive; do
		if [ -f "$CAPTION" ]; then
			_now="$(cat "$CAPTION" 2>/dev/null)"
			if [ "$_now" != "$_seen" ]; then
				_seen="$_now"
				clear
				# 1행 = 스텝, 2행 = 키, 3행 = 제목, 4행 이하 = 설명
				printf '%s\n' "$_now" | awk '
					NR == 1 { printf "\033[2m%s\033[0m\n\n", $0; next }
					NR == 2 { printf "  \033[1;33m%s\033[0m\n", $0; next }
					NR == 3 { printf "  \033[1m%s\033[0m\n\n", $0; next }
					{ printf "  \033[2m%s\033[0m\n", $0 }
				'
			fi
		fi
		sleep 0.1
	done
}

case "${1:-}" in
--pane)
	SENTINEL="$3"
	CAPTION="$4"
	DEMO_REPO="$5"
	case "$2" in
	logs) pane_logs ;;
	editor) pane_editor ;;
	tests) pane_tests ;;
	git) pane_git ;;
	narrator) pane_narrator ;;
	esac
	exit 0
	;;
esac

# ── 시연을 모는 쪽 ────────────────────────────────────────────────────────────

REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
SPEED=1

case "$(uname)" in
Darwin) WM=rift-grid ;;
*) WM=hypr ;;
esac

usage() {
	printf "${BOLD}시연할 시나리오${NC}\n\n"
	if [ "$WM" = rift-grid ]; then
		printf "  ${GREEN}incident${NC}   스테이징에서 500 이 난 30초 — 창을 벌리고, 합치고, 옆 워크스페이스로 던진다\n"
		printf "  ${GREEN}layouts${NC}    같은 창 넷을 네 가지 레이아웃 모드에 넣어 본다\n"
	else
		printf "  ${GREEN}incident${NC}   스테이징에서 500 이 난 30초 — 창을 벌리고, 합치고, 옆 워크스페이스로 던진다\n"
		printf "  ${GREEN}shell${NC}      같은 창들 위로 DMS 를 불러 본다 — 치트시트·오버뷰·알림·스포트라이트\n"
	fi
	printf "\n"
	printf "  ${DIM}apps/demo incident [--fast|--slow]${NC}\n\n"
	printf "${DIM}나란히 비어 있는 워크스페이스 둘을 빌려 쓰고, 끝나면 열었던 창을 전부 걷어내고\n"
	printf "원래 있던 자리로 돌아온다. 시연 중 아무 때나 Ctrl+C 로 끊어도 같다.${NC}\n"
}

SCENARIO=""
for a in "$@"; do
	case "$a" in
	--fast) SPEED=2 ;;
	--slow) SPEED=0.5 ;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		printf "${RED}모르는 옵션이다: %s${NC}\n" "$a"
		exit 1
		;;
	*) SCENARIO="$a" ;;
	esac
done

[ -n "$SCENARIO" ] || {
	usage
	exit 0
}

_ok=no
[ "$SCENARIO" = incident ] && _ok=yes
[ "$WM" = rift-grid ] && [ "$SCENARIO" = layouts ] && _ok=yes
[ "$WM" = hypr ] && [ "$SCENARIO" = shell ] && _ok=yes
[ "$_ok" = yes ] || {
	printf "${RED}여기서는 그런 시나리오가 없다: %s${NC}\n\n" "$SCENARIO"
	usage
	exit 1
}

command -v jq >/dev/null 2>&1 || {
	printf "${RED}jq 가 없다.${NC} 창 목록을 읽는 데 쓴다.\n"
	exit 1
}

if [ "$WM" = rift-grid ]; then
	command -v rift-grid-cli >/dev/null 2>&1 || {
		printf "${RED}rift-grid-cli 가 없다.${NC} 이 시연은 macOS 의 rift-grid 세션용이다.\n"
		exit 1
	}
	rift-grid-cli query workspaces >/dev/null 2>&1 || {
		printf "${RED}rift-grid 가 응답하지 않는다.${NC} 창 관리자가 떠 있어야 시연할 수 있다.\n"
		exit 1
	}
	WEZTERM="/Applications/WezTerm.app/Contents/MacOS/wezterm"
	[ -x "$WEZTERM" ] || {
		printf "${RED}WezTerm.app 이 없다.${NC} 시연 창을 띄우는 데 쓴다 — 이유는 spawn() 주석에.\n"
		exit 1
	}
else
	# ssh 로 들어와 부르면 이 셋이 비어 hyprctl 은 "no instance", ghostty 는 "no wayland compositor" 로 죽는다.
	[ -n "${XDG_RUNTIME_DIR:-}" ] || XDG_RUNTIME_DIR="/run/user/$(id -u)"
	export XDG_RUNTIME_DIR
	[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || {
		HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
		export HYPRLAND_INSTANCE_SIGNATURE
	}
	[ -n "${WAYLAND_DISPLAY:-}" ] || {
		WAYLAND_DISPLAY="$(basename "$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9] 2>/dev/null | head -1)" 2>/dev/null)"
		export WAYLAND_DISPLAY
	}
	command -v hyprctl >/dev/null 2>&1 || {
		printf "${RED}hyprctl 이 없다.${NC} 이 시연은 하이프랜드 세션용이다.\n"
		exit 1
	}
	hyprctl version >/dev/null 2>&1 || {
		printf "${RED}하이프랜드가 응답하지 않는다.${NC} (HYPRLAND_INSTANCE_SIGNATURE=%s)\n" \
			"${HYPRLAND_INSTANCE_SIGNATURE:-없음}"
		exit 1
	}
	command -v ghostty >/dev/null 2>&1 || {
		printf "${RED}ghostty 가 없다.${NC} 시연 창은 전부 ghostty 다.\n"
		exit 1
	}
	# hyprpicker(hyprshot -z)나 slurp 이 남아 키보드 포커스를 쥐고 있으면 `focus` 가 ok 를 돌려주면서
	# 활성 창이 없는 채라, 시연의 모든 액션이 대상을 못 찾는다.
	if hyprctl layers -j 2>/dev/null | grep -qE '"(hyprpicker|selection)"'; then
		printf "${RED}화면을 잡고 있는 레이어가 있다.${NC} (hyprpicker / slurp)\n"
		printf "${DIM}스크린샷 도구가 남긴 것이다. 정리하고 다시 불러라:${NC}\n"
		printf "${DIM}  pkill hyprpicker; pkill slurp${NC}\n"
		exit 1
	fi
fi

# 창이 하나라도 있는 워크스페이스는 고르지 않는다. 둘이 연달아 비어야 하는 건 Mod+Shift+O 가 창을 옆으로 던지기 때문이다.
# rift-grid 는 0 부터 세는 고정 아홉 칸(디스플레이마다), 하이프랜드는 1 부터이고 창이 없으면 존재하지 않아 1..9 의 여집합에서 찾는다.
# WS_LABEL 은 사람에게 보일 번호(둘 다 1 부터)다.
if [ "$WM" = rift-grid ]; then
	STATE="$(rift-grid-cli query workspaces)"
	HOME_WS="$(printf '%s' "$STATE" | jq -r '.[] | select(.is_active) | .index')"
	DEMO_WS="$(printf '%s' "$STATE" | jq -r '
		[.[] | select(.window_count == 0) | .index] as $free
		| [$free[] | select(. + 1 as $n | $free | index($n))] | first // empty')"
else
	HOME_WS="$(hyprctl activeworkspace -j | jq -r '.id')"
	DEMO_WS="$(hyprctl workspaces -j | jq -r '
		[.[] | select(.windows > 0) | .id] as $busy
		| [range(1; 9) | select(([., . + 1] | map(IN($busy[]))) == [false, false])]
		| first // empty')"
fi

[ -n "$DEMO_WS" ] || {
	printf "${RED}빌릴 자리가 없다.${NC} 시연은 나란히 비어 있는 워크스페이스 두 개가 필요하다.\n"
	printf "${DIM}창이 없는 자리 둘을 이웃하게 만들어 두고 다시 불러라.${NC}\n"
	exit 1
}
NEXT_WS=$((DEMO_WS + 1))
if [ "$WM" = rift-grid ]; then
	WS_LABEL=$((DEMO_WS + 1))
	HOME_LABEL=$((HOME_WS + 1))
else
	WS_LABEL="$DEMO_WS"
	HOME_LABEL="$HOME_WS"
fi

WORK="$(mktemp -d /tmp/wm-demo.XXXXXX)"
SENTINEL="$WORK/alive"
CAPTION="$WORK/caption"
: >"$SENTINEL"
: >"$CAPTION"

STEP=0
TOTAL=0

cleanup() {
	rm -f "$SENTINEL"
	# 창 안 루프는 0.1 초마다 sentinel 을 본다. 창 관리자에게 창을 닫으라고 하지 않는다.
	sleep 0.6
	if [ "$WM" = rift-grid ]; then
		rift-grid-cli execute workspace switch "$HOME_WS" >/dev/null 2>&1 || true
	else
		hyprctl dispatch "hl.dsp.focus({ workspace = $HOME_WS })" >/dev/null 2>&1 || true
	fi
	rm -rf "$WORK"
	printf "\n${DIM}시연 끝. 워크스페이스 %s 로 돌아왔다.${NC}\n" "$HOME_LABEL"
}
trap cleanup EXIT INT TERM

# beat <십분의 일 초> — --fast/--slow 가 여기에만 걸린다
beat() {
	awk -v u="${1:-10}" -v s="$SPEED" 'BEGIN { printf "%.2f", u / 10 / s }' | xargs sleep
}

# say <키> <제목> [설명...] — 자막 창을 갈아 끼우고 터미널에도 같이 남긴다
say() {
	STEP=$((STEP + 1))
	_key="$1"
	_title="$2"
	shift 2
	{
		printf '%s\n' "STEP $STEP / $TOTAL"
		printf '%s\n' "$_key"
		printf '%s\n' "$_title"
		for _l in "$@"; do printf '%s\n' "$_l"; done
	} >"$CAPTION"
	printf "  ${DIM}%2s${NC} ${YELLOW}%-22s${NC} %s\n" "$STEP" "$_key" "$_title"
	# 스크롤링 레이아웃은 띠의 일부만 보여서, 자막 컬럼에 포커스를 주는 것이 그것을 화면 안으로 끌어오는 유일한 방법이다.
	# float 은 안 된다: rift-grid 에서 타일 크기(화면 전체) 그대로 float 이 되고 resize-by 도 XTWINOPS 도 float 창에 먹지 않는다.
	wfocus "$NARRATOR"
	beat 18
}

# ── 백엔드: 창 관리자별로 갈리는 것은 act·spawn·wfocus 셋뿐이다. 셋 다 실패해도 멈추지 않는다
# (창을 띄워 놓은 채 죽는 쪽이 한 스텝 못 도는 것보다 나쁘다).

if [ "$WM" = rift-grid ]; then

	act() { rift-grid-cli execute "$@" >/dev/null 2>&1 || true; }

	# spawn <역할> <가로> <세로> <폰트> [기준창]. 기준창에 먼저 포커스를 준다: 스크롤링 레이아웃은 새 창을 활성 컬럼 옆에
	# 끼우는데 say() 가 자막에 포커스를 두므로, 안 그러면 순서가 뒤집혀 consume 이 오른쪽 이웃을 못 찾고 조용히 헛돈다.
	# macOS 에서 wezterm 인 이유: ghostty 는 `open -na Ghostty.app --args -e` 로만 띄울 수 있고 명령마다 실행 확인 창이 뜬다(docs/demo.md).
	spawn() {
		[ -n "${5:-}" ] && wfocus "$5"
		_before="$(rift-grid-cli query windows | jq -c '[.[].id]')"
		"$WEZTERM" \
			--config "font_size=$4" \
			--config "initial_cols=$2" \
			--config "initial_rows=$3" \
			--config "enable_tab_bar=false" \
			start --always-new-process -- \
			"$SELF" --pane "$1" "$SENTINEL" "$CAPTION" "$REPO" >/dev/null 2>&1 &
		SPAWNED=""
		_n=0
		while [ "$_n" -lt 80 ]; do
			SPAWNED="$(rift-grid-cli query windows |
				jq -c --argjson old "$_before" 'map(.id) - $old | first // empty')"
			[ -n "$SPAWNED" ] && break
			sleep 0.15
			_n=$((_n + 1))
		done
		beat 4
	}

	wfocus() {
		[ -n "$1" ] || return 0
		act window focus --window-id "$1"
		beat 3
	}

else

	# 하이프랜드의 액션은 hl.bind 에 적는 lua 표현식 그대로 `hyprctl dispatch` 에 넘긴다(docs/hyprland-binds.md 의 "확인하는 법").
	# 그래서 아래 문자열은 hyprland.lua 와 글자까지 같다.
	act() { hyprctl dispatch "$1" >/dev/null 2>&1 || true; }

	spawn() {
		[ -n "${5:-}" ] && wfocus "$5"
		_before="$(hyprctl clients -j | jq -c '[.[].address]')"
		# resize-overlay 는 창이 리사이즈될 때마다 한가운데에 "205 x 48" 을
		# 띄운다. 타일러는 창을 쉴 새 없이 리사이즈하므로 시연 내내 떠 있다.
		ghostty \
			--font-size="$4" \
			--window-width="$2" \
			--window-height="$3" \
			--resize-overlay=never \
			-e "$SELF" --pane "$1" "$SENTINEL" "$CAPTION" "$REPO" >/dev/null 2>&1 &
		SPAWNED=""
		_n=0
		while [ "$_n" -lt 80 ]; do
			SPAWNED="$(hyprctl clients -j |
				jq -r --argjson old "$_before" '[.[].address] - $old | first // empty')"
			[ -n "$SPAWNED" ] && break
			sleep 0.15
			_n=$((_n + 1))
		done
		beat 4
	}

	# `focus` 는 방향 키워드가 아니라 셀렉터를 받는다 (hyprland-binds.md).
	wfocus() {
		[ -n "$1" ] || return 0
		act "hl.dsp.focus({ window = \"address:$1\" })"
		beat 3
	}

fi

# 방향 탐색이 아니라 창 id 로 포커스한다. 컬럼이 합쳐지고 갈라져 "왼쪽"이 스텝마다 달라지고, 방향 탐색이
# 자막 창을 집으면 다음 액션(예: Mod+Shift+O)이 자막에 걸린다.
focus_spawned() { wfocus "$SPAWNED"; }

# ── 시나리오 ──────────────────────────────────────────────────────────────────

rift_incident() {
	TOTAL=13

	say "Alt + $WS_LABEL" "빈 워크스페이스로 간다" \
		"시연은 남의 배치를 건드리지 않는다." \
		"창이 하나도 없는 자리만 빌려 쓴다."
	act workspace switch "$DEMO_WS"
	beat 6

	spawn narrator 64 9 24
	NARRATOR="$SPAWNED"
	# 자막 컬럼은 폭 프리셋의 아래 끝(min_column_width_ratio = 0.33)까지 좁힌다. resize 는 포커스한 컬럼에 걸리므로
	# 먼저 포커스를 준다 — 안 그러면 조용히 다른 창이 좁아진다.
	focus_spawned
	act window resize-shrink
	act window resize-shrink
	act window resize-shrink
	beat 6

	say "Alt + Enter" "로그부터 연다" \
