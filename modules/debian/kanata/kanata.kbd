;; Caps Lock 레이어 — Debian(태블릿 tb323fu, subline) 판. 정본은
;; modules/nixos/keyboard.nix 와 modules/nixos/pointer/pointerd.py 이고, 키 배치와
;; 수치는 Windows 판(modules/windows/kanata/kanata.kbd)과 같다.
;;
;;   Caps 탭   Caps Lock 토글
;;   Caps 홀드 [nav]: 오른손 커서(TouchCursor 배치), 왼손 마우스
;;   오른쪽 Alt 한/영 — kanata 가 아니라 subline 의 xkb 옵션이 한다 (아래 defcfg)
;;
;; 시험 실행 (Ctrl+C 로 끝):
;;   kanata --cfg modules/debian/kanata/kanata.kbd
;;
;; 비상 탈출: 왼쪽 Ctrl + Space + Esc 를 함께 누르면 kanata 가 종료된다
;; (kanata 내장, 설정과 무관).

;; 오른쪽 Alt 는 RAlt 그대로 내보낸다. subline 의 keyboard.xkb_options 기본값
;; `korean:ralt_hangul` 이 그것을 Hangul 키심으로 바꾸고, subline 내장 한글이 그
;; 키심을 본다(subline crates/compositor/src/osk.rs). keyd 판처럼 KEY_HANGEUL(122)
;; 을 내보내면 안 된다: `us` 배열에는 <HNGL> 에 키심이 없어서(Hangul 은
;; /usr/share/X11/xkb/symbols/kr 에만 있다) 한/영이 조용히 아무 일도 안 한다.
;; kanata 도 Linux 에서는 KEY_HANGEUL 의 이름이 없다(`kana` 는 KEY_KATAKANAHIRAGANA).
(defcfg
  process-unmapped-keys yes

  ;; 자동 감지는 키 1–115 중 하나라도 있으면 키보드로 잡는다
  ;; (kanata src/oskbd/linux.rs has_keyboard_keys). 이 태블릿에서는 볼륨 키
  ;; (114/115)를 가진 아래 셋이 걸린다. 잡히면 EVIOCGRAB 이 장치째 가져가는데
  ;; kanata 는 키 이벤트만 다시 내보내므로, 이어폰 잭의 SW_HEADPHONE_INSERT 같은
  ;; 스위치 이벤트가 다른 소비자에게 조용히 사라진다. 전원 키는 키 116 뿐이라
  ;; 지금은 안 걸리지만 같은 이유로 막아 둔다. 이름은 /proc/bus/input/devices 의
  ;; N: 값.
  linux-dev-names-exclude (
    "pmic_pwrkey"
    "pmic_resin"
    "gpio-keys"
    "LENOVO-TB323FU Headset Jack"
  )
)

(defsrc)

;; 포인터: kanata 의 틱은 1ms. 10ms 마다 7px = 700 px/s.
;; Shift 저속은 movemouse-speed 로 거리에 14% 를 곱해 1px/10ms = 100 px/s.
;; 배율은 이동을 한 번 보낼 때마다 다시 계산되므로(kanata src/kanata/mod.rs
;; handle_move_mouse) 움직이는 도중에 Shift 를 눌러도 그 자리에서 느려진다.
;;
;; 이동은 kanata uinput 장치의 REL_X/REL_Y 라 subline(libinput)의 포인터 가속을
;; 그대로 탄다. 가속 프로필이 adaptive 면 체감 속도가 위 수치와 어긋난다.
;;
;; 휠: 67ms 마다 한 칸(120) ≈ 15칸/s.
(defalias
  ms↑ (movemouse-up 10 7)
  ms← (movemouse-left 10 7)
  ms↓ (movemouse-down 10 7)
  ms→ (movemouse-right 10 7)

  ;; Shift 는 [nav] 가 아니라 기본 레이어에 건다. Shift 를 Caps 보다 먼저
  ;; 눌렀을 때도 저속이 걸려야 하고, [nav] 밖에서는 움직이는 포인터가 없으니
  ;; 배율은 아무 일도 하지 않는다.
  sl (multi lsft (movemouse-speed 14))
  sr (multi rsft (movemouse-speed 14))

  ;; Shift 가 눌려 있으면 가로 스크롤. Shift 자체도 앱에 그대로 전달된다.
  wq (fork (mwheel-up 67 120) (mwheel-left 67 120) (lsft rsft))
  we (fork (mwheel-down 67 120) (mwheel-right 67 120) (lsft rsft))

  ;; tap-hold-press: 다른 키가 눌리는 순간 홀드로 확정된다. Caps+i 를 빠르게
  ;; 굴려도 i 가 글자로 새지 않는다. 다른 키 없이 200ms 를 넘겨 떼면 아무 일도
  ;; 하지 않는다 (keyd 의 overload 는 이때도 Caps Lock 을 토글한다).
  caps (tap-hold-press 200 200 caps (layer-while-held nav))
)

(deflayermap (base)
  caps @caps
  lsft @sl
  rsft @sr
)

;; 매핑하지 않은 키는 투명이라 Caps 를 누른 채로도 제 글자가 나온다.
(deflayermap (nav)
  ;; 오른손 — 커서. Shift 가 붙어도 그대로 통과해서 선택 확장이 된다.
  i up
  j left
  k down
  l rght
  u home
  o end
  h pgup
  n pgdn
  p bspc
  m del
  y ins
  / C-f

  ;; 왼손 — 마우스
  w @ms↑
  a @ms←
  s @ms↓
  d @ms→
  q @wq
  e @we

  ;; 버튼은 누르고 있는 동안만 눌린다. f 를 잡은 채 wasd 로 드래그.
  f mlft
  8 mlft
  r mrgt
  0 mrgt
  9 mmid
)
