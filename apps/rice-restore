#!/bin/sh -e
#
# Push the repo's ricing files back over the live ones in ~/.config.
#
# apps/rice-save 의 반대 방향이다. 평소에는 이게 필요 없다 — 라이싱은 $HOME 에서
# 하고 레포로 되받는 흐름이고, 그 방향은 rice-save 하나로 끝난다.
#
# 그런데 레포를 먼저 고치는 경우가 있다(다른 머신에서 가져온 커밋, git 에서 되돌린
# 변경, 여기처럼 셰이더를 레포에서 손본 경우). 그때 리빌드는 도움이 안 된다:
# modules/shared/rice-seed-helpers.nix 의 seed 가 `[ -e "$2" ] && return 0` 이라,
# 이미 있는 설정은 절대 안 건드린다. 리싱 도중 리빌드로 저장 안 한 작업이 날아가지
# 않게 하려고 일부러 그렇게 둔 것이라 그쪽을 고칠 수는 없다. 그래서 손으로 cp 하는
# 대신 이 스크립트가 있다.
#
#   apps/rice-restore                 전부
#   apps/rice-restore ghostty niri    고른 것만
#   apps/rice-restore --check         무엇이 덮이는지만 보고 아무것도 안 쓴다
#   apps/rice-restore --yes           확인을 묻지 않는다 (키 바인딩·스크립트용)
#
# 대상은 rice-save 가 저장하는 것과 정확히 같은 집합이다. 한쪽에만 있는 파일이
# 생기면 왕복이 안 맞으므로, 여기를 고칠 일이 생기면 rice-save 도 같이 봐야 한다:
#
#   niri        config.kdl, animations.kdl                          니리 세션
#   profiles    rice/profiles (프로필당 niri.kdl + dms.json)         니리 세션
#   hypr        hyprland.lua, shaders/, chains/                     하이프랜드 세션
#   studio      ~/.config/rice-studio (라이싱 스튜디오 QML)          하이프랜드 세션
#   dms         DankMaterialShell 플러그인 (RiceSwitcher)            두 리눅스 세션
#   ghostty     config, rices/, shaders/                            양쪽
#   fuzzel      fuzzel.ini                                          니리 세션
#   gtk         gtk-3.0 과 gtk-4.0 의 settings.ini (레포엔 파일 하나) 니리 세션
#   wezterm     wezterm.lua                                        macOS
#   rift        config.toml (키맵)                                  macOS
#   karabiner   karabiner.json (키맵)                               macOS
#   aerospace   aerospace.toml (rift 폴백 WM)                       macOS
#   helpers     rift 키바인딩이 부르는 스크립트들 (rice/bin)          macOS
#   peek        WorkspacePeek 의 config.json                        macOS
#
# 여기 없는 것 하나, 그리고 그 이유:
#
#   borders/bordersrc     apps/rice-colors 가 벽지 색으로 다시 쓰는 파생물이다.
#                         레포의 것은 wal 을 안 돌린 머신용 폴백이라 덮으면
#                         지금 걸린 색이 사라진다. rice-save 도 저장하지 않는다.
#
# rift/config.toml, karabiner.json, aerospace.toml 셋은 2026-08-06 까지 여기
# 없었다 — modules/darwin/files.nix 가 거는 읽기 전용 스토어 심링크라 되받을
# 라이브가 없었다. 이제 셋 다 시드라 나머지와 똑같이 왕복한다.
#
# 플랫폼을 가리는 건 여기서만 필요하다. rice-save 는 라이브가 없으면 "skip
# (absent)" 로 알아서 비켜 가는데, 그건 macOS 에 니리 파일이 없기 때문이다.
# 방향이 반대인 여기서는 원본이 레포에 늘 있으므로 그 검사가 반대로 작동한다 —
# 그냥 두면 없는 자리를 "새로 씀"으로 판단해서 Mac 에 니리 설정을 심는다.
#
# ghostty 의 themes/ 는 뺐다. rice-save 도 저장하지 않는 쪽인데, 레포에 있는 건
# 생성기가 없는 곳을 위한 폴백 팔레트일 뿐이라 덮으면 DMS/matugen 이 이 머신에
# 써 준 진짜 팔레트를 지우게 된다.
#
# 덮기 전의 것은 ~/.config/rice/backups/<시각>/ 에 그 자리 그대로 쌓인다. 지우는
# 건 이 스크립트가 안 한다 — 되돌릴 일이 생기는 건 대개 한참 뒤이고, 텍스트
# 파일 몇 개라 쌓여도 무게가 없다. 정리는 그냥 그 디렉터리를 지우면 된다.

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

# rice-save 와 같은 이유로 $0 이 아니라 작업 디렉터리에서 레포를 찾는다 —
# `nix run .#rice-restore` 로 돌면 $0 은 스토어 안의 읽기 전용 복사본이다.
repo="${RICE_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
rice="$repo/modules/nixos/niri/rice"
gt="$repo/modules/shared/ghostty"
hy="$repo/modules/nixos/hyprland/rice"
dm="$repo/modules/nixos/dms"
dr="$repo/modules/darwin/rice"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

if [ -z "$repo" ] || [ ! -d "$repo/modules/nixos/niri" ]; then
  printf "${RED}Run this from inside the nixos-config checkout, or set RICE_REPO.${NC}\n"
  exit 1
fi

linux_only="niri profiles hypr studio dms fuzzel gtk"
mac_only="wezterm rift karabiner aerospace helpers peek"
# 터미널 라이싱만 두 플랫폼이 공유한다.
all="$linux_only ghostty $mac_only"
# 이 플랫폼에서 실제로 다룰 수 있는 것.
# 판단 기준은 rice-term 과 같은 uname 이다 — `command -v niri` 로 가르면 니리를
# 아직 안 깐 리눅스 머신에서 조용히 절반만 복원하게 된다.
if [ "$(uname)" = "Darwin" ]; then
  usable="ghostty $mac_only"
else
  usable="$linux_only ghostty"
fi

want=""
given=0
check_only=0
assume_yes=0
while [ $# -gt 0 ]; do
  case "$1" in
  --check) check_only=1 ;;
  --yes | -y) assume_yes=1 ;;
  -*)
    printf "${RED}알 수 없는 옵션: %s${NC}\n" "$1"
    exit 1
    ;;
  *)
    case " $all " in
    *" $1 "*) ;;
    *)
      printf "${RED}알 수 없는 대상: %s${NC}\n" "$1"
      printf "  %s\n" "$all"
      exit 1
      ;;
    esac
    given=$((given + 1))
    # 이름은 맞는데 이 플랫폼 것이 아니면 건너뛴다. 거절하지 않는 건 두 플랫폼에서
    # 같은 명령을 돌릴 수 있게 하려는 것이다.
    case " $usable " in
    *" $1 "*) want="$want $1" ;;
    *) printf "${YELLOW}건너뜀${NC}       %s (%s 에는 대상이 없다)\n" "$1" "$(uname)" ;;
    esac
    ;;
  esac
  shift
done

if [ "$given" -eq 0 ]; then
  want="$usable"
elif [ -z "$want" ]; then
  printf "${GREEN}고른 대상이 이 플랫폼에 없다. 할 일이 없다.${NC}\n"
  exit 0
fi

backup="$cfg/rice/backups/$(date -u +%Y%m%d-%H%M%SZ)"

# 같은 목록을 두 번 돈다: 한 번은 무엇이 덮이는지 보여주려고(mode=report), 확인을
# 받은 뒤 한 번은 실제로 쓰려고(mode=write). 목록을 두 벌 적으면 반드시 어긋나므로
# 함수 하나를 모드로 가른다.
mode="report"
changed=0

# rice-fuzzel 이 이 머신의 절대 경로로 붙인 include 줄과 그 주석. rice-save 는
# 저장할 때 이걸 떼므로 레포 파일에는 없고, 라이브에는 항상 있다. 비교할 때도
# 떼지 않으면 fuzzel.ini 가 영원히 "다름"으로 뜬다. 뒤의 sed 는 그 줄이 맨 위에
# 있을 때 남는 빈 줄을 지운다 — rice-save 가 하는 정리와 같다.
fuzzel_live() {
  sed -e '/^include=.*dank-rice\.ini$/d' -e '/^# apps\/rice-fuzzel /d' | sed '/./,$!d'
}

item() { # item <레포 원본> <라이브 대상> [비교 전에 라이브를 거를 함수]
  src="$1"
  dst="$2"
  filter="${3:-}"
  rel="${dst#"$HOME"/}"

  if [ ! -e "$src" ]; then
    [ "$mode" = report ] && printf "  ${YELLOW}레포에 없음${NC}  %s\n" "${src#"$repo"/}"
    return 0
  fi

  # 거르는 건 비교뿐이다. 아래에서 실제로 쓸 때는 레포 파일을 그대로 얹고, 떼인
  # 줄은 파생물 단계에서 스위처가 다시 붙인다.
  cmp_dst="$dst"
  if [ -n "$filter" ] && [ -f "$dst" ]; then
    cmp_dst="$(mktemp)"
    "$filter" <"$dst" >"$cmp_dst"
  fi
  if diff -rq "$src" "$cmp_dst" >/dev/null 2>&1; then
    [ "$cmp_dst" = "$dst" ] || rm -f "$cmp_dst"
    [ "$mode" = report ] && printf "  ${DIM}같음${NC}         ~/%s\n" "$rel"
    return 0
  fi
  [ "$cmp_dst" = "$dst" ] || rm -f "$cmp_dst"

  changed=$((changed + 1))
  if [ "$mode" = report ]; then
    if [ -e "$dst" ]; then
      printf "  ${YELLOW}덮어씀${NC}       ~/%s\n" "$rel"
    else
      printf "  ${GREEN}새로 씀${NC}      ~/%s\n" "$rel"
    fi
    return 0
  fi

  # 덮기 전에 그 자리를 백업으로 옮겨 둔다. 새로 쓰는 것(대상이 없던 것)은 백업할
  # 게 없고, 되돌릴 때도 그냥 지우면 되므로 아래 롤백이 신경 쓰지 않는다.
  if [ -e "$dst" ]; then
    mkdir -p "$backup/$(dirname "$rel")"
    cp -R "$dst" "$backup/$rel"
  fi
  mkdir -p "$(dirname "$dst")"
  # 디렉터리는 지우고 새로 만든다. 그래야 레포에서 사라진 조각이 라이브에 남지
  # 않는다 — rice-save 가 반대 방향에서 하는 것과 같은 이유다. rm 이 앞에 있으므로
  # `cp -R` 만으로 GNU 의 `-T` 와 같은 결과가 나온다(BSD 에는 그 플래그가 없다).
  rm -rf "$dst"
  cp -R "$src" "$dst"
  chmod -R u+w "$dst"
  printf "  ${GREEN}복원${NC}         ~/%s\n" "$rel"
}

plan() {
  case " $want " in *" niri "*)
    item "$rice/config.kdl" "$cfg/niri/config.kdl"
    item "$rice/animations.kdl" "$cfg/niri/animations.kdl"
    ;;
  esac
  case " $want " in *" profiles "*)
    item "$rice/profiles" "$cfg/rice/profiles"
    ;;
  esac
  case " $want " in *" hypr "*)
    # hyprland.lua 도 shaders/ 도 여기서 쓰는 것만으로는 화면에 안 나타난다.
    # 아래 파생물 단계가 둘 다 맡는다 — hyprctl reload 와 rice-crt --reload.
    # (설정은 rm+cp 때문에 감시가 끊겨서, 셰이더는 이미 컴파일돼 있어서다.
    # 이유는 그쪽에 적어 뒀다.)
    item "$hy/hyprland.lua" "$cfg/hypr/hyprland.lua"
    item "$hy/shaders" "$cfg/hypr/shaders"
    # 이름 붙인 체인도 같은 처지다. rm+cp 라서 rice-crt --save 로 만들고 아직
    # rice-save 로 안 되받은 체인은 여기서 지워진다 — 백업에는 남는다.
    item "$hy/chains" "$cfg/hypr/chains"
    ;;
  esac
  case " $want " in *" studio "*)
    # 파생물 단계가 없다. 스튜디오는 창을 띄울 때 QML 을 읽으므로, 떠 있는
    # 창만 닫았다 열면 된다(apps/rice-studio).
    item "$hy/studio" "$cfg/rice-studio"
    ;;
  esac
  case " $want " in *" dms "*)
    item "$dm/plugins/RiceSwitcher" "$cfg/DankMaterialShell/plugins/RiceSwitcher"
    ;;
  esac
  case " $want " in *" ghostty "*)
    item "$gt/config" "$cfg/ghostty/config"
    item "$gt/rices" "$cfg/ghostty/rices"
    item "$gt/shaders" "$cfg/ghostty/shaders"
    ;;
  esac
  case " $want " in *" fuzzel "*)
    item "$rice/fuzzel.ini" "$cfg/fuzzel/fuzzel.ini" fuzzel_live
    ;;
  esac
  case " $want " in *" gtk "*)
    item "$rice/gtk-settings.ini" "$cfg/gtk-3.0/settings.ini"
    item "$rice/gtk-settings.ini" "$cfg/gtk-4.0/settings.ini"
    ;;
  esac

  # ── macOS ───────────────────────────────────────────────────────────────
  # borders/bordersrc 는 여기에도 없다. rice-colors 가 다시 쓰는 파생물이라
  # 덮으면 지금 걸린 벽지의 색을 레포의 폴백 색으로 되돌려 놓게 된다.
  # 모양을 바꿨다면 `apps/rice-colors --reload` 가 새 색으로 다시 써 준다.
  case " $want " in *" wezterm "*)
    item "$dr/wezterm" "$cfg/wezterm"
    ;;
  esac

  case " $want " in *" rift "*)
    item "$dr/rift/config.toml" "$cfg/rift/config.toml"
    ;;
  esac

  case " $want " in *" karabiner "*)
    # 파일 하나만 다룬다. 옆의 assets/ 와 automatic_backups/ 는 앱의 것이다.
    item "$dr/karabiner/karabiner.json" "$cfg/karabiner/karabiner.json"
    ;;
  esac

  case " $want " in *" aerospace "*)
    item "$dr/aerospace/aerospace.toml" "$cfg/aerospace/aerospace.toml"
    ;;
  esac

  case " $want " in *" helpers "*)
    item "$dr/bin" "$cfg/rice/bin"
    ;;
  esac

  case " $want " in *" peek "*)
    item "$dr/workspacepeek/config.json" "$cfg/workspacepeek/config.json"
    ;;
  esac
}

printf "${YELLOW}레포 → 라이브${NC} ${DIM}(%s)${NC}\n" "${want# }"
plan

if [ "$changed" -eq 0 ]; then
  printf "${GREEN}라이브가 레포와 같다. 덮을 것이 없다.${NC}\n"
  exit 0
fi
if [ "$check_only" -eq 1 ]; then
  printf "${GREEN}검사만 했다 — %d 개가 다르고, 아무것도 안 썼다.${NC}\n" "$changed"
  exit 0
fi

if [ "$assume_yes" -eq 0 ]; then
  printf "${YELLOW}%d 개를 덮는다. 지금 것은 ~/%s 로 옮겨 둔다. 계속할까? [y/N] ${NC}" \
    "$changed" "${backup#"$HOME"/}"
  # 파이프 뒤에서 돌 때는 stdin 이 없다. -e 가 걸려 있으므로 read 의 실패를 여기서
  # 삼키고, 답이 없으면 아래 case 가 거절로 처리한다.
  read -r ans </dev/tty 2>/dev/null || ans=""
  case "$ans" in
  [yY]*) ;;
  *)
    printf "그만둔다.\n"
    exit 1
    ;;
  esac
fi

mode="write"
changed=0
plan

# niri 는 로드할 때만 불평하므로, 깨진 설정을 밀어 넣어도 지금 떠 있는 세션은
# 멀쩡해 보인다. 다음 로그인에 알게 되는 게 최악이라 여기서 잡는다.
#
# 레포의 config.kdl 을 그 자리에서 검증할 수는 없다 — 끝에 있는
# `include "dms/layout.kdl"` 은 optional 이 아니고 그 파일은 라이브에만 있다.
# 그래서 순서가 반대다: 먼저 복원하고, 검증에 실패하면 백업에서 되돌린다.
if command -v niri >/dev/null 2>&1 && [ -f "$cfg/niri/config.kdl" ]; then
  if ! out="$(niri validate --config "$cfg/niri/config.kdl" 2>&1)"; then
    printf "${RED}복원한 니리 설정이 유효하지 않다. 백업에서 되돌린다.${NC}\n"
    printf '%s\n' "$out" | sed 's/^/  /'
    [ -d "$backup" ] && cp -R "$backup/." "$HOME/"
    printf "${YELLOW}되돌렸다. 새로 만들어진 파일은 남아 있을 수 있다 — ~/%s 와 비교할 것.${NC}\n" \
      "${backup#"$HOME"/}"
    exit 1
  fi
fi

printf "${DIM}백업: ~/%s${NC}\n" "${backup#"$HOME"/}"

# ── 파생물 다시 만들기 ────────────────────────────────────────────────────
# 여기까지는 원본만 되돌렸다. 화면이 읽는 것은 그게 아니라 스위처가 만들어 낸
# 파생물이다 — rice.conf 는 rices/ 에서, profile.kdl 과 settings.json 은
# profiles/ 에서 나온다. 그것들을 다시 만들지 않으면 "복원했는데 아무것도 안
# 바뀐다"가 된다. rice-save 가 그 파생물을 일부러 저장하지 않는 것과 짝이다.
#
# 스위처가 실패해도 복원 자체는 이미 끝났으므로 죽이지 않는다. 무엇을 손으로
# 돌려야 하는지만 알려 준다.
here="$(dirname "$0")"

# 화면 셰이더도 같은 처지다. 걸려 있는 것은 걸던 순간의 파일로 이미 컴파일돼
# 있으므로, .frag 를 덮어써 놓고 다시 걸지 않으면 화면이 그대로다. 다시 거는 김에
# 데미지 트래킹도 rice-crt 가 알아서 맞춘다.
#
# 하이프랜드 세션이 아니면 걸 자리가 없다. rice-crt 는 그 경우 거절하고 나가는데,
# 니리에서 `--check` 없이 전체 복원을 돌린 사람에게 그 빨간 줄은 겁만 준다.
case " $want " in *" hypr "*)
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    # hyprland.lua 는 저장하면 알아서 다시 읽힌다 — 단 **덮어썼을 때** 얘기다.
    # 위 item() 은 `rm -rf` 뒤에 `cp` 라서 감시가 걸려 있던 아이노드가 통째로
    # 사라지고, 새로 생긴 파일에는 아무도 붙어 있지 않다. 그래서 복원이 끝나도
    # 컴포지터는 옛 설정으로 계속 돈다. `복원 완료` 를 보고 새 키맵이 걸렸다고
    # 믿게 되는 자리라, 실제로 한 번 속았다(Mod+Ctrl+E 를 넣고 눌러도 아무 일도
    # 안 일어났다). rm+cp 는 레포에서 사라진 조각을 지우려는 것이라 그쪽을
    # 바꿀 수는 없으니, 여기서 명시적으로 다시 읽힌다.
    hyprctl reload >/dev/null 2>&1 || printf "${YELLOW}hyprctl reload 실패 — 손으로: hyprctl reload${NC}\n"
    "$here/rice-crt" --reload || printf "${YELLOW}rice-crt 실패 — 손으로: apps/rice-crt --reload${NC}\n"
  else
    printf "${DIM}하이프랜드 세션이 아니다 — 셰이더는 다음 로그인부터.${NC}\n"
  fi
  ;;
esac

# DMS 는 플러그인 폴더를 감시하지만 rift 처럼 rm+cp 가 감시를 끊을 수 있고,
# plugin.json 을 바꿨으면 reload 로는 부족하다(../modules/nixos/dms 머리말 —
# 매니페스트는 dms restart 라야 읽힌다). 그래서 reload 를 걸어 보고, 실패하면
# 손으로 할 일을 알려 준다.
case " $want " in *" dms "*)
  if command -v dms >/dev/null 2>&1; then
    if dms ipc call plugins reload riceSwitcher >/dev/null 2>&1; then
      printf "${DIM}RiceSwitcher 플러그인 다시 읽혔다. plugin.json 을 바꿨다면: dms restart${NC}\n"
    else
      printf "${YELLOW}플러그인 reload 실패 — 손으로: dms restart${NC}\n"
    fi
  else
    printf "${DIM}dms 가 없다 — 플러그인은 셸이 다음에 뜰 때 읽힌다.${NC}\n"
  fi
  ;;
esac

case " $want " in *" ghostty "*)
  term="$(cat "$cfg/rice/term" 2>/dev/null || true)"
  if [ -n "$term" ]; then
    "$here/rice-term" "$term" || printf "${YELLOW}rice-term 실패 — 손으로: apps/rice-term %s${NC}\n" "$term"
  else
    printf "${DIM}켜 둔 터미널 룩을 모른다 — apps/rice-term 으로 하나 고를 것.${NC}\n"
  fi
  ;;
esac

# fuzzel 도 여기 걸린다. 레포의 fuzzel.ini 에는 include 줄이 없기 때문이다
# (rice-save 가 이 머신의 절대 경로라서 떼고 저장한다). rice-switch 가 부르는
# rice-fuzzel 이 그 줄을 다시 붙이고 색 파일도 새로 만든다.
case " $want " in *" profiles "* | *" fuzzel "*)
  # macOS 는 여기 못 온다 — 위에서 두 대상이 want 에서 빠진다.
  prof="$(cat "$cfg/rice/current" 2>/dev/null || true)"
  if [ -n "$prof" ]; then
    "$here/rice-switch" "$prof" || printf "${YELLOW}rice-switch 실패 — 손으로: apps/rice-switch %s${NC}\n" "$prof"
  else
    printf "${DIM}켜 둔 프로필을 모른다 — apps/rice-switch 로 하나 고를 것.${NC}\n"
  fi
  ;;
esac

# rift 는 hot_reload 로 자기 설정을 지켜보지만, 그것만 믿으면 안 된다. 위 item()
# 이 `rm -rf` 뒤에 `cp` 라서 감시가 걸려 있던 아이노드가 통째로 사라진다 —
# hyprland.lua 에서 한 번 속았던 것과 정확히 같은 자리다(그쪽 주석 참고).
#
# 그리고 이건 실패를 반드시 보여 줘야 하는 종류다. rift 는 한 줄만 틀려도 파일
# 전체를 거부하고 *조용히 이전 설정으로 계속 돈다*. 그러면 "복원 완료" 를 보고도
# 키맵은 옛것이고, 다음 로그인에야 알게 된다. reload 의 출력이 그 이유를 찍는
# 유일한 자리라 삼키지 않고 그대로 흘린다.
case " $want " in *" rift "*)
  if command -v rift-cli >/dev/null 2>&1; then
    if rift-cli execute config reload; then
      printf "${DIM}rift 설정 다시 읽혔다.${NC}\n"
    else
      printf "${RED}rift 가 복원된 설정을 거부했다 — 위 이유를 볼 것. 옛 설정으로 돌고 있다.${NC}\n"
      printf "${DIM}백업: ~/%s${NC}\n" "${backup#"$HOME"/}"
    fi
  else
    # rift 를 아직 안 깐 Mac. 파일은 이미 제자리이므로 실패로 다루지 않는다.
    printf "${DIM}rift-cli 가 없다 — 설정은 심었고, 다음 실행부터 걸린다.${NC}\n"
  fi
  ;;
esac

# Karabiner 도 rift 와 같은 처지다. karabiner_console_user_server 가 파일을
# 지켜보지만 위 item() 의 rm+cp 가 그 감시를 끊고, 게다가 이쪽은 잘못된 JSON 을
# 조용히 무시하고 이전 설정으로 계속 돈다 — 키맵이 안 바뀐 것 말고는 증상이 없다.
#
# 그래서 순서가 둘이다: 먼저 JSON 을 검사하고(레포에 깨진 걸 커밋했을 수 있다),
# 그다음 유저 서버를 다시 띄운다. kickstart 인 이유는 rift 나 WorkspacePeek 과
# 같다 — 이건 앱이 띄우는 에이전트라 손으로 죽였다 켜면 launchd 가 모르는
# 인스턴스가 생긴다.
case " $want " in *" karabiner "*)
  if ! python3 -m json.tool "$cfg/karabiner/karabiner.json" >/dev/null 2>&1; then
    printf "${RED}복원한 karabiner.json 이 유효한 JSON 이 아니다. Karabiner 는 이걸 무시하고 옛 설정으로 돈다.${NC}\n"
    printf "${DIM}백업: ~/%s${NC}\n" "${backup#"$HOME"/}"
  elif launchctl kickstart -k "gui/$(id -u)/org.pqrs.service.agent.karabiner_console_user_server" >/dev/null 2>&1; then
    printf "${DIM}Karabiner 설정 다시 읽혔다.${NC}\n"
  else
    # Karabiner-Elements 를 아직 안 깐 Mac. 파일은 제자리이므로 실패가 아니다.
    printf "${DIM}Karabiner 에이전트가 없다 — 설정은 심었고, 앱을 깔면 걸린다.${NC}\n"
  fi
  ;;
esac

# AeroSpace 는 로그인에 안 뜬다(rift 가 그 자리를 가져갔다). 폴백으로 띄워 둔
# 동안에만 다시 읽힐 것이 있으므로, 돌고 있을 때만 부른다 — 안 돌 때 부르면
# "Can't connect to AeroSpace server" 만 찍혀서 겁을 준다.
case " $want " in *" aerospace "*)
  if pgrep -x AeroSpace >/dev/null 2>&1; then
    if aerospace reload-config; then
      printf "${DIM}AeroSpace 설정 다시 읽혔다.${NC}\n"
    else
      printf "${YELLOW}AeroSpace 가 설정을 거부했다 — 위 이유를 볼 것.${NC}\n"
    fi
  else
    printf "${DIM}AeroSpace 는 안 떠 있다 — 다음 \`open -a AeroSpace\` 부터 걸린다.${NC}\n"
  fi
  ;;
esac

# WorkspacePeek 은 설정을 시작할 때 한 번만 읽는다. 파일만 바꿔 놓으면 다음
# 로그인까지 옛 핫키가 그대로다.
#
# killall + `open -a` 가 아니라 kickstart 인 이유: 이 앱은 로그인 에이전트로
# 뜬다(hosts/darwin/default.nix 의 launchd.user.agents.workspacepeek). open 으로
# 되살리면 launchd 가 모르는 인스턴스가 생겨서, 다음에 이 에이전트를 다루는 명령이
# 엉뚱한 프로세스를 보게 된다. -k 는 떠 있으면 죽이고 다시, 아니면 그냥 시작이다.
case " $want " in *" peek "*)
  if launchctl kickstart -k "gui/$(id -u)/org.nixos.workspacepeek" >/dev/null 2>&1; then
    printf "${DIM}WorkspacePeek 다시 띄웠다.${NC}\n"
  else
    # 에이전트가 없는 머신(앱을 아직 안 깐 경우)이면 여기로 온다. 설정은 이미
    # 복원됐으므로 실패로 다루지 않는다.
    printf "${YELLOW}WorkspacePeek 에이전트가 없다 — 앱을 깔았는지 볼 것 (modules/darwin/rice/workspacepeek/README.md)${NC}\n"
  fi
  ;;
esac

# wezterm 은 아무것도 안 한다. 자기 설정 파일을 스스로 지켜보고 있어서, 저장되는
# 순간 열려 있는 창들이 알아서 다시 읽는다(modules/darwin/rice/wezterm/wezterm.lua).
# rift 와 달리 rm+cp 에 안 걸리는 건, 이쪽은 디렉터리를 통째로 감시하기 때문이다.
#
# rift 의 헬퍼(helpers)도 아무것도 안 한다. 키를 누를 때마다 새로 실행되는 셸
# 스크립트라 다음 호출부터 바로 새 내용이다.

printf "${GREEN}복원 완료.${NC}\n"
