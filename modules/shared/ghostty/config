# ghostty 설정. 다른 리싱 파일과 같은 규칙 — 이 파일은 시드일 뿐이고,
# ~/.config/ghostty/config 는 평범한 쓰기 가능한 파일이다. 고치면 ghostty 가
# 바로 반영한다(새 창 기준). 되받아 저장은 apps/rice-save.

# DMS/matugen 이 themes/dankcolors 에 써 주는 팔레트를 그대로 쓴다. 월페이퍼나
# 테마를 바꾸면 이 파일은 그대로인 채 팔레트만 갈린다.
theme = dankcolors

# p10k 의 파워라인 글리프가 필요해서 Nerd Font 로 지정한다. ghostty 가 심볼
# 폴백을 내장하긴 하지만, 프롬프트가 통째로 한 폰트에서 나오는 편이 낫다.
font-family = JetBrainsMono Nerd Font
font-size = 10

window-padding-x = 20
window-padding-y = 20

# 프로필별로 다르게 하고 싶으면 rice-switch 에 ghostty 조각을 붙이면 되지만,
# 지금은 조각 하나를 줄이는 쪽을 택했다. 투명도는 여기서 한 번만 정한다.
background-opacity = 0.94

# 터미널 룩 조각. apps/rice-term 이 ./rices/<name>.conf 를 여기로 복사한다.
# `?` 는 파일이 없어도 조용히 넘어가라는 뜻이고, 경로는 이 파일 기준 상대다.
#
# 위치가 맨 아래인 건 읽는 사람을 위한 것일 뿐이다 — ghostty 는 config-file 을
# 자기를 담은 파일보다 *나중에* 읽으므로, 어디에 적든 조각이 본체를 이긴다.
config-file = ?rice.conf
