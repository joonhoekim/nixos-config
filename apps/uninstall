#!/bin/sh
#
# 이 Mac 에서 이 레포가 깐 것을 걷어 낸다. macOS 전용.
#
#   apps/uninstall                   계획만 보인다(기본). 아무것도 바꾸지 않는다
#   apps/uninstall --run             Nix · nix-darwin · home-manager 를 걷는다 — 다시 깔 때
#   apps/uninstall --run --purge     위에 더해 brew 앱 · kanata 와 드라이버 · nix 밖 빌드 ·
#                                    서명 신원까지 — 이 Mac 에서 손을 뗄 때
#
# `nix run .#uninstall` 이 아니라 /bin/sh 로 경로를 직접 부른다. 지우는 대상이 nix 자신이다.
#
# ── 순서가 이 모양인 이유 ────────────────────────────────────────────────
# 1. --purge 의 단계가 먼저다. brew 는 nix-homebrew 가 스토어에서 링크한 것이라
#    Nix 를 지우고 나면 `brew uninstall` 을 부를 수 없다.
# 2. darwin-uninstaller 는 Nix 를 지우기 전에, 그리고 맨 처음에 빌드해 둔다. 로그인
#    셸을 /bin/zsh 로 돌리고 /etc 의 *.before-nix-darwin 을 되살리고 nix-darwin 의
#    launchd 서비스를 내린다. 이걸 건너뛰고 /nix 를 지우면 로그인 셸이 없는 경로를
#    가리켜 새 터미널이 바로 닫힌다.
# 3. Nix 본체가 마지막이다. /nix 볼륨을 쓰는 프로세스가 하나라도 있으면 언마운트에서
#    멈춘다 — 그래서 이 스크립트는 스토어의 셸 아래에서는 --run 을 거절한다.
#
# 기본 --run 이 kanata 바이너리 · 드라이버 · 서명 신원 · nix 밖 빌드를 남기는 것은 일부러다.
# TCC 허가와 드라이버 승인은 이것들에 묶여 있어서, 남겨 두면 다시 깐 뒤 사람이 할
# 단계(apps/check/pending)가 없다.

GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; DIM='\033[2m'; NC='\033[0m'

run=0; purge=0
for a do
  case "$a" in
    --run) run=1 ;;
    --purge) purge=1 ;;
    *) printf "모르는 인자: %s\n" "$a" >&2; exit 2 ;;
  esac
done

[ "$(uname)" = Darwin ] || { printf "macOS 전용이다.\n" >&2; exit 1; }
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo="$(CDPATH= cd -- "$here/.." && pwd)"
user="$(id -un)"

n=0
# <제목> <있는가: 0/1> <명령>
step() {
  n=$((n+1))
  if [ "$2" != 1 ]; then
    printf "${DIM}%2d. %s — 없다, 건너뛴다${NC}\n" "$n" "$1"
    return 0
  fi
  printf "${YELLOW}%2d. %s${NC}\n" "$n" "$1"
  printf "      ${DIM}\$ %s${NC}\n" "$3"
  [ "$run" = 1 ] || return 0
  printf "    진행할까? [y/N/q] "
  read -r ans </dev/tty
  case "$ans" in
    y|Y) sh -c "$3" || { printf "${RED}    실패했다.${NC} 여기서 멈춘다 — 고친 뒤 다시 돌리면 끝난 단계는 '없다' 로 건너뛴다.\n"; exit 1; } ;;
    q|Q) exit 1 ;;
    *) printf "    건너뛰었다.\n" ;;
  esac
}
has() { [ -e "$1" ] || [ -L "$1" ] && echo 1 || echo 0; }

# ── 미리 보기 ────────────────────────────────────────────────────────────
login="$(dscl . -read "/Users/$user" UserShell 2>/dev/null | awk '{ print $2 }')"
parent="$(ps -o comm= -p "$PPID" 2>/dev/null)"
installer=none
[ -e /nix/receipt.json ] && [ -x /nix/nix-installer ] && installer=receipt
[ "$installer" = none ] && [ -d /nix/store ] && installer=manual

printf "\n${YELLOW}계정${NC}     %s (로그인 셸 %s)\n" "$user" "$login"
printf "${YELLOW}이 셸${NC}    %s\n" "$parent"
# macOS 의 /bin/sh(bash 3.2)는 $( ) 안의 case 를 못 읽는다 — 변수로 푼다.
case $installer in
  receipt) what="설치기 기록이 있다 (/nix/receipt.json) — 그 설치기의 uninstall 로 지운다" ;;
  manual) what="설치기 기록이 없다 — 공식 설치기 판, 매뉴얼의 수동 절차로 지운다" ;;
  *) what="없다" ;;
esac
printf "${YELLOW}Nix${NC}      %s\n" "$what"
printf "${YELLOW}모드${NC}     %s%s\n\n" "$([ $run = 1 ] && echo 실행 || echo '계획만 (--run 으로 실행)')" "$([ $purge = 1 ] && echo ' + purge')"

if [ "$run" = 1 ]; then
  [ -t 0 ] || { printf "${RED}터미널에서 돌릴 것.${NC}\n" >&2; exit 1; }
  case "$parent$login" in
    */nix/store/*|*/run/current-system/*|*/etc/profiles/*)
      printf "${RED}이 셸이나 로그인 셸이 nix 스토어에 있다.${NC} /nix 를 언마운트하지 못한다.\n"
      printf "  1) sudo dscl . -create /Users/%s UserShell /bin/zsh\n" "$user"
      printf "  2) 터미널 앱을 완전히 끄고 다시 연다 (subline-terminal 이 아니라 /System/Applications/Utilities/Terminal.app)\n"
      printf "  3) /bin/sh %s/apps/uninstall --run%s\n" "$repo" "$([ $purge = 1 ] && echo ' --purge')"
      exit 1 ;;
  esac
fi

# darwin-uninstaller 는 Nix 가 살아 있을 때 받아 둔다. 이 flake 가 고정한 nix-darwin 판이다.
uninst=""
if [ -e /run/current-system/sw/bin/darwin-rebuild ]; then
  if [ "$run" = 1 ]; then
    uninst="$(cd "$repo" && /run/current-system/sw/bin/nix build --no-link --print-out-paths \
      --inputs-from . darwin#darwin-uninstaller 2>/dev/null | tail -1)/bin/darwin-uninstaller"
    [ -x "$uninst" ] || { printf "${RED}darwin-uninstaller 를 받지 못했다.${NC}\n" >&2; exit 1; }
  else
    uninst='<nix build --inputs-from . darwin#darwin-uninstaller>/bin/darwin-uninstaller'
  fi
fi

# ── --purge: Nix 를 지우기 전에 끝내야 하는 것 ─────────────────────────────
if [ "$purge" = 1 ]; then
  printf "${YELLOW}purge${NC}\n"
  step "brew 로 깐 cask 를 지운다 (앱 데이터 ~/Library 는 남는다)" \
    "$([ -x /opt/homebrew/bin/brew ] && [ -n "$(/opt/homebrew/bin/brew list --cask 2>/dev/null)" ] && echo 1 || echo 0)" \
    "/opt/homebrew/bin/brew list --cask | xargs /opt/homebrew/bin/brew uninstall --cask"
  step "Homebrew 접두사를 지운다 (nix-homebrew 가 만든 것)" "$(has /opt/homebrew)" \
    "sudo rm -rf /opt/homebrew"
  step "Karabiner VirtualHIDDevice 드라이버를 내리고 Manager 앱을 지운다" \
    "$(has /Applications/.Karabiner-VirtualHIDDevice-Manager.app)" \
    "sudo /Applications/.Karabiner-VirtualHIDDevice-Manager.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Manager deactivate; sudo rm -rf /Applications/.Karabiner-VirtualHIDDevice-Manager.app"
  step "kanata 바이너리 · 설정과 로그를 지운다" "$(has /usr/local/libexec/kanata)" \
    "sudo rm -rf /usr/local/libexec/kanata /usr/local/libexec/.kanata.source /var/log/kanata.log /var/log/karabiner-vhid-daemon.log"
  step "nix 밖 빌드(rift-grid · subline-terminal)를 지운다 (소스 ~/git 은 남긴다)" \
    "$(has "$HOME/.local/bin/rift-grid")" \
    "cd \"\$HOME\" && rm -rf .local/bin/rift-grid .local/bin/rift-grid-cli .local/bin/.rift-grid.commit .local/bin/subline-terminal .local/bin/subline-terminald .local/bin/.subline-terminal.commit Applications/subline-terminal.app"
  step "코드 서명 신원을 지운다 (이걸로 서명한 앱의 TCC 허가도 같이 의미를 잃는다)" \
    "$(security find-certificate -c "$user local codesign" >/dev/null 2>&1 && echo 1 || echo 0)" \
    "\"$repo/apps/mac-signing-cert\" --remove"
  printf "\n"
fi

# ── nix-darwin → home-manager → Nix ──────────────────────────────────────
printf "${YELLOW}Nix${NC}\n"
# /usr/local/libexec/nix-darwin 은 이 레포의 launchd 래퍼다(modules/darwin/launchd-names.nix).
# darwin-uninstaller 는 그 모듈을 모르므로 여기서 같이 지운다.
#
# 사용자 에이전트는 먼저 사용자 권한으로 내린다. darwin-uninstaller 는 root 로 돌아서
# ~/Library/LaunchAgents 의 plist 파일만 지우고 gui 도메인에 올라 있는 job 은 그대로 둔다
# (2026-10-31 실측: wal-watch·rift-grid 가 남았다). nix 의 bash 로 도는 wal-watch 가 남으면
# 마지막 단계에서 /nix 를 언마운트하지 못한다.
step "nix-darwin 을 걷는다 (로그인 셸 → /bin/zsh, /etc 복원, launchd 서비스 · sudoers · pam · 래퍼 제거)" \
  "$(has /run/current-system)" \
  "for p in \"\$HOME\"/Library/LaunchAgents/org.nixos.*.plist; do [ -e \"\$p\" ] && launchctl bootout gui/\$(id -u) \"\$p\"; done; sudo \"$uninst\"; sudo rm -rf /usr/local/libexec/nix-darwin"

# home-manager 의 링크는 nix-darwin 제거가 건드리지 않는다. 스토어의 home-manager-files 를
# 가리키는 링크만 지우고, 그 자리에 첫 활성화 때 옮겨 둔 <이름>.backup 이 있으면 되돌린다
# (backupFileExtension = "backup", modules/darwin/home-manager.nix). 링크가 아니었던 파일의
# .backup 은 손대지 않는다 — 사용자가 만든 것일 수 있다.
hm_find='find "$HOME" -maxdepth 4 \( -path "$HOME/Library" -o -path "$HOME/git" -o -path "$HOME/.Trash" \) -prune -o -type l -lname "/nix/store/*-home-manager-files/*" -print'
hm_links="$(eval "$hm_find" 2>/dev/null | head -1)"
step "home-manager 가 만든 링크를 지우고 그 자리의 .backup 을 되돌린다" "$([ -n "$hm_links" ] && echo 1 || echo 0)" \
  "$hm_find | while IFS= read -r l; do rm \"\$l\"; [ -e \"\$l.backup\" ] && mv \"\$l.backup\" \"\$l\"; done; rm -rf \"\$HOME/Applications/Home Manager Apps\" \"\$HOME/.local/state/home-manager\" \"\$HOME/.local/state/nix\" \"\$HOME/.nix-profile\" \"\$HOME/.nix-defexpr\" \"\$HOME/.cache/nix\""

case "$installer" in
  receipt)
    # Lix·Determinate 계열 설치기. 기록을 따라 볼륨 · nixbld 사용자 · synthetic.conf ·
    # /etc 셸 훅 · 데몬을 되돌린다. macOS 에서 볼륨 언마운트에서 멈춘다는 보고가 있다
    # (lix-installer#80) — 그때는 /nix 를 쓰는 프로세스부터 본다: sudo lsof +D /nix | head
    step "Nix 를 설치기 기록대로 지운다" 1 "sudo /nix/nix-installer uninstall" ;;
  manual)
    # 공식 설치기는 지우는 도구가 없다. 매뉴얼(nix.dev, Uninstalling Nix — macOS)의 순서다.
    # fstab 은 vifs 로 손으로 고쳐야 해서 그 줄만 따로 안내한다.
    step "Nix 를 매뉴얼 절차로 지운다 (fstab 은 그다음에 sudo vifs 로 /nix 줄을 지운다)" 1 \
      "for f in zshrc bashrc bash.bashrc; do [ -e /etc/\$f.backup-before-nix ] && sudo mv /etc/\$f.backup-before-nix /etc/\$f; done; sudo launchctl bootout system/org.nixos.nix-daemon 2>/dev/null; sudo rm -f /Library/LaunchDaemons/org.nixos.nix-daemon.plist; sudo launchctl bootout system/org.nixos.darwin-store 2>/dev/null; sudo rm -f /Library/LaunchDaemons/org.nixos.darwin-store.plist; sudo dscl . -delete /Groups/nixbld; for u in \$(dscl . -list /Users | grep _nixbld); do sudo dscl . -delete /Users/\$u; done; [ \"\$(cat /etc/synthetic.conf 2>/dev/null)\" = nix ] && sudo rm /etc/synthetic.conf; sudo rm -rf /etc/nix /var/root/.nix-profile /var/root/.nix-defexpr /var/root/.nix-channels; sudo diskutil apfs deleteVolume /nix" ;;
  none)
    step "Nix 본체" 0 "" ;;
esac

printf "\n${DIM}끝나면 재부팅한다. 빈 /nix 와 /run 은 재부팅 때 사라진다.\n"
printf "남는 것: TCC 목록의 항목(없는 바이너리를 가리킨다), ~/git 의 소스, 앱 데이터(~/Library),\n"
printf "손으로 깐 앱(Claude.app 등), /nix/var/nix/profiles 를 가리키던 백업이 있으면 그것.${NC}\n"
[ "$run" = 1 ] || printf "\n${DIM}계획만 보였다. 실행은 --run (단계마다 묻는다).${NC}\n"
