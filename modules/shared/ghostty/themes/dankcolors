# ~/.config/ghostty/themes/dankcolors 의 초기값. 리눅스에서는 matugen 이 통째로 덮어쓴다.
# 생성기가 없는 macOS·첫 로그인용이다 — 이 파일이 없으면 `theme = dankcolors` 가 설정 에러라 config 전체가
# 무효다. 덮어써지는 파일이라 apps/rice/save 로 안 되받으니 레포의 이 파일을 고친다.

# 배경·전경·선택은 fuzzel 폴백과 같은 값이다.
background = #161616
foreground = #d8d8d8
cursor-color = #d8d8d8
cursor-text = #161616
selection-background = #2f2f2f
selection-foreground = #ffffff

# ANSI 16 색을 회색으로 통일하면 ls·git diff 의 색 구분이 사라진다 — 채도만 낮춘다.
palette = 0=#2f2f2f
palette = 1=#c26d6d
palette = 2=#8faa76
palette = 3=#c9a86a
palette = 4=#7291b0
palette = 5=#a684a6
palette = 6=#6fa39d
palette = 7=#d8d8d8
palette = 8=#4a4a4a
palette = 9=#d98a8a
palette = 10=#a8c48f
palette = 11=#e0c286
palette = 12=#8fadcb
palette = 13=#c0a0c0
palette = 14=#8bbdb6
palette = 15=#ffffff
