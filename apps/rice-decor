#!/bin/sh -e
#
# 하이프랜드 장식 값(투명도·흐리게·어둡게·그림자)을 밖에서 읽고 쓰는 뒤판.
# 라이싱 스튜디오의 "장식" 탭이 이걸 쓴다 (apps/rice-studio).
#
#   apps/rice-decor                                 값 전부 (JSON)
#   apps/rice-decor set decoration:blur:size 6
#   apps/rice-decor reset [decoration:blur:size]    기본값으로 (안 주면 전부)
#   apps/rice-decor --file                          쓰는 파일 경로
#
# ── 왜 조각 파일 하나를 따로 소유하는가 ───────────────────────────────────
# 하이프랜드 설정에서 이 값들을 넣을 자리가 셋인데, 둘은 막혀 있다.
#
#   ~/.config/hypr/hyprland.lua      손으로 고치는 파일이다. 그 파일 머리말이
#                                    그렇게 선언하고 있고, 프로그램이 같이
#                                    쓰기 시작하면 그 약속이 깨진다.
#   ~/.config/hypr/dms/layout.lua    DMS 가 SettingsData 로부터 통째로 재생성
#                                    한다("Auto-generated by DMS — do not edit
#                                    manually"). 여기 적으면 다음 설정 변경에
#                                    말없이 날아간다.
#
# 그래서 셋째 자리를 만든다. ~/.config/hypr/decor.lua 는 이 스크립트만 쓰고,
# hyprland.lua 는 그것을 DMS 조각들 **뒤에** 한 줄로 부른다.
#
# ── 겹치는 값은 여기서 안 다룬다 ──────────────────────────────────────────
# hl.config 는 카테고리를 통째로 갈아치우지 않고 키 단위로 병합한다. 증거는
# 지금 화면이다 — layout.lua 가 general 을 다시 쓰는데도 hyprland.lua 의
# `layout = "scrolling"` 이 살아 있다. 덕분에 뒤에 와도 남의 값을 안 밟는다.
#
# 뒤집으면, 같은 키를 쓰면 **반드시** 밟는다. gaps_in · gaps_out · rounding ·
# border_size 는 DMS 설정 GUI 가 이미 소유하고 있어서 아래 표에서 뺐다. 여기서
# 또 쓰면 그쪽 슬라이더가 조용히 무효가 되고, 증상은 "DMS 에서 둥글기를 바꿨는데
# 안 바뀐다" — 원인이 이 파일에 있다는 걸 알아낼 방법이 화면에 없다.
#
# ── 왜 표가 이 파일에 있는가 ──────────────────────────────────────────────
# apps/rice-knobs 는 목록을 안 들고 있다. 셰이더가 `// @0..1` 로 스스로 손잡이를
# 선언하기 때문이다. 하이프랜드 옵션에는 그런 자기 선언이 없다 — `hyprctl
# getoption` 이 주는 것은 타입과 지금 값뿐이고, 범위도 기본값도 설명도 없다.
# 그러니 표가 하나는 있어야 하고, 그 하나가 여기다. 값을 늘리려면 아래에 한 줄
# 넣으면 되고 스튜디오 쪽은 안 고친다.
#
# ── 파일과 eval 둘 다 하는 이유 ───────────────────────────────────────────
# 파일은 다음 세션까지 남기고, eval 은 지금 화면에 건다. `hyprctl reload` 를
# 안 쓰는 건 그게 설정을 통째로 다시 읽어서 화면 셰이더까지 지워 버리기
# 때문이다 — 슬라이더를 끄는 동안 초당 몇 번씩 할 일이 아니다. lua 설정에서는
# `hyprctl keyword` 가 거절당하므로(파서가 다르다) 남는 길이 eval 이다.
#
# 이 분업은 hyprland.lua 가 decor.lua 를 require 가 아니라 **dofile** 로 읽어야
# 성립한다. require 된 파일은 하이프랜드가 감시해서, 여기서 파일을 다시 쓸
# 때마다 피하려던 그 리로드가 일어난다(실측 2026-08-12 — dofile 로 읽은 파일은
# 감시 목록에 안 들어간다). 배선은 ../modules/nixos/hyprland/default.nix 가
# ensure 로 보장한다.
#
# ── 되돌릴 곳은 레포가 아니라 기본값이다 ──────────────────────────────────
# 다른 라이싱 축은 레포 사본과 견준다(rice-knobs 의 "레포와 다름"). decor.lua 는
# 생성물이라 레포에 시드가 없고, 그 자리를 하이프랜드 기본값이 대신한다.
# 기본값과 같아진 값은 파일에서 아예 빠지므로 **파일에 남은 줄이 곧 내가 바꾼
# 것의 목록**이다. 아무것도 안 바꾼 머신의 decor.lua 는 빈 표다.

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
file="$cfg/hypr/decor.lua"

# ── 표 ────────────────────────────────────────────────────────────────────
# <키>  <구역>  <타입>  <최소>  <최대>  <눈금>  <기본값>  <설명>   (탭으로 나뉜다)
#
# 기본값은 하이프랜드 0.56 이 아무것도 안 적었을 때 쓰는 값이다. 확인하는 법은
# 조각을 안 건 세션에서 `hyprctl getoption <키>`.
spec() {
	cat <<'EOF'
decoration:active_opacity	투명도	float	0	1	0.01	1	포커스한 창. 창 전체가 반투명해지므로 글자도 같이 흐려진다 — 0.9 아래는 읽기 나빠진다
decoration:inactive_opacity	투명도	float	0	1	0.01	1	포커스 안 한 창
decoration:fullscreen_opacity	투명도	float	0	1	0.01	1	전체화면. 영상과 게임을 위해 1 로 두는 자리다
decoration:blur:enabled	흐리게	bool	0	1	1	1	창 뒤를 흐린다. 투명한 창이 하나도 없으면 아무 일도 안 일어난다
decoration:blur:size	흐리게	int	1	20	1	8	흐림 반경
decoration:blur:passes	흐리게	int	1	5	1	1	반복 횟수. 비용이 여기서 곱으로 는다 — 화면 셰이더와 같은 GPU 를 나눠 쓴다
decoration:blur:xray	흐리게	bool	0	1	1	0	뒤 창 대신 벽지를 흐린다. 창이 겹칠 때 글자가 훨씬 잘 읽힌다
decoration:blur:noise	흐리게	float	0	0.1	0.001	0.0117	흐린 면에 생기는 띠(banding)를 덮는 잡티
decoration:blur:contrast	흐리게	float	0	2	0.01	0.8916	흐린 면의 대비
decoration:blur:brightness	흐리게	float	0	2	0.01	1	흐린 면의 밝기
decoration:blur:vibrancy	흐리게	float	0	1	0.01	0.1696	흐리면 색이 빠지는 것을 되돌린다
decoration:blur:vibrancy_darkness	흐리게	float	0	1	0.01	0	어두운 곳에만 거는 채도
decoration:blur:popups	흐리게	bool	0	1	1	0	메뉴와 툴팁까지 흐린다
decoration:blur:special	흐리게	bool	0	1	1	0	스페셜 워크스페이스까지 흐린다
decoration:dim_inactive	어둡게	bool	0	1	1	0	포커스 안 한 창을 어둡게. 투명도와 달리 글자가 안 흐려져서 대비를 덜 잃는다
decoration:dim_strength	어둡게	float	0	1	0.01	0.5	얼마나 어둡게
decoration:dim_special	어둡게	float	0	1	0.01	0.2	스페셜 워크스페이스를 열었을 때 뒤가 어두워지는 정도
decoration:shadow:enabled	그림자	bool	0	1	1	1	창 그림자
decoration:shadow:range	그림자	int	0	50	1	4	번지는 거리
decoration:shadow:render_power	그림자	int	1	4	1	3	클수록 가장자리로 갈수록 빨리 옅어진다
decoration:shadow:sharp	그림자	bool	0	1	1	0	번짐 없는 각진 그림자
decoration:shadow:scale	그림자	float	0	1	0.01	1	창 크기 대비 그림자 크기
decoration:rounding_power	모서리	float	2	10	0.1	2	2 면 원, 키우면 스퀘어클이 된다. 둥글기 자체(rounding)는 DMS 설정이 소유한다
EOF
}

row() { # row <키> — 표에서 그 줄. 없으면 빈 문자열
	spec | awk -F'\t' -v k="$1" '$1 == k { print; exit }'
}

col() { # col <줄> <열번호>
	printf '%s\n' "$1" | cut -f"$2"
}

# ── 파일 ──────────────────────────────────────────────────────────────────
store() { # 파일에 남은 값 전부 → "<키>\t<값>". 불리언은 1/0 으로 접는다.
	[ -f "$file" ] || return 0
	awk -F'"' '/^[[:blank:]]*\["/ {
		v = $0
		sub(/^[^=]*= /, "", v)
		sub(/,$/, "", v)
		if (v == "true") v = 1
		if (v == "false") v = 0
		printf "%s\t%s\n", $2, v
	}' "$file"
}

# stdin 으로 받은 "<키>\t<값>" 들로 파일을 통째로 다시 쓴다. 줄 순서는 표 순서를
# 따른다 — 들어온 순서대로 쌓으면 값을 만질 때마다 줄이 아래로 이사해서, 파일을
# 열어 봤을 때 어디를 봐야 할지가 매번 달라진다.
write() {
	pairs="$(cat)"
	body="$(spec | awk -F'\t' -v pairs="$pairs" '
		BEGIN {
			n = split(pairs, ls, "\n")
			for (i = 1; i <= n; i++) {
				split(ls[i], a, "\t")
				if (a[1] != "") v[a[1]] = a[2]
			}
		}
		$1 in v {
			s = v[$1]
			if ($3 == "bool") s = (s + 0 ? "true" : "false")
			printf "    [\"%s\"] = %s,\n", $1, s
		}
	')"

	mkdir -p "$(dirname "$file")"
	tmp="$(mktemp)"
	trap 'rm -f "$tmp"' EXIT

	# 평평한 표를 중첩 테이블로 접는 여덟 줄이 hyprland.lua 가 아니라 생성물 안에
	# 같이 들어가는 이유: 기존 머신의 hyprland.lua 에 배선을 넣는 유일한 수단이
	# "그 줄이 있는지"만 보는 ensure 라서(../modules/shared/rice-seed-helpers.nix),
	# 배선이 한 줄로 끝나야 한다.
	{
		cat <<'EOF'
-- 생성물이다. apps/rice-decor 가 통째로 다시 쓰므로 손으로 고치면 다음 값
-- 변경에 날아간다. 사람이 고치는 하이프랜드 설정은 ./hyprland.lua 다.
--
-- 값이 평평한 건 rice-decor 가 셸이기 때문이다. 중첩 테이블을 골라 고치는 것보다
-- 한 줄 = 한 값이 훨씬 덜 깨진다. 접는 일은 아래가 한다.
--
-- 여기 없는 값은 하이프랜드 기본값이다 — 즉 남은 줄이 곧 손댄 것의 목록이다.

local v = {
EOF
		if [ -n "$body" ]; then
			printf '%s\n' "$body"
		fi
		cat <<'EOF'
}

local tree = {}
for path, value in pairs(v) do
    local parts = {}
    for p in path:gmatch("[^:]+") do
        parts[#parts + 1] = p
    end
    local node = tree
    for i = 1, #parts - 1 do
        node[parts[i]] = node[parts[i]] or {}
        node = node[parts[i]]
    end
    node[parts[#parts]] = value
end
hl.config(tree)
EOF
	} >"$tmp"

	cp "$tmp" "$file"
}

# ── 거는 것 ───────────────────────────────────────────────────────────────
apply() { # apply <키> <lua 값>
	[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 0
	command -v hyprctl >/dev/null 2>&1 || return 0

	# "decoration:blur:size" 6  →  {decoration = {blur = {size = 6}}}
	lua="$(printf '%s\n' "$1" | awk -F: -v v="$2" '{
		s = v
		for (i = NF; i >= 1; i--) s = "{" $i " = " s "}"
		print s
	}')"
	hyprctl eval "hl.config($lua)" >/dev/null
}

luaval() { # luaval <타입> <값> — 표 값을 lua 리터럴로
	if [ "$1" = bool ]; then
		awk -v v="$2" 'BEGIN { print (v + 0 ? "true" : "false") }'
	else
		printf '%s\n' "$2"
	fi
}

# 값 하나를 표가 정한 모양으로 다듬는다. 범위를 벗어나면 자른다 — 슬라이더는
# 넘길 일이 없지만 손으로 부를 때는 있고, 그때 하이프랜드가 조용히 이상하게
# 도는 것보다 여기서 자르는 편이 낫다.
shape() { # shape <줄> <값>
	printf '%s\n' "$1" | awk -F'\t' -v v="$2" '
		{
			min = $4 + 0; max = $5 + 0
			x = v + 0
			if (x < min) x = min
			if (x > max) x = max
			if ($3 == "float") {
				# GLSL 과 달리 lua 는 정수/실수를 안 가리지만, 표시가 값마다
				# 흔들리면 diff 가 지저분해진다. rice-knobs 와 같은 모양으로 자른다.
				s = sprintf("%.4f", x)
				sub(/0+$/, "", s)
				if (s ~ /\.$/) s = s "0"
				print s
			} else
				printf "%d\n", int(x + 0.5)
		}
	'
}

same() { # same <a> <b> — 실수로 견준다
	awk -v a="$1" -v b="$2" 'BEGIN { d = a - b; if (d < 0) d = -d; exit !(d < 1e-9) }'
}

# ── 명령 ──────────────────────────────────────────────────────────────────
case "${1:-}" in
"" | get)
	# 표와 파일을 겹쳐서 낸다. 파일에 있는 것은 그 값과 dirty, 없는 것은 기본값.
	cur="$(mktemp)"
	trap 'rm -f "$cur"' EXIT
	store >"$cur"

	spec | awk -F'\t' -v OFS='\t' -v cur="$cur" '
		BEGIN {
			while ((getline l < cur) > 0) {
				split(l, a, "\t")
				v[a[1]] = a[2]
			}
		}
		{ print $0, (($1 in v) ? v[$1] : $7), (($1 in v) ? 1 : 0) }
	' | jq -Rs --arg file "$file" '
		[ split("\n")[] | select(length > 0) | split("\t")
		  | { key:     .[0],
		      # 구역 이름이 이미 "흐리게"라고 말하고 있으므로 마지막 마디만 쓴다.
		      name:    (.[0] | split(":") | last),
		      group:   .[1],
		      type:    .[2],
		      min:     (.[3] | tonumber),
		      max:     (.[4] | tonumber),
		      step:    (.[5] | tonumber),
		      default: (.[6] | tonumber),
		      doc:     .[7],
		      value:   (.[8] | tonumber),
		      dirty:   (.[9] == "1") } ]
		# 구역은 표에 나온 순서를 지킨다. 투명도 → 흐리게 → 어둡게 → 그림자로
		# 배열한 데에 이유가 있어서(앞엣것을 만져야 뒤엣것이 보인다), 이름순으로
		# 섞으면 읽기 나빠진다.
		| { file: $file,
		    groups: (reduce .[] as $k ([];
		               if (length > 0 and (.[-1].label == $k.group))
		               then .[0:-1] + [ .[-1] + { knobs: (.[-1].knobs + [$k]) } ]
		               else . + [ { label: $k.group, knobs: [$k] } ] end)) }'
	;;

set)
	key="${2:?값 이름이 필요하다}"
	r="$(row "$key")"
	[ -n "$r" ] || { printf '그런 값은 없다: %s\n' "$key" >&2; exit 1; }
	val="$(shape "$r" "${3:?값이 필요하다}")"

	# 기본값으로 돌아왔으면 줄을 지운다. 파일에 남은 줄이 곧 손댄 것의 목록이라는
	# 성질이 여기서 유지된다.
	{
		store | awk -F'\t' -v k="$key" '$1 != k { print }'
		same "$val" "$(col "$r" 7)" || printf '%s\t%s\n' "$key" "$val"
	} | write

	apply "$key" "$(luaval "$(col "$r" 3)" "$val")"
	;;

reset)
	key="${2:-}"
	if [ -n "$key" ]; then
		r="$(row "$key")"
		[ -n "$r" ] || { printf '그런 값은 없다: %s\n' "$key" >&2; exit 1; }
		store | awk -F'\t' -v k="$key" '$1 != k { print }' | write
		apply "$key" "$(luaval "$(col "$r" 3)" "$(col "$r" 7)")"
	else
		# 지우기 전에 무엇이 걸려 있었는지 알아 둔다. 파일만 비우면 화면은 그대로
		# 남는다 — 조각을 안 읽는 게 아니라 이미 걸린 값을 되돌릴 사람이 없다.
		was="$(store | cut -f1)"
		printf '' | write
		for k in $was; do
			r="$(row "$k")"
			[ -n "$r" ] || continue
			apply "$k" "$(luaval "$(col "$r" 3)" "$(col "$r" 7)")"
		done
	fi
	;;

--file)
	printf '%s\n' "$file"
	;;

*)
	printf '알 수 없는 명령: %s\n' "$1" >&2
	exit 1
	;;
esac
